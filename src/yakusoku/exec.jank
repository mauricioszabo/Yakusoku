(ns yakusoku.exec
  "Executors and scheduling, following promesa.exec.

   An executor is a plain map carrying a ::kind, dispatched by an ordinary function --
   jank has no protocols, and none are needed for three kinds:

     :pool    a oneTBB task_arena, per-worker deques and random stealing
     :thread  one jank future -- one raw OS thread -- per task
     :inline  the calling thread

   The default executor is a :pool sized to the machine's core count, and `submit`, `run`
   and `exec` go to it unless told otherwise. That is the whole point of this namespace:
   `p/future` should cost a queue slot, not a thread.

   The pool owns its worker threads: work stealing needs a deque bound to each worker, so
   unlike the Asio io_context this replaced, they cannot be supplied from outside. Each
   registers itself with the garbage collector before running its first task.

   Two deliberate departures from promesa, both because jank cannot do otherwise:

   * Constructors take an options MAP, not keyword arguments: `(fixed-executor
     {:parallelism 4})` where promesa writes `(px/fixed-executor :parallelism 4)`. jank has
     no `& {:keys [...]}` destructuring.
   * A task does NOT inherit the submitting thread's dynamic bindings. promesa wraps every
     submitted task with `wrap-bindings`; jank exposes no `get-thread-bindings` /
     `push-thread-bindings` to build that on. Bind inside the task body, or close over the
     value before submitting."
  (:refer-clojure :exclude [pmap sleep])
  (:require [yakusoku.impl :as impl]))

(cpp/raw "#include <yakusoku.hpp>")

;; This namespace calls into the native core directly (hardware_threads), so it includes the
;; header itself rather than relying on yakusoku.impl having done it.
;;
;; Relying on that worked when everything was JIT-compiled into one process, where jank's
;; C++ environment is global. It does not survive ahead-of-time compilation: `jank
;; compile-module` builds each namespace on its own, so a consumer running `lein compile`
;; got "no type named 'hardware_threads' in namespace 'yakusoku'". Every namespace that
;; names a C++ symbol has to bring in its own declarations.

(defn executor?
  "True if x is a Yakusoku executor."
  [x]
  (and (map? x) (contains? x ::kind)))

(defn get-available-processors
  "The reported core count, or 4 when the platform will not say."
  []
  (let [n (cpp/yakusoku.hardware_threads)]
    (if (pos? n) n 4)))

;; --------------------------------------------------------------- constructors ----

(defn current-thread-executor
  "An executor that runs each task immediately, on the calling thread.

   This is what promesa calls :same-thread / :current-thread. It is NOT the default here,
   any more than it is there -- but it is what an un-suffixed `then` or `map` uses, since
   those run on whichever thread completed the promise."
  []
  {::kind :inline})

(defn cached-executor
  "An executor that runs each task on its own thread, via clojure.core/future.

   The nearest jank has to promesa's cached pool: jank's `future` spawns a raw std::thread
   per call with no pooling, so this costs one OS thread per task and never queues. Right
   for a handful of blocking operations -- `p/thread`, and waiting on a jank-native promise
   -- and wrong for anything with volume, which is what the default pool is for.

   Takes an options map for signature compatibility with promesa; nothing in it is read."
  ([] (cached-executor {}))
  ([_options] {::kind :thread}))

(defn fixed-executor
  "Creates a pool of :parallelism workers, defaulting to the machine's core count.

     (fixed-executor)
     (fixed-executor {:parallelism 4})

   Each worker owns a deque and steals from the others when its own runs dry, so a burst of
   tasks spreads without every worker contending on one queue. Shut it down when done --
   `shutdown` drains, `shutdown-now` stops waiting on timers -- though a pool left running
   will not hold the process open: the native core registers an atexit handler that stops
   every pool it made.

   The pool owns its threads, unlike the Asio io_context this replaced, where workers were
   jank futures running the event loop. Work stealing needs a deque bound to each worker, so
   the threads cannot come from outside; each one registers itself with the collector before
   it runs its first task."
  ([] (fixed-executor {}))
  ([options]
   (let [n (or (:parallelism options) (get-available-processors))]
     (impl/ensure-warm!)
     {::kind :pool
      ::pool (impl/make-pool n)
      ::shut (atom false)})))

(defn single-executor
  "A pool with exactly one worker, so its tasks run in submission order and never overlap."
  ([] (single-executor {}))
  ([options] (fixed-executor (assoc options :parallelism 1))))

(defn scheduled-executor
  "A pool used as a timer source.

   promesa keeps a separate scheduled executor; here every pool carries its own timer
   thread, so this is `fixed-executor` under promesa's name."
  ([] (scheduled-executor {}))
  ([options] (fixed-executor options)))

(defn forkjoin-executor
  "A pool, under promesa's name for its ForkJoinPool.

   Unlike most of the compatibility names here this one is honest: the pool underneath is a
   oneTBB task_arena, which is the same design as the ForkJoinPool promesa uses on the JVM
   -- per-worker deques, random victim stealing."
  ([] (forkjoin-executor {}))
  ([options] (fixed-executor options)))

(defn work-stealing-executor
  "Alias of forkjoin-executor."
  ([] (forkjoin-executor {}))
  ([options] (forkjoin-executor options)))

;; ------------------------------------------------------------------ shutdown ----

(defn shutdown
  "Drains a pool: workers finish queued work and pending timers, then stop. Blocks until
   every worker has exited. A no-op for the cached and current-thread executors."
  [executor]
  (when (= :pool (::kind executor))
    (reset! (::shut executor) true)
    (impl/drain! (::pool executor)))
  nil)

(defn shutdown-now
  "Stops a pool without waiting on its pending timers, then blocks until its workers are
   idle. Work already handed to the pool still runs: an enqueued oneTBB task cannot be
   recalled, so unlike Asio this does not drop the queue."
  [executor]
  (when (= :pool (::kind executor))
    (reset! (::shut executor) true)
    (impl/stop! (::pool executor)))
  nil)

(defn shutdown?
  "True once shutdown or shutdown-now has been called on this executor. Always false for
   the cached and current-thread executors, which own nothing to shut down."
  [executor]
  (if (= :pool (::kind executor))
    (deref (::shut executor))
    false))

;; ----------------------------------------------------------- default executor ----

(def ^:dynamic *default-executor*
  "The executor `submit`, `run` and `exec` use when given none. nil means the process-wide
   default pool; bind it with `with-executor`."
  nil)

;; Held in an atom rather than a delay. A namespace-level `(def x (delay ...))` does not
;; memoise across namespaces in jank -- every deref from another namespace re-runs the body
;; -- which for a pool would mean a fresh set of OS threads per call. yakusoku.impl's
;; ensure-warm! is guarded the same way, for the same reason.
(def ^:private default-executor-box (atom nil))

(defn default-executor
  "The process-wide pool, sized to the core count and created on first use, so that merely
   requiring Yakusoku never starts threads."
  []
  (or (deref default-executor-box)
      (let [candidate (fixed-executor)]
        (if (compare-and-set! default-executor-box nil candidate)
          candidate
          ;; Another thread got there first. Ours is surplus; stop its workers rather than
          ;; leaking a pool's worth of threads.
          (do (shutdown-now candidate)
              (deref default-executor-box))))))

(defn configure-default-executor
  "Replaces the process-wide default pool, shutting down the one it displaces.

     (configure-default-executor {:parallelism 16})

   Call it before anything has been submitted; work already queued on the old pool is
   drained, not moved."
  ([] (configure-default-executor {}))
  ([options]
   (let [previous (deref default-executor-box)
         next-executor (fixed-executor options)]
     (reset! default-executor-box next-executor)
     (when previous
       (shutdown previous))
     next-executor)))

(defn resolve-executor
  "Turns an executor, nil, or one of promesa's keywords into an executor.

     :default                 the process-wide pool
     :cached                  thread per task, unbounded
     :thread / :platform      thread per task, unbounded
     :vthread / :virtual      thread per task -- SEE BELOW
     :same-thread / :current-thread   the calling thread

   jank has no virtual threads, so :vthread and :virtual resolve to a real OS thread. That
   is a substitution, not an equivalence: code that fans out thousands of :vthread tasks
   expecting them to be cheap will spawn thousands of OS threads here. Say :default and use
   the pool."
  ([] (resolve-executor *default-executor*))
  ([executor]
   (cond
     (executor? executor) executor
     (nil? executor) (default-executor)
     (= :default executor) (default-executor)
     (= :cached executor) (cached-executor)
     (= :thread executor) (cached-executor)
     (= :platform executor) (cached-executor)
     (= :vthread executor) (cached-executor)
     (= :virtual executor) (cached-executor)
     (= :same-thread executor) (current-thread-executor)
     (= :current-thread executor) (current-thread-executor)
     :else (throw (ex-info "Invalid executor" {:executor executor})))))

;; ---------------------------------------------------------------- submission ----

(defn- dispatch!
  "Runs a zero-arity thunk on a resolved executor. Returns nil."
  [executor f]
  (cond
    (= :inline (::kind executor)) (do (f) nil)
    (= :thread (::kind executor)) (do (impl/ensure-warm!) (future (f)) nil)
    (= :pool (::kind executor)) (impl/post! (::pool executor) f)
    :else (throw (ex-info "Not an executor" {:executor executor}))))

(defn- settled
  "A promise already settled with v under the given status code."
  [status-code v]
  (let [p (impl/make-promise)]
    (impl/settle! p status-code v)
    p))

(defn exec
  "Runs a zero-arity function on an executor. Fire and forget: the returned promise says
   the task was accepted, not that it finished. Never throws -- a rejected promise carries
   anything raised while submitting."
  ([f] (exec (resolve-executor) f))
  ([executor f]
   (let [r (impl/attempt (dispatch! (resolve-executor executor) f))]
     (if (= :ok (nth r 0))
       (settled impl/resolved nil)
       (settled impl/rejected (nth r 1))))))

(defn submit
  "Runs a zero-arity function on an executor and returns a promise of its value.

   A value the function returns is delivered as-is; a promise it returns is NOT unwrapped,
   matching promesa since 9.0.462. Chain with `p/then` if you want flattening."
  ([f] (submit (resolve-executor) f))
  ([executor f]
   (let [out (impl/make-promise)
         task (fn []
                (let [r (impl/attempt (f))]
                  (if (= :ok (nth r 0))
                    (impl/settle! out impl/resolved (nth r 1))
                    (impl/settle! out impl/rejected (nth r 1)))))
         submitted (impl/attempt (dispatch! (resolve-executor executor) task))]
     (when (= :err (nth submitted 0))
       (impl/settle! out impl/rejected (nth submitted 1)))
     out)))

(defn run
  "Like submit, but discards the function's value: the promise resolves to nil once it has
   run."
  ([f] (run (resolve-executor) f))
  ([executor f]
   (submit executor (fn [] (f) nil))))

(defn schedule
  "Runs a zero-arity function after ms milliseconds and returns a promise of its value.

   Each pool carries a timer thread that sleeps until the earliest deadline, so there is no
   polling. Scheduled work is never cancelled at the timer; Yakusoku cancels at the promise
   instead, and the callback finds it already settled and does nothing."
  ([ms f] (schedule (resolve-executor) ms f))
  ([executor ms f]
   (let [ex (resolve-executor executor)
         ctx (if (= :pool (::kind ex))
               (::pool ex)
               (::pool (default-executor)))
         out (impl/make-promise)]
     (impl/schedule! ctx ms
                     (fn []
                       (let [r (impl/attempt (f))]
                         (if (= :ok (nth r 0))
                           (impl/settle! out impl/resolved (nth r 1))
                           (impl/settle! out impl/rejected (nth r 1))))))
     out)))

;; Scheduling needs a real event loop, so a scheduler is always a pool.
(defn resolve-scheduler
  "Like resolve-executor, but never yields something without an event loop: the cached and
   current-thread executors cannot hold a timer, so they resolve to the default pool."
  ([] (resolve-scheduler nil))
  ([scheduler]
   (let [ex (resolve-executor scheduler)]
     (if (= :pool (::kind ex))
       ex
       (default-executor)))))

;; --------------------------------------------------------------- conveniences ----

(defmacro with-executor
  "Binds *default-executor* to executor for the body.

   `^:shutdown` on the executor form drains it afterwards, `^:interrupt` stops it at once:

     (with-executor ^:shutdown (fixed-executor {:parallelism 2})
       (p/await! (p/future (heavy))))"
  [executor & body]
  (let [interrupt? (-> executor meta :interrupt)
        down? (-> executor meta :shutdown)
        sym (gensym "executor")]
    `(clojure.core/let [~sym ~executor
                        ~sym (if (fn? ~sym) (~sym) ~sym)]
       (binding [*default-executor* ~sym]
         (try
           ~@body
           (finally
             ~(when (or down? interrupt?)
                (if interrupt?
                  `(shutdown-now ~sym)
                  `(shutdown ~sym)))))))))

(defmacro with-dispatch
  "Runs body on the given executor, returning a promise of its value."
  [executor & body]
  `(submit ~executor (fn [] ~@body)))

(defn sleep
  "Blocks the calling thread for ms milliseconds. Never call this on a pool worker -- it
   holds the worker without doing work; `p/delay` is the non-blocking form."
  [ms]
  (cpp/clojure.core_native.sleep ms)
  nil)

(defn pmap
  "Maps f over coll on the default executor and returns a vector of the results, in order.

   Eager and blocking, unlike clojure.core/pmap and unlike promesa's, which is lazy: jank
   has no chunked-seq machinery to pace it with, and a lazy parallel map whose realisation
   is what submits the work is a trap. Blocks the calling thread until every element is
   done, so do not call it from a pool worker."
  [f coll]
  (let [promises (doall (map (fn [x] (submit (fn [] (f x)))) coll))]
    (mapv (fn [p]
            (impl/await! p)
            (if (= :rejected (impl/status p))
              (throw (impl/value p))
              (impl/value p)))
          promises)))

;; -------------------------------------------------------------------- timers ----
;;
;; Yakusoku extensions. promesa has no equivalent; these back the batching the parallel
;; Pathom runner needs, which upstream builds out of core.async.

(defn- context-of
  "The io_context behind an executor: its own if it is a pool, the default pool's
   otherwise. Timers need a real event loop."
  [executor]
  (let [ex (resolve-executor executor)]
    (if (= :pool (::kind ex))
      (::pool ex)
      (::pool (default-executor)))))

(defn timer
  "Creates a restartable timer on a pool.

   Restarting a timer that has a wait outstanding cancels that wait, which is all
   debouncing is. Timers are permanent -- see native/yakusoku.hpp -- so make one per
   long-lived thing that needs to debounce, not one per event."
  ([]
   (timer nil))
  ([executor]
   (impl/ensure-warm!)
   (impl/make-timer (context-of executor))))

(defn restart!
  "Arms a timer to run a zero-arity function after ms milliseconds, dropping whatever was
   pending."
  [t ms f]
  (impl/restart-timer! t ms f))

(defn cancel-timer!
  "Cancels a timer's pending wait. Its callback is dropped, not run."
  [t]
  (impl/cancel-timer! t))

(defn debouncer
  "Buffers items and hands them to f in arrival order, as a single vector.

   The buffer is flushed once it has been quiet for window-ms, or -- when a threshold is
   given -- as soon as it holds that many items. Returns a one-argument function; call it
   with an item to buffer that item. f always runs on a pool worker, never on the caller.

   This is the shape batching wants: producers push work items in as they discover them,
   and f sees each burst as one call."
  ([f window-ms]
   (debouncer nil f window-ms nil))
  ([f window-ms threshold]
   (debouncer nil f window-ms threshold))
  ([executor f window-ms threshold]
   (let [ex (let [candidate (resolve-executor executor)]
              (if (= :pool (::kind candidate)) candidate (default-executor)))
         t (timer ex)
         buffer (atom [])
         ;; One atomic take, so a flush and a concurrent push cannot lose an item between
         ;; them. A flush that finds nothing simply does nothing.
         take! (fn [] (first (swap-vals! buffer (fn [_] []))))
         flush! (fn []
                  (let [items (take!)]
                    (when (seq items)
                      (f items))))]
     (fn [item]
       (let [n (count (swap! buffer conj item))]
         (if (and threshold (>= n threshold))
           ;; Threshold flush. The items are taken here rather than by a zero-delay timer:
           ;; a producer faster than the pool would keep restarting that timer and starve
           ;; the flush it was meant to trigger. f still runs on a worker.
           (do
             (cancel-timer! t)
             (let [items (take!)]
               (when (seq items)
                 (exec ex (fn [] (f items))))))
           (restart! t window-ms flush!)))
       nil))))
