(ns pathim.path
  (:require
    [pathim.misc.coll :as coll]
    [pathim.attribute :as p.attr]
    [pathim.eql :as eql]))





(defn append-path
  [env path-entry]
  (update env ::path coll/vconj path-entry))

(defn root?
  "Check if current path is the root, meaning a blank path."
  [{::keys [path]}]
  (empty? path))

(defn at-path-string
  [{::keys [path]}]
  (if (seq path)
    (str " at path " (pr-str path))))
