(ns pathim.misc
  "Helpers that exist only because of jank, shared by every ported namespace.")

(defn raise!
  "Throws e. A function, not a macro, and that is the whole point.

   jank miscompiles a literal `(throw ...)` whose value is consumed by an enclosing form --
   as a function argument, inside a collection literal, or in a `case` branch -- while a
   throw raised inside a *called* function unwinds correctly, `ex-data` intact. Routing
   every throw in the port through this function makes the position irrelevant, so the
   ported code can keep upstream's shape.

   The same property is what `yakusoku.impl/attempt` relies on."
  [e]
  (throw e))

(def ^:private munge-char-map
  "Clojure's Compiler/CHAR_MAP, which jank does not expose. Reproduced so that names
   generated by the built-in resolvers match upstream's exactly."
  {\- "_"
   \: "_COLON_"
   \+ "_PLUS_"
   \> "_GT_"
   \< "_LT_"
   \= "_EQ_"
   \~ "_TILDE_"
   \! "_BANG_"
   \@ "_CIRCA_"
   \# "_SHARP_"
   \' "_SINGLEQUOTE_"
   \" "_DOUBLEQUOTE_"
   \% "_PERCENT_"
   \^ "_CARET_"
   \& "_AMPERSAND_"
   \* "_STAR_"
   \| "_BAR_"
   \{ "_LBRACE_"
   \} "_RBRACE_"
   \[ "_LBRACK_"
   \] "_RBRACK_"
   \/ "_SLASH_"
   \\ "_BSLASH_"
   \? "_QMARK_"})

(defn munge
  "Escapes a name into something usable as an identifier, as clojure.core/munge does.

   jank has no munge of its own; the built-in resolvers use it to derive resolver names
   from attribute keywords, and those names end up in the indexes, so matching upstream's
   output matters."
  [s]
  (apply str (map (fn [c] (get munge-char-map c c)) (str s))))
