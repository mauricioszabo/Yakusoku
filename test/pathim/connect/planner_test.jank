                                                                                             :children     [{:type         :prop,
                                                                                                             :dispatch-key :b,
                                                                                                             :key          :b}]}]}},
             :pathim.connect.planner/user-request-shape    {:a {:>/nest {:b {}}}},
             :pathim.connect.planner/index-resolver->nodes {dyn #{1}},
             :pathim.connect.planner/index-attrs           {:a #{1}},
             :pathim.connect.planner/root                  1})))

  (testing "nested extended process"
    (is (= (compute-run-graph
             {:pathim.connect.planner-test/dynamics  {'dyn [{:pathim.connect.operation/op-name 'a
                                  :pathim.connect.operation/output  [{:a [:b]}]}
                                 {:pathim.connect.operation/op-name 'c
                                  :pathim.connect.operation/input   [:b]
                                  :pathim.connect.operation/output  [:c]}]}
              :pathim.eql/query [{:a [:c]}]})
           {:pathim.connect.planner/nodes                 {2 {:pathim.connect.operation/op-name        'dyn
                                            :pathim.connect.planner/source-op-name 'a
                                            :pathim.connect.planner/node-id        2
                                            :pathim.connect.planner/expects        {:a {:c {}}}
                                            :pathim.connect.planner/input          {}
                                            :pathim.connect.planner/foreign-ast    (eql/query->ast [{:a [:c]}])}}
            :pathim.connect.planner/index-resolver->nodes '{dyn #{2}}
            :pathim.connect.planner/root                  2
            :pathim.connect.planner/index-attrs           {:a #{2}}
            :pathim.connect.planner/user-request-shape    {:a {:c {}}}
            :pathim.connect.planner/index-ast             {:a {:type         :join,
                                             :dispatch-key :a,
                                             :key          :a,
                                             :query        [:c],
                                             :children     [{:type         :prop,
                                                             :dispatch-key :c,
                                                             :key          :c}]}}}))


    (testing "keep intermediate dependency in case external resolvers need it"
      (is (= (compute-run-graph
               {:pathim.connect.indexes/index-resolvers {'dyn {:pathim.connect.operation/op-name           'dyn
                                             :pathim.connect.operation/cache?            false
                                             :pathim.connect.operation/dynamic-resolver? true
                                             :pathim.connect.operation/resolve           (fn [_ _])}
                                       'a   {:pathim.connect.operation/op-name      'a
                                             :pathim.connect.operation/dynamic-name 'dyn
                                             :pathim.connect.operation/output       [{:a [:b]}]
                                             :pathim.connect.operation/resolve      (fn [_ _])}
                                       'c   {:pathim.connect.operation/op-name      'c
                                             :pathim.connect.operation/dynamic-name 'dyn
                                             :pathim.connect.operation/input        [:b]
                                             :pathim.connect.operation/output       [:c]}
                                       'd   {:pathim.connect.operation/op-name 'd
                                             :pathim.connect.operation/input   [:b]
                                             :pathim.connect.operation/output  [:d]}}
                :pathim.connect.indexes/index-oir       {:a {{} #{'a}}
                                       :c {{:b {}} #{'c}}
                                       :d {{:b {}} #{'d}}}
                :pathim.eql/query           [{:a [:c :d]}]})
             '{:pathim.connect.planner/index-ast             {:a {:children     [{:dispatch-key :c
                                                                :key          :c
                                                                :type         :prop}
                                                               {:dispatch-key :d
                                                                :key          :d
                                                                :type         :prop}]
                                                :dispatch-key :a
                                                :key          :a
                                                :query        [:c
                                                               :d]
                                                :type         :join}}
               :pathim.connect.planner/index-attrs           {:a #{4}}
               :pathim.connect.planner/index-resolver->nodes {dyn #{4}}
               :pathim.connect.planner/user-request-shape    {:a {:c {} :d {}}}
               :pathim.connect.planner/nodes                 {4 {:pathim.connect.operation/op-name        dyn
                                               :pathim.connect.planner/source-op-name a
                                               :pathim.connect.planner/expects        {:a {:b {}
                                                                         :c {}}}
                                               :pathim.connect.planner/foreign-ast    {:children [{:children     [{:dispatch-key :c
                                                                                                 :key          :c
                                                                                                 :type         :prop}
                                                                                                {:dispatch-key :b
                                                                                                 :key          :b
                                                                                                 :type         :prop}]
                                                                                 :dispatch-key :a
                                                                                 :key          :a
                                                                                 :query        [:c
                                                                                                :b]
                                                                                 :type         :join}]
                                                                     :type     :root}
                                               :pathim.connect.planner/input          {}
                                               :pathim.connect.planner/node-id        4}}
               :pathim.connect.planner/root                  4})))

    (testing "forward nested inputs"
      (is (= (compute-run-graph
               {:pathim.connect.planner-test/dynamics  {'dyn [{:pathim.connect.operation/op-name
                                    'line-items

                                    :pathim.connect.operation/output
                                    [{:order/line-items
                                      [:line-item/id
                                       :line-item/quantity
                                       :line-item/title
                                       :line-item/price-total]}]}]}
                :pathim.connect.planner-test/resolvers [{:pathim.connect.operation/op-name 'total
