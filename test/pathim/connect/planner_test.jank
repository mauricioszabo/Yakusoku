  (is (= (pcp/find-root-resolver-nodes
           {:pathim.connect.planner/nodes {1 {:pathim.connect.operation/op-name 'res}}
            :pathim.connect.planner/root  1})
         #{1}))

  (is (= (pcp/find-root-resolver-nodes
           {:pathim.connect.planner/nodes {1 {:pathim.connect.operation/op-name 'res}
                         2 {:pathim.connect.planner/run-and #{1}}}
            :pathim.connect.planner/root  2})
         #{1}))

  (is (= (pcp/find-root-resolver-nodes
           {:pathim.connect.planner/nodes {1 {:pathim.connect.operation/op-name 'res}
                         2 {:pathim.connect.operation/op-name 'other}
                         3 {:pathim.connect.planner/run-and #{1 2}}}
            :pathim.connect.planner/root  3})
         #{1 2}))

  (is (= (pcp/find-root-resolver-nodes
           {:pathim.connect.planner/nodes {1 {:pathim.connect.operation/op-name 'res}
                         2 {:pathim.connect.planner/run-and #{4 5}}
                         3 {:pathim.connect.planner/run-and #{1 2}}
                         4 {:pathim.connect.operation/op-name 'other}
                         5 {:pathim.connect.operation/op-name 'other2}}
            :pathim.connect.planner/root  3})
         #{1 4 5})))

(deftest remove-node-expects-index-attrs-test
  (is (= (pcp/remove-node-expects-index-attrs
           {:pathim.connect.planner/nodes       {1 {:pathim.connect.planner/expects {:a {} :b {}}}}
            :pathim.connect.planner/index-attrs {:a #{1} :b #{1}}}
           1)
         {:pathim.connect.planner/nodes       {1 {:pathim.connect.planner/expects {:a {}
                                               :b {}}}}
          :pathim.connect.planner/index-attrs {}})))

(deftest remove-node-edges-test
  (is (= (pcp/remove-node-edges
           {:pathim.connect.planner/nodes {1 {:pathim.connect.planner/node-id 1
                            :pathim.connect.planner/run-and #{2}}
                         2 {:pathim.connect.planner/node-id      2
                            :pathim.connect.planner/node-parents #{1}}}}
           2)
         {:pathim.connect.planner/nodes {1 {:pathim.connect.planner/node-id 1
                          :pathim.connect.planner/run-and #{}}
                       2 {:pathim.connect.planner/node-id 2}}}))

  (is (= (pcp/remove-node-edges
           {:pathim.connect.planner/nodes {1 {:pathim.connect.planner/node-id 1
                            :pathim.connect.planner/run-and #{2}}
                         2 {:pathim.connect.planner/node-id      2
                            :pathim.connect.planner/node-parents #{1 3}}
                         3 {:pathim.connect.planner/node-id  3
                            :pathim.connect.planner/run-next 2}}}
           2)
         {:pathim.connect.planner/nodes {1 {:pathim.connect.planner/node-id 1
                          :pathim.connect.planner/run-and #{}}
                       2 {:pathim.connect.planner/node-id 2}
                       3 {:pathim.connect.planner/node-id 3}}}))

  (is (= (pcp/remove-node-edges
           {:pathim.connect.planner/nodes {1 {:pathim.connect.planner/node-id 1
                            :pathim.connect.planner/run-and #{2}}
                         2 {:pathim.connect.planner/node-id      2
                            :pathim.connect.planner/node-parents #{1 3}
                            :pathim.connect.planner/run-next     4}
                         3 {:pathim.connect.planner/node-id  3
                            :pathim.connect.planner/run-next 2}
                         4 {:pathim.connect.planner/node-id      4
                            :pathim.connect.planner/node-parents #{2}}}}
           2)
         {:pathim.connect.planner/nodes {1 {:pathim.connect.planner/node-id 1
                          :pathim.connect.planner/run-and #{}}
                       2 {:pathim.connect.planner/node-id 2}
                       3 {:pathim.connect.planner/node-id 3}
                       4 {:pathim.connect.planner/node-id 4}}})))

(deftest merge-placeholder-ast-test
  (testing "only add elements when there is a sub-query"
    (is (= (pcp/merge-placeholder-ast
             {}
             (eql/query->ast [:a]))
           {}))

    (is (= (pcp/merge-placeholder-ast
             {}
             (eql/query->ast [{:a [:b]}]))
           {:a (eql/query->ast1 [{:a [:b]}])})))

  (testing "add new attributes"
    (check (=>
             {:a (dissoc (eql/query->ast1 [{:a [:b :c]}]) :query)}
             (pcp/merge-placeholder-ast
               {:a (eql/query->ast1 [{:a [:b]}])}
               (eql/query->ast [{:a [:c]}]))))

    (testing "skip already present"
      (is (= (pcp/merge-placeholder-ast
               {:a (eql/query->ast1 [{:a [:b :c]}])}
               (eql/query->ast [{:a [:c]}]))
             {:a (eql/query->ast1 [{:a [:b :c]}])})))

    (testing "deep merge"
      (is (= (pcp/merge-placeholder-ast
               {:a (eql/query->ast1 [{:a [{:b [:c]}]}])}
               (eql/query->ast [{:a [{:b [:d]}]}]))
             {:a {:type :join,
                  :dispatch-key :a,
                  :key :a,
                  :query [{:b [:c]}],
                  :children [{:type :join,
                              :dispatch-key :b,
                              :key :b,
                              :query [:c],
                              :children [{:type :prop, :dispatch-key :c, :key :c}
                                         {:type :prop, :dispatch-key :d, :key :d}]}]}})))

    (testing "error on conflicting parameters"
      (is (thrown-with-msg? #"Incompatible placeholder request"
            (pcp/merge-placeholder-ast
              {:a (eql/query->ast1 [{:a [:b]}])}
              (eql/query->ast '[{:a [(:b {:p 1})]}])))))))

(deftest mark-fast-placeholder-processes-test
  (check (=> {:pathim.connect.planner/index-ast {:>/a {:pathim.connect.planner/placeholder-use-source-entity? m/absent}}}
             (compute-run-graph
               {:pathim.connect.planner-test/resolvers [{:pathim.connect.operation/op-name 'x
                              :pathim.connect.operation/output  [:x]}]
                :pathim.eql/query [{:>/a [:x]}]})))

  (check (=> {:pathim.connect.planner/index-ast {:>/a {:pathim.connect.planner/placeholder-use-source-entity? true}}}
             (compute-run-graph
               {:pathim.connect.planner-test/resolvers [{:pathim.connect.operation/op-name 'x
                              :pathim.connect.operation/output  [:x]}]
                :pathim.eql/query [{:>/a ['(:x {:foo 1})]}]}))))
