(deftest compute-run-graph-nested-inputs-cycles-test
  (testing "basic impossible nested input path"
    (check (=>
             {:ex/message
              (str
                "Pathom can't find a path for the following elements in the query at path [:parent]:\n"
                "- Attribute :child inputs can't be met, details:\n")}
             (compute-run-graph-ex
               {:pathim.connect.planner-test/resolvers [{:pathim.connect.operation/op-name 'parent
                              :pathim.connect.operation/output  [{:parent [:foo]}]}
                             {:pathim.connect.operation/op-name 'child
                              :pathim.connect.operation/input   [{:parent [:child]}]
                              :pathim.connect.operation/output  [:child]}]
                :pathim.eql/query [:child]}))))

  (testing "indirect cycle"
    (check
      (=>
        {:ex/message
         (str
           "Pathom can't find a path for the following elements in the query at path [:parent]:\n"
           "- Attribute :child-dep inputs can't be met, details:\n"
           "  - Can't reach attribute :child")}
        (compute-run-graph-ex
          {:pathim.connect.planner-test/resolvers [{:pathim.connect.operation/op-name 'parent
                         :pathim.connect.operation/output  [{:parent [:foo]}]}
                        {:pathim.connect.operation/op-name 'child
                         :pathim.connect.operation/input   [{:parent [:child-dep]}]
                         :pathim.connect.operation/output  [:child]}
                        {:pathim.connect.operation/op-name 'child-dep
                         :pathim.connect.operation/input   [:child]
                         :pathim.connect.operation/output  [:child-dep]}]
           :pathim.eql/query [:child]}))))

  (testing "deep cycle"
    (check
      (=>
        {:ex/message
         (str
           "Pathom can't find a path for the following elements in the query at path [:parent]:\n"
           "- Attribute :child inputs can't be met, details:\n")}
        (compute-run-graph-ex
          {:pathim.connect.planner-test/resolvers [{:pathim.connect.operation/op-name 'parent
                         :pathim.connect.operation/output  [{:parent [:foo]}]}
                        {:pathim.connect.operation/op-name 'child
                         :pathim.connect.operation/input   [{:parent [{:parent [:child]}]}]
                         :pathim.connect.operation/output  [:child]}]
           :pathim.eql/query [:child]})))))

(deftest compute-run-graph-optional-inputs-test
  (testing "plan continues when optional thing is missing"
    (is (= (compute-run-graph
             (-> {:pathim.eql/query             [:foo]
                  :pathim.connect.planner-test/resolvers             [{:pathim.connect.operation/op-name 'foo
                                            :pathim.connect.operation/input   [:x (pco/? :y)]
                                            :pathim.connect.operation/output  [:foo]}
