(deftest optimize-AND-branches-test
  (is (= (pcp/optimize-AND-branches
           '{:pathim.connect.planner/nodes {1 {:pathim.connect.operation/op-name dynamic-resolver, :pathim.connect.planner/expects {:a {}}, :pathim.connect.planner/input {}, :pathim.connect.planner/node-id 1, :pathim.connect.planner/foreign-ast {:type :root, :children [{:type :prop, :dispatch-key :a, :key :a}]}, :pathim.connect.planner/node-parents #{3}}, 2 {:pathim.connect.operation/op-name dynamic-resolver, :pathim.connect.planner/expects {:b {}}, :pathim.connect.planner/input {}, :pathim.connect.planner/node-id 2, :pathim.connect.planner/foreign-ast {:type :root, :children [{:type :prop, :dispatch-key :b, :key :b}]}, :pathim.connect.planner/node-parents #{3}}, 3 {:pathim.connect.planner/node-id 3, :pathim.connect.planner/run-and #{1 2}}}, :pathim.connect.planner/index-ast {:a {:type :prop, :dispatch-key :a, :key :a}, :b {:type :prop, :dispatch-key :b, :key :b}}, :pathim.connect.planner/index-resolver->nodes {dynamic-resolver #{1 2}}, :pathim.connect.planner/index-attrs {:a #{1}, :b #{2}}, :pathim.connect.planner/root 3}
           {:pathim.connect.planner/snapshots* snaps*}
