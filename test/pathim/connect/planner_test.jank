(deftest compute-run-graph-dynamic-nested-queries-test
  (testing "user query request directly available nested data"
    (is (= (compute-run-graph
             {:pathim.connect.indexes/index-resolvers {'dyn {:pathim.connect.operation/op-name           'dyn
                                           :pathim.connect.operation/cache?            false
                                           :pathim.connect.operation/dynamic-resolver? true
