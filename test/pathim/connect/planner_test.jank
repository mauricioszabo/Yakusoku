(deftest compute-run-graph-dynamic-mutations-test
  (testing "mutation query going over"
    (testing "attribute directly in mutation output"
      (is (= (compute-run-graph
               {:pathim.connect.planner-test/dynamics  {'dyn [(pco/mutation 'doit {:pathim.connect.operation/output [:done]} (fn [_ _]))]}
                :pathim.eql/query [{(list 'doit {}) [:done]}]})
             '{:pathim.connect.planner/index-ast          {}
               :pathim.connect.planner/mutations          [{:children                                        [{:dispatch-key :done
                                                                                                                            :key          :done
                                                                                                                            :type         :prop}]
                                                                         :pathim.connect.planner/foreign-ast {:children [{:dispatch-key :done
                                                                                                                                       :key          :done
                                                                                                                                       :type         :prop}]
                                                                                                                           :type     :root}
                                                                         :dispatch-key                                    doit
                                                                         :key                                             doit
                                                                         :params                                          {}
                                                                         :query                                           [:done]
                                                                         :type                                            :call}]
               :pathim.connect.planner/nodes              {}
               :pathim.connect.planner/user-request-shape {doit {:done {}}}})))

    (testing "attribute extended from mutation, but still in the same foreign"
      (is (= (compute-run-graph
               {:pathim.connect.planner-test/dynamics  {'dyn [(pco/mutation 'doit {:pathim.connect.operation/output [:done]} (fn [_ _]))
                                   (pbir/alias-resolver :done :done?)]}
                :pathim.eql/query [{(list 'doit {}) [:done?]}]})
             '{:pathim.connect.planner/index-ast          {}
               :pathim.connect.planner/mutations          [{:children                                        [{:dispatch-key :done?
                                                                                                                            :key          :done?
                                                                                                                            :type         :prop}]
                                                                         :pathim.connect.planner/foreign-ast {:children [{:dispatch-key :done?
                                                                                                                                       :key          :done?
                                                                                                                                       :type         :prop}]
                                                                                                                           :type     :root}
                                                                         :dispatch-key                                    doit
                                                                         :key                                             doit
                                                                         :params                                          {}
                                                                         :query                                           [:done?]
                                                                         :type                                            :call}]
               :pathim.connect.planner/nodes              {}
               :pathim.connect.planner/user-request-shape {doit {:done? {}}}})))

    (testing "attribute extended from mutation locally"
      (is (= (compute-run-graph
               {:pathim.connect.planner-test/dynamics  {'dyn [(pco/mutation 'doit {:pathim.connect.operation/output [:done]} (fn [_ _]))]}
                :pathim.connect.planner-test/resolvers [(pbir/alias-resolver :done :done?)]
                :pathim.eql/query [{(list 'doit {}) [:done?]}]})
             '{:pathim.connect.planner/index-ast          {}
               :pathim.connect.planner/mutations          [{:children                                        [{:dispatch-key :done?
                                                                                                                            :key          :done?
                                                                                                                            :type         :prop}]
                                                                         :pathim.connect.planner/foreign-ast {:children [{:dispatch-key :done
                                                                                                                                       :key          :done
                                                                                                                                       :type         :prop}]
                                                                                                                           :type     :root}
                                                                         :dispatch-key                                    doit
                                                                         :key                                             doit
                                                                         :params                                          {}
                                                                         :query                                           [:done?]
                                                                         :type                                            :call}]
               :pathim.connect.planner/nodes              {}
               :pathim.connect.planner/user-request-shape {doit {:done? {}}}})))))

(deftest compute-run-graph-idents-test
  (testing "separate idents"
    (is (= (compute-run-graph
             {:pathim.connect.planner-test/resolvers [{:pathim.connect.operation/op-name 'a
                            :pathim.connect.operation/output  [:a]}]
              :pathim.eql/query [:a [:foo "bar"]]})
           '{:pathim.connect.planner/nodes                 {1 {:pathim.connect.operation/op-name a
                                             :pathim.connect.planner/node-id 1
                                             :pathim.connect.planner/expects {:a {}}
                                             :pathim.connect.planner/input   {}}}
             :pathim.connect.planner/index-resolver->nodes {a #{1}}
             :pathim.connect.planner/root                  1
             :pathim.connect.planner/user-request-shape    {:a      {}
                                          [:foo
                                           "bar"] {}}
             :pathim.connect.planner/idents                #{[:foo "bar"]}
             :pathim.connect.planner/index-attrs           {:a #{1}}
             :pathim.connect.planner/index-ast             {:a           {:dispatch-key :a
                                                        :key          :a
                                                        :type         :prop}
                                          [:foo "bar"] {:dispatch-key :foo
                                                        :key          [:foo
                                                                       "bar"]
                                                        :type         :prop}}}))

    (is (= (compute-run-graph
             {:pathim.connect.planner-test/resolvers [{:pathim.connect.operation/op-name 'a
                            :pathim.connect.operation/output  [:a]}]
              :pathim.eql/query [:a {[:foo "bar"] [:baz]}]})
           '{:pathim.connect.planner/nodes                 {1 {:pathim.connect.operation/op-name a
                                             :pathim.connect.planner/node-id 1
                                             :pathim.connect.planner/expects {:a {}}
                                             :pathim.connect.planner/input   {}}}
             :pathim.connect.planner/index-resolver->nodes {a #{1}}
             :pathim.connect.planner/user-request-shape    {:a      {}
                                          [:foo
                                           "bar"] {:baz {}}}
             :pathim.connect.planner/root                  1
             :pathim.connect.planner/idents                #{[:foo "bar"]}
             :pathim.connect.planner/index-attrs           {:a #{1}}
             :pathim.connect.planner/index-ast             {:a           {:dispatch-key :a
                                                        :key          :a
                                                        :type         :prop}
                                          [:foo "bar"] {:children     [{:dispatch-key :baz
                                                                        :key          :baz
                                                                        :type         :prop}]
                                                        :dispatch-key :foo
                                                        :key          [:foo
                                                                       "bar"]
                                                        :query        [:baz]
                                                        :type         :join}}}))))

(deftest compute-run-graph-cycles-test
  (testing "cycles"
    (is (= (compute-run-graph
             {:pathim.connect.planner-test/resolvers             [{:pathim.connect.operation/op-name 'a
                                        :pathim.connect.operation/input   [:b]
                                        :pathim.connect.operation/output  [:a]}
                                       {:pathim.connect.operation/op-name 'b
                                        :pathim.connect.operation/input   [:a]
                                        :pathim.connect.operation/output  [:b]}]
              :pathim.eql/query             [:a]
              :pathim.error/lenient-mode? true})
           '{:pathim.connect.planner/index-ast            {:a {:dispatch-key :a
                                             :key          :a
                                             :type         :prop}}
             :pathim.connect.planner/nodes                {}
             :pathim.connect.planner/user-request-shape   {:a {}}
             :pathim.connect.planner/unreachable-paths    {:a {}
                                         :b {}}
             :pathim.connect.planner/verification-failed? true}))

    (is (= (compute-run-graph
             {:pathim.connect.planner-test/resolvers             [{:pathim.connect.operation/op-name 'a
                                        :pathim.connect.operation/input   [:c]
                                        :pathim.connect.operation/output  [:a]}
                                       {:pathim.connect.operation/op-name 'b
                                        :pathim.connect.operation/input   [:a]
                                        :pathim.connect.operation/output  [:b]}
                                       {:pathim.connect.operation/op-name 'c
                                        :pathim.connect.operation/input   [:b]
                                        :pathim.connect.operation/output  [:c]}]
              :pathim.eql/query             [:a]
              :pathim.error/lenient-mode? true})
           '{:pathim.connect.planner/index-ast            {:a {:dispatch-key :a
                                             :key          :a
                                             :type         :prop}}
             :pathim.connect.planner/user-request-shape   {:a {}}
             :pathim.connect.planner/nodes                {}
             :pathim.connect.planner/unreachable-paths    {:a {}
                                         :b {}
                                         :c {}}
             :pathim.connect.planner/verification-failed? true}))

    (testing "partial cycle"
      (is (= (compute-run-graph
               {:pathim.connect.indexes/index-oir '{:a {{:c {}} #{a}
                                      {}      #{a1}}
                                  :b {{:a {}} #{b}}
                                  :c {{:b {}} #{c}}
                                  :d {{} #{d}}}
                :pathim.eql/query     [:c :a]})
             '{:pathim.connect.planner/index-ast {:a {:dispatch-key :a, :key :a, :type :prop}, :c {:dispatch-key :c, :key :c, :type :prop}}, :pathim.connect.planner/index-attrs {:a #{4}, :b #{2}, :c #{1}}, :pathim.connect.planner/index-resolver->nodes {a1 #{4}, b #{2}, c #{1}}, :pathim.connect.planner/user-request-shape {:c {}, :a {}}, :pathim.connect.planner/nodes {1 {:pathim.connect.operation/op-name c, :pathim.connect.planner/expects {:c {}}, :pathim.connect.planner/input {:b {}}, :pathim.connect.planner/node-id 1, :pathim.connect.planner/node-parents #{2}}, 2 {:pathim.connect.operation/op-name b, :pathim.connect.planner/expects {:b {}}, :pathim.connect.planner/input {:a {}}, :pathim.connect.planner/node-id 2, :pathim.connect.planner/node-parents #{4}, :pathim.connect.planner/run-next 1}, 4 {:pathim.connect.operation/op-name a1, :pathim.connect.planner/expects {:a {}}, :pathim.connect.planner/input {}, :pathim.connect.planner/node-id 4, :pathim.connect.planner/run-next 2}}, :pathim.connect.planner/root 4})))

    (testing "nested cycles"
      (check (=> {:ex/message
                  (str
                    "Pathom can't find a path for the following elements in the query at path [:a]:\n"
                    "- Attribute :b inputs can't be met, details:\n")}
                 (compute-run-graph-ex
                   {:pathim.connect.planner-test/resolvers [{:pathim.connect.operation/op-name 'cycle-a
                                  :pathim.connect.operation/output  [:a]}
                                 {:pathim.connect.operation/op-name 'cycle-b
                                  :pathim.connect.operation/input   [{:a [:b]}]
                                  :pathim.connect.operation/output  [:b]}]
                    :pathim.eql/query [:b]})))

      (check (=> {:ex/message
                  (str
                    "Pathom can't find a path for the following elements in the query at path [:a]:\n"
                    "- Attribute :c inputs can't be met, details:\n"
                    "  - Can't reach attribute :b")}
                 (compute-run-graph-ex
                   {:pathim.connect.planner-test/resolvers [{:pathim.connect.operation/op-name 'cycle-a
                                  :pathim.connect.operation/output  [:a]}
                                 {:pathim.connect.operation/op-name 'cycle-b
                                  :pathim.connect.operation/input   [{:a [:c]}]
                                  :pathim.connect.operation/output  [:b]}
                                 {:pathim.connect.operation/op-name 'cycle-c
                                  :pathim.connect.operation/input   [:b]
                                  :pathim.connect.operation/output  [:c]}]
                    :pathim.eql/query [:b]}))))))

(deftest compute-run-graph-nested-inputs-test
  (testing "discard non available paths on nesting"
    (is (= (compute-run-graph
             (-> {:pathim.eql/query             [:scores-sum]
                  :pathim.connect.planner-test/resolvers             '[{:pathim.connect.operation/op-name scores-sum
                                             :pathim.connect.operation/input   [{:users [:user/score]}]
                                             :pathim.connect.operation/output  [:scores-sum]}
                                            {:pathim.connect.operation/op-name users
                                             :pathim.connect.operation/output  [{:users [:user/id]}]}]
                  :pathim.error/lenient-mode? true}))
           '{:pathim.connect.planner/index-ast            {:scores-sum {:dispatch-key :scores-sum
                                                      :key          :scores-sum
                                                      :type         :prop}}
             :pathim.connect.planner/nodes                {}
             :pathim.connect.planner/user-request-shape   {:scores-sum {}}
             :pathim.connect.planner/unreachable-paths    {:scores-sum {}
                                         :users      {:user/score {}}}
             :pathim.connect.planner/verification-failed? true})))

  (testing "allow possible path"
    (is (= (compute-run-graph
             (-> {:pathim.eql/query             [:scores-sum]
                  :pathim.connect.planner-test/resolvers             '[{:pathim.connect.operation/op-name scores-sum
                                             :pathim.connect.operation/input   [{:users [:user/score]}]
                                             :pathim.connect.operation/output  [:scores-sum]}
                                            {:pathim.connect.operation/op-name users
                                             :pathim.connect.operation/output  [{:users [:user/id]}]}
                                            {:pathim.connect.operation/op-name user
                                             :pathim.connect.operation/input   [:user/id]
                                             :pathim.connect.operation/output  [:user/score]}]
                  :pathim.error/lenient-mode? true}))
           '{:pathim.connect.planner/index-ast             {:scores-sum {:dispatch-key :scores-sum
                                                       :key          :scores-sum
                                                       :type         :prop}
                                          :users      {:children     [{:dispatch-key :user/score
                                                                       :key          :user/score
                                                                       :type         :prop}]
                                                       :dispatch-key :users
                                                       :key          :users
                                                       :type         :join}}
             :pathim.connect.planner/index-attrs           {:scores-sum #{1}
                                          :users      #{3}}
             :pathim.connect.planner/user-request-shape    {:scores-sum {}}
             :pathim.connect.planner/index-resolver->nodes {scores-sum #{1}
                                          users      #{3}}
             :pathim.connect.planner/nodes                 {1 {:pathim.connect.operation/op-name      scores-sum
                                             :pathim.connect.planner/expects      {:scores-sum {}}
                                             :pathim.connect.planner/input        {:users {:user/score {}}}
                                             :pathim.connect.planner/node-id      1
                                             :pathim.connect.planner/node-parents #{3}}
                                          3 {:pathim.connect.operation/op-name  users
                                             :pathim.connect.planner/expects  {:users {:user/id {}}}
                                             :pathim.connect.planner/input    {}
                                             :pathim.connect.planner/node-id  3
                                             :pathim.connect.planner/run-next 1}}
             :pathim.connect.planner/root                  3})))

  (testing "remove bad paths regarding nested inputs"
    (is (= (compute-run-graph
             {:pathim.eql/query             [:z]
              :pathim.connect.planner-test/resolvers             '[{:pathim.connect.operation/op-name a1
                                         :pathim.connect.operation/output  [{:a [:c]}]}
                                        {:pathim.connect.operation/op-name a2
                                         :pathim.connect.operation/output  [:a]}
                                        {:pathim.connect.operation/op-name a3
                                         :pathim.connect.operation/output  [{:a [:b]}]}
                                        {:pathim.connect.operation/op-name z
                                         :pathim.connect.operation/input   [{:a [:b]}]
                                         :pathim.connect.operation/output  [:z]}]
              :pathim.error/lenient-mode? true})
           '{:pathim.connect.planner/index-ast             {:a {:children     [{:dispatch-key :b
                                                                                             :key          :b
                                                                                             :type         :prop}]
                                                                             :dispatch-key :a
                                                                             :key          :a
                                                                             :type         :join}
                                                                         :z {:dispatch-key :z
                                                                             :key          :z
                                                                             :type         :prop}}
             :pathim.connect.planner/index-attrs           {:a #{4}
                                                                         :z #{1}}
             :pathim.connect.planner/index-resolver->nodes {a3 #{4}
                                                                         z  #{1}}
             :pathim.connect.planner/user-request-shape                                   {:z {}}
             :pathim.connect.planner/nodes                 {1 {:pathim.connect.operation/op-name    z
                                                                            :pathim.connect.planner/expects      {:z {}}
                                                                            :pathim.connect.planner/input        {:a {:b {}}}
                                                                            :pathim.connect.planner/node-id      1
                                                                            :pathim.connect.planner/node-parents #{4}}
                                                                         4 {:pathim.connect.operation/op-name a3
                                                                            :pathim.connect.planner/expects   {:a {:b {}}}
                                                                            :pathim.connect.planner/input     {}
                                                                            :pathim.connect.planner/node-id   4
                                                                            :pathim.connect.planner/run-next  1}}
             :pathim.connect.planner/root                  4})))

  (testing "data partially available, require join lookup"
    (is (= (compute-run-graph
             (-> {:pathim.eql/query             [:scores-sum]
                  :pathim.connect.planner/available-data    {:users {:user/id {}}}
                  :pathim.connect.planner-test/resolvers             '[{:pathim.connect.operation/op-name scores-sum
                                             :pathim.connect.operation/input   [{:users [:user/score]}]
                                             :pathim.connect.operation/output  [:scores-sum]}
                                            {:pathim.connect.operation/op-name users
                                             :pathim.connect.operation/output  [{:users [:user/id]}]}
                                            {:pathim.connect.operation/op-name user
                                             :pathim.connect.operation/input   [:user/id]
                                             :pathim.connect.operation/output  [:user/score]}]
                  :pathim.error/lenient-mode? true}))
           '{:pathim.connect.planner/nodes {1 {:pathim.connect.operation/op-name scores-sum, :pathim.connect.planner/node-id 1, :pathim.connect.planner/expects {:scores-sum {}}, :pathim.connect.planner/input {:users {:user/score {}}}}}, :pathim.connect.planner/index-resolver->nodes {scores-sum #{1}}, :pathim.connect.planner/nested-process #{:users}, :pathim.connect.planner/index-attrs {:scores-sum #{1}}, :pathim.connect.planner/root 1, :pathim.connect.planner/user-request-shape {:scores-sum {}}, :pathim.connect.planner/index-ast {:scores-sum {:type :prop, :dispatch-key :scores-sum, :key :scores-sum}, :users {:type :join, :key :users, :dispatch-key :users, :children [{:type :prop, :key :user/score, :dispatch-key :user/score}]}}})))

  (testing "data partially available, require nested and resolver call"
    (is (= (compute-run-graph
             (-> {:pathim.eql/query             [:scores-sum]
                  :pathim.connect.planner/available-data    {:users {:user/id {}}}
                  :pathim.connect.planner-test/resolvers             '[{:pathim.connect.operation/op-name scores-sum
                                             :pathim.connect.operation/input   [{:users [:user/score]} :other]
                                             :pathim.connect.operation/output  [:scores-sum]}
                                            {:pathim.connect.operation/op-name users
                                             :pathim.connect.operation/output  [{:users [:user/id]}]}
                                            {:pathim.connect.operation/op-name other
                                             :pathim.connect.operation/output  [:other]}
                                            {:pathim.connect.operation/op-name user
                                             :pathim.connect.operation/input   [:user/id]
