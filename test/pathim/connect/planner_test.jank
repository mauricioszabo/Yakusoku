(deftest can-merge-sibling-resolver-nodes?-test
  (is (pcp/can-merge-sibling-resolver-nodes?
        {:pathim.connect.planner/nodes {1 {:pathim.connect.planner/node-id          1
                         :pathim.connect.operation/op-name          'ab
                         :pathim.connect.planner/input            {}
                         :pathim.connect.planner/expects          {:a {}}
                         :pathim.connect.planner/source-for-attrs #{:a}}
                      2 {:pathim.connect.planner/node-id          2
                         :pathim.connect.operation/op-name          'ab
                         :pathim.connect.planner/input            {}
                         :pathim.connect.planner/expects          {:b {}}
                         :pathim.connect.planner/source-for-attrs #{:b}}}}
        1 2))

  (is (not (pcp/can-merge-sibling-resolver-nodes?
             {:pathim.connect.planner/nodes {1 {:pathim.connect.planner/node-id          1
                              :pathim.connect.operation/op-name          'ab
                              :pathim.connect.planner/input            {}
                              :pathim.connect.planner/expects          {:a {}}
                              :pathim.connect.planner/source-for-attrs #{:a}}
                           2 {:pathim.connect.planner/node-id          2
                              :pathim.connect.operation/op-name          'ac
                              :pathim.connect.planner/input            {}
                              :pathim.connect.planner/expects          {:b {}}
                              :pathim.connect.planner/source-for-attrs #{:b}}}}
             1 2)))

  (is (not (pcp/can-merge-sibling-resolver-nodes?
             {:pathim.connect.planner/nodes {1 {:pathim.connect.planner/node-id          1
                              :pathim.connect.operation/op-name          'ab
                              :pathim.connect.planner/input            {}
                              :pathim.connect.planner/expects          {:a {}}
                              :pathim.connect.planner/source-for-attrs #{:a}}
                           2 {:pathim.connect.planner/node-id 2
                              :pathim.connect.planner/run-and #{3 4}}}}
             1 2))))

