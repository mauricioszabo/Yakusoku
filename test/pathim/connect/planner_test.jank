(deftest transfer-node-parents-test
  (is (= (pcp/transfer-node-parents
           '{:pathim.connect.planner/nodes {1 {:pathim.connect.operation/op-name dynamic-resolver, :pathim.connect.planner/expects {:a {}, :b {}}, :pathim.connect.planner/input {}, :pathim.connect.planner/node-id 1, :pathim.connect.planner/foreign-ast {:type :root, :children [{:type :prop, :dispatch-key :a, :key :a} {:type :prop, :dispatch-key :b, :key :b}]}, :pathim.connect.planner/node-parents #{3}}, 3 {:pathim.connect.planner/node-id 3, :pathim.connect.planner/run-and #{1}}}, :pathim.connect.planner/index-ast {:a {:type :prop, :dispatch-key :a, :key :a}, :b {:type :prop, :dispatch-key :b, :key :b}}, :pathim.connect.planner/index-resolver->nodes {dynamic-resolver #{1}}, :pathim.connect.planner/index-attrs {:a #{1}, :b #{1}}, :pathim.connect.planner/root 3}
           1 3)
         '{:pathim.connect.planner/nodes {1 {:pathim.connect.operation/op-name dynamic-resolver, :pathim.connect.planner/expects {:a {}, :b {}}, :pathim.connect.planner/input {}, :pathim.connect.planner/node-id 1, :pathim.connect.planner/foreign-ast {:type :root, :children [{:type :prop, :dispatch-key :a, :key :a} {:type :prop, :dispatch-key :b, :key :b}]}, :pathim.connect.planner/node-parents #{3}}, 3 {:pathim.connect.planner/node-id 3, :pathim.connect.planner/run-and #{1}}}, :pathim.connect.planner/index-ast {:a {:type :prop, :dispatch-key :a, :key :a}, :b {:type :prop, :dispatch-key :b, :key :b}}, :pathim.connect.planner/index-resolver->nodes {dynamic-resolver #{1}}, :pathim.connect.planner/index-attrs {:a #{1}, :b #{1}}, :pathim.connect.planner/root 1}))

  (is (= (pcp/transfer-node-parents
           '{:pathim.connect.planner/nodes {1 {:pathim.connect.planner/node-parents #{2}}, 2 {:pathim.connect.planner/run-next 1}, 3 {:pathim.connect.planner/node-parents #{4 5}}, 4 {:pathim.connect.planner/run-next 3}, 5 {:pathim.connect.planner/run-and #{3}}}, :pathim.connect.planner/root 3}
           1 3)
         '{:pathim.connect.planner/nodes {1 {:pathim.connect.planner/node-parents #{4 2 5}}, 2 {:pathim.connect.planner/run-next 1}, 3 {}, 4 {:pathim.connect.planner/run-next 1}, 5 {:pathim.connect.planner/run-and #{1}}}, :pathim.connect.planner/root 1})))

(deftest denormalize-node-test
  (check
    (pcp/denormalize-node (compute-run-graph
                            {:pathim.connect.planner-test/resolvers [(pbir/constantly-resolver :a 1)]
                             :pathim.eql/query [:a]})
                          1)
    => '{:pathim.connect.planner/nodes-denormalized
         {1 {:pathim.connect.operation/op-name -unqualified/a--const,
             :pathim.connect.planner/expects   {:a {}},
             :pathim.connect.planner/input     {},}}})

  (check
    (pcp/denormalize-node (compute-run-graph
                            {:pathim.connect.planner-test/resolvers [(pbir/constantly-resolver :a 1)
                                          (pbir/alias-resolver :a :b)]
                             :pathim.eql/query [:b]})
                          2)
    => '{:pathim.connect.planner/nodes-denormalized
         {1 {:pathim.connect.operation/op-name -unqualified/a->b--alias,
             :pathim.connect.planner/expects   {:b {}},
             :pathim.connect.planner/input     {:a {}},},
          2 {:pathim.connect.operation/op-name -unqualified/a--const,
             :pathim.connect.planner/expects   {:a {}},
             :pathim.connect.planner/input     {},
             :pathim.connect.planner/run-next  {:pathim.connect.operation/op-name -unqualified/a->b--alias,
                                                             :pathim.connect.planner/expects   {:b {}},
                                                             :pathim.connect.planner/input     {:a {}},}}}})

  (check
    (pcp/denormalize-node (compute-run-graph
                            {:pathim.connect.planner-test/resolvers [(pbir/constantly-resolver :a 1)
                                          (pbir/constantly-resolver :b 2)]
                             :pathim.eql/query [:a :b]})
                          3)
    => '{:pathim.connect.planner/nodes-denormalized
         {1 {:pathim.connect.operation/op-name -unqualified/a--const,
             :pathim.connect.planner/expects   {:a {}},
             :pathim.connect.planner/input     {}},
          2 {:pathim.connect.operation/op-name -unqualified/b--const,
             :pathim.connect.planner/expects   {:b {}},
             :pathim.connect.planner/input     {}},
          3 {:pathim.connect.planner/run-and #{{:pathim.connect.operation/op-name -unqualified/a--const,
                                                             :pathim.connect.planner/expects   {:a {}},
                                                             :pathim.connect.planner/input     {}}
                                                            {:pathim.connect.operation/op-name -unqualified/b--const,
                                                             :pathim.connect.planner/expects   {:b {}},
                                                             :pathim.connect.planner/input     {}}}}}})

  (check
    (pcp/denormalize-node (compute-run-graph
                            {:pathim.connect.planner-test/resolvers [(pbir/constantly-resolver :a 1)
                                          (pco/update-config (pbir/constantly-resolver :a 2)
                                                             assoc :pathim.connect.operation/op-name 'a2)]
                             :pathim.eql/query [:a]})
                          3)
    => '{:pathim.connect.planner/nodes-denormalized
                 {1 {:pathim.connect.operation/op-name a2,
                     :pathim.connect.planner/expects   {:a {}},
                     :pathim.connect.planner/input     {}},
                  2 {:pathim.connect.operation/op-name -unqualified/a--const,
                     :pathim.connect.planner/expects   {:a {}},
                     :pathim.connect.planner/input     {}},
                  3 {:pathim.connect.planner/expects {:a {}},
                     :pathim.connect.planner/run-or
                     #{{:pathim.connect.operation/op-name
                        -unqualified/a--const,
                        :pathim.connect.planner/expects {:a {}},
                        :pathim.connect.planner/input   {}}
                       {:pathim.connect.operation/op-name a2,
                        :pathim.connect.planner/expects   {:a {}},
                        :pathim.connect.planner/input     {}}}}}})

  (testing "denorm update node"
    (check
      (pcp/denormalize-node
        (-> (compute-run-graph
              {:pathim.connect.planner-test/resolvers [(pbir/constantly-resolver :a 1)
                            (pbir/alias-resolver :a :b)]
               :pathim.eql/query [:b]})
            (assoc :pathim.connect.planner/denorm-update-node
              #(assoc % :foo "bar")))
        2)
      => '{:pathim.connect.planner/nodes-denormalized
           {1 {:pathim.connect.operation/op-name -unqualified/a->b--alias,
               :pathim.connect.planner/expects   {:b {}}
               :pathim.connect.planner/input     {:a {}},
               :foo                                           "bar",},
            2 {:pathim.connect.operation/op-name -unqualified/a--const,
               :pathim.connect.planner/expects   {:a {}}
               :pathim.connect.planner/input     {},
               :pathim.connect.planner/run-next  {:pathim.connect.operation/op-name -unqualified/a->b--alias,
                                                               :pathim.connect.planner/expects   {:b {}},
                                                               :pathim.connect.planner/input     {:a {}},},
               :foo                                           "bar"}}})))

