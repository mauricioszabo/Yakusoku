(ns pathim.connect.planner-test
  (:require
    [pathim.misc :refer [raise!]]
    [pathim.test.check :refer [check]]
    [clojure.test :refer [deftest is testing]]
    [pathim.misc.coll :as coll]
    [pathim.connect.built-in.resolvers :as pbir]
    [pathim.connect.foreign :as pcf]
    [pathim.connect.indexes :as pci]
    [pathim.connect.operation :as pco]
    [pathim.connect.planner :as pcp]
    [pathim.error :as p.error]
    [pathim.interface.eql :as p.eql]
    [pathim.eql :as eql]
    [pathim.test.matchers :as m]))

(defn register-index [ops]
  (let [ops' (into []
                   (map (fn [x]
                          (if (and (coll/native-map? x) (contains? x :pathim.connect.operation/output))
                            (pco/resolver (assoc x :pathim.connect.operation/resolve (fn [_ _])))
                            x)))
                   ops)]
    (pci/register {} ops')))

(defn oir-index [resolvers]
  (:pathim.connect.indexes/index-oir (register-index resolvers)))

(defn base-graph-env []
  (pcp/base-env))

(defn compute-run-graph* [{:pathim.connect.planner-test/keys [out env]}]
  (pcp/compute-run-graph
    out
    env))

(defn exception-capture [f]
  (try
    (f)
    (raise! (ex-info "Expected error wasn't thrown" {}))
    (catch cpp/jank.runtime.object_ref e
      {:ex/message (ex-message e)
       :ex/data    (ex-data e)})))

(defn compute-env
  [{:pathim.connect.planner-test/keys     [resolvers dynamics]
    :pathim.connect.planner/keys [snapshots*]
    :pathim.eql/keys [query]
    :as        options}]
  (cond-> (merge (base-graph-env)
                 (-> options
                     (dissoc :pathim.eql/query)
                     (assoc :edn-query-language.ast/node
                       (eql/query->ast query))
                     (cond->
                       (:pathim.connect.indexes/index-resolvers options)
                       (update :pathim.connect.indexes/index-resolvers
                         #(coll/map-vals pco/resolver %)))))
    resolvers
    (pci/merge-indexes (register-index resolvers))

    snapshots*
    (assoc :pathim.connect.planner/snapshots* snapshots*)

    dynamics
    (as-> <>
      (reduce
        (fn [env' [name resolvers]]
          (pci/register env' (-> resolvers
                                 register-index
                                 (assoc :pathim.connect.indexes/index-source-id name)
                                 p.eql/boundary-interface
                                 pcf/foreign-register)))
        <>
        dynamics))))

(defn compute-run-graph
  [{:pathim.connect.planner-test/keys     [time?]
    :pathim.connect.planner/keys [snapshots*]
    :or        {time? false}
    :as        options}]
  (let [env     (compute-env options)
        options (assoc options :pathim.connect.planner-test/env env)
        graph   (cond->
                  (if time?
                    (time (compute-run-graph* options))
                    (compute-run-graph* options))

                  true
                  (-> (vary-meta assoc :pathim.connect.planner-test/env env)
                      (dissoc :pathim.connect.planner/source-ast :pathim.connect.planner/available-data)))]
    (if snapshots*
      @snapshots*
      graph)))

(defn compute-run-graph-ex [config]
  (exception-capture #(compute-run-graph config)))

(defn debug-compute-run-graph
     "Use this to run plan graph and also log the steps to Pathom Viz"
     [options]
     (let [env   (compute-env options)
           snaps (pcp/compute-plan-snapshots env)]

       ((requiring-resolve 'com.wsscode.pathom.viz.ws-connector.pathom3/log-entry)
        {:pathom.viz.log/type :pathom.viz.log.type/plan-snapshots
         :pathom.viz.log/data snaps})
       (-> (peek snaps)
           (dissoc :pathim.connect.planner/snapshot-message)
           (vary-meta assoc :pathim.connect.planner-test/env env)
           (dissoc :pathim.connect.planner/source-ast :pathim.connect.planner/available-data))))

(deftest compute-run-graph-test
  (testing "simplest path"
    (is (= (compute-run-graph
             {:pathim.connect.planner-test/resolvers [{:pathim.connect.operation/op-name 'a
                            :pathim.connect.operation/output  [:a]}]
              :pathim.eql/query [:a]})
           '{:pathim.connect.planner/nodes                 {1 {:pathim.connect.operation/op-name a
                                             :pathim.connect.planner/node-id 1
                                             :pathim.connect.planner/expects {:a {}}
                                             :pathim.connect.planner/input   {}}}
             :pathim.connect.planner/index-resolver->nodes {a #{1}}
             :pathim.connect.planner/root                  1
             :pathim.connect.planner/index-attrs           {:a #{1}}
             :pathim.connect.planner/index-ast             {:a {:dispatch-key :a
                                              :key          :a
                                              :type         :prop}}
             :pathim.connect.planner/user-request-shape    {:a {}}})))

  (testing "OR on multiple paths"
    (is (= (compute-run-graph
             {:pathim.connect.planner-test/resolvers [{:pathim.connect.operation/op-name 'a
                            :pathim.connect.operation/output  [:a]}
                           {:pathim.connect.operation/op-name 'a2
                            :pathim.connect.operation/output  [:a]}]
              :pathim.eql/query [:a]})
           '{:pathim.connect.planner/nodes                 {2 {:pathim.connect.operation/op-name      a2,
                                             :pathim.connect.planner/expects      {:a {}},
                                             :pathim.connect.planner/input        {},
                                             :pathim.connect.planner/node-id      2,
                                             :pathim.connect.planner/node-parents #{3}},
                                          1 {:pathim.connect.operation/op-name      a,
                                             :pathim.connect.planner/expects      {:a {}},
                                             :pathim.connect.planner/input        {},
                                             :pathim.connect.planner/node-id      1,
                                             :pathim.connect.planner/node-parents #{3}},
                                          3 {:pathim.connect.planner/expects {:a {}},
                                             :pathim.connect.planner/node-id 3,
                                             :pathim.connect.planner/run-or  #{1
                                                             2}}},
             :pathim.connect.planner/index-ast             {:a {:type         :prop,
                                              :dispatch-key :a,
                                              :key          :a}},
             :pathim.connect.planner/index-resolver->nodes {a2 #{2}, a #{1}},
             :pathim.connect.planner/index-attrs           {:a #{1 2}},
             :pathim.connect.planner/user-request-shape    {:a {}}
             :pathim.connect.planner/root                  3})))

  (testing "partial failure with OR"
    (is (= (compute-run-graph
             {:pathim.connect.indexes/index-oir      '{:bar/id     {{:foo/id {}}   #{bar-id}
                                                  {:bar/year {}} #{get-bar-id-from-year}}
                                     :foo/number {{:foo/id {}} #{bar-id}}
                                     :bar/year   {{:bar/id {}} #{get-year}}}
              :pathim.eql/query          [:foo/number :bar/id :bar/year]
              :pathim.connect.planner/available-data {:foo/id {}}})
           '{:pathim.connect.planner/nodes                 {1 {:pathim.connect.operation/op-name  bar-id,
                                             :pathim.connect.planner/expects  {:foo/number {},
                                                             :bar/id     {}},
                                             :pathim.connect.planner/input    {:foo/id {}},
                                             :pathim.connect.planner/node-id  1,
                                             :pathim.connect.planner/run-next 5},
                                          5 {:pathim.connect.operation/op-name      get-year,
                                             :pathim.connect.planner/expects      {:bar/year {}},
                                             :pathim.connect.planner/input        {:bar/id {}},
                                             :pathim.connect.planner/node-id      5,
                                             :pathim.connect.planner/node-parents #{1}}},
             :pathim.connect.planner/index-ast             {:foo/number {:type         :prop,
                                                       :dispatch-key :foo/number,
                                                       :key          :foo/number},
                                          :bar/id     {:type         :prop,
                                                       :dispatch-key :bar/id,
                                                       :key          :bar/id},
                                          :bar/year   {:type         :prop,
                                                       :dispatch-key :bar/year,
                                                       :key          :bar/year}},
             :pathim.connect.planner/user-request-shape    {:bar/id     {}
                                          :bar/year   {}
                                          :foo/number {}}
             :pathim.connect.planner/index-resolver->nodes {bar-id #{1}, get-year #{5}},
             :pathim.connect.planner/index-attrs           {:foo/number #{1},
                                          :bar/id     #{1},
                                          :bar/year   #{5}},
             :pathim.connect.planner/root                  1})))

  (testing "AND on multiple attributes"
    (is (= (compute-run-graph
             {:pathim.connect.planner-test/resolvers [{:pathim.connect.operation/op-name 'a
                            :pathim.connect.operation/output  [:a]}
                           {:pathim.connect.operation/op-name 'b
                            :pathim.connect.operation/output  [:b]}]
              :pathim.eql/query [:a :b]})
           '{:pathim.connect.planner/nodes                 {1 {:pathim.connect.operation/op-name      a
                                             :pathim.connect.planner/node-id      1
                                             :pathim.connect.planner/expects      {:a {}}
                                             :pathim.connect.planner/input        {}
                                             :pathim.connect.planner/node-parents #{3}}
                                          2 {:pathim.connect.operation/op-name      b
                                             :pathim.connect.planner/node-id      2
                                             :pathim.connect.planner/expects      {:b {}}
                                             :pathim.connect.planner/input        {}
                                             :pathim.connect.planner/node-parents #{3}}
                                          3 {:pathim.connect.planner/node-id 3
                                             :pathim.connect.planner/expects {:a {} :b {}}
                                             :pathim.connect.planner/run-and #{2 1}}}
             :pathim.connect.planner/index-resolver->nodes {a #{1} b #{2}}
             :pathim.connect.planner/index-attrs           {:b #{2}, :a #{1}}
             :pathim.connect.planner/index-ast             {:a {:type         :prop,
                                              :dispatch-key :a,
                                              :key          :a},
                                          :b {:type         :prop,
                                              :dispatch-key :b,
                                              :key          :b}}
             :pathim.connect.planner/user-request-shape    {:a {} :b {}}
             :pathim.connect.planner/root                  3})))

  (testing "expectation for nested needs"
    (testing "exposed required sub query"
      (check (=> {:pathim.connect.planner/nodes {1 {:pathim.connect.planner/expects {:a {:b {}}}}}}
                 (compute-run-graph
                   {:pathim.connect.planner-test/resolvers [{:pathim.connect.operation/op-name 'a
                                  :pathim.connect.operation/output  [{:a [:b :c]}]}]
                    :pathim.eql/query [{:a [:b]}]}))))

    (testing "filters only parts included on the resolver provides"
      (check (=> {:pathim.connect.planner/nodes {2 {:pathim.connect.planner/expects {:a {:b {}}}}}}
                 (compute-run-graph
                   {:pathim.connect.planner-test/resolvers [{:pathim.connect.operation/op-name 'a
                                  :pathim.connect.operation/output  [{:a [:b :c]}]}
                                 {:pathim.connect.operation/op-name 'd
                                  :pathim.connect.operation/output  [:d]}]
                    :pathim.eql/query [{:a [:b :d]}]}))))

    (testing "add expects on implicit dependency"
      (check (=> {:pathim.connect.planner/nodes {2 {:pathim.connect.planner/expects {:a {:b {}}}}}}
                 (compute-run-graph
                   {:pathim.connect.planner-test/resolvers [{:pathim.connect.operation/op-name 'a
                                  :pathim.connect.operation/output  [{:a [:b :c]}]}
                                 {:pathim.connect.operation/op-name 'd
                                  :pathim.connect.operation/input   [:b]
                                  :pathim.connect.operation/output  [:d]}]
                    :pathim.eql/query [{:a [:d]}]}))))))

(deftest compute-run-graph-no-path-test
  (testing "no path"
    (check (=> {:ex/message
                (str
                  "Pathom can't find a path for the following elements in the query:\n"
                  "- Attribute :a is unknown, there is not any resolver that outputs it.")

                :ex/data
                {:pathim.connect.planner/unreachable-paths   {:a {}}
                 :pathim.connect.planner/unreachable-details {:a {:pathim.connect.planner/unreachable-cause :pathim.connect.planner/unreachable-cause-unknown-attribute}}
                 :pathim.error/phase           :pathim.connect.planner/plan
                 :pathim.error/cause           :pathim.error/attribute-unreachable}}
               (compute-run-graph-ex
                 {:pathim.connect.planner-test/resolvers []
                  :pathim.eql/query [:a]})))

    (check (=> {:ex/message
                (str
                  "Pathom can't find a path for the following elements in the query:\n"
                  "- Attribute :a is unknown, there is not any resolver that outputs it.\n"
                  "- Attribute :b is unknown, there is not any resolver that outputs it.")

                :ex/data
                {:pathim.connect.planner/unreachable-paths   {:a {} :b {}}
                 :pathim.connect.planner/unreachable-details {:a {:pathim.connect.planner/unreachable-cause :pathim.connect.planner/unreachable-cause-unknown-attribute}
                                            :b {:pathim.connect.planner/unreachable-cause :pathim.connect.planner/unreachable-cause-unknown-attribute}}
                 :pathim.error/phase           :pathim.connect.planner/plan
                 :pathim.error/cause           :pathim.error/attribute-unreachable}}
               (compute-run-graph-ex
                 {:pathim.connect.planner-test/resolvers []
                  :pathim.eql/query [:a :b]})))

    (testing "broken chain"
      (check (=> {:ex/message
                  (str
                    "Pathom can't find a path for the following elements in the query:\n"
                    "- Attribute :b inputs can't be met, details:\n"
                    "  - Can't reach attribute :a")

                  :ex/data
                  {:pathim.connect.planner/unreachable-paths   {:b {}}
                   :pathim.connect.planner/unreachable-details {:b {:pathim.connect.planner/unreachable-cause :pathim.connect.planner/unreachable-cause-missing-inputs
                                                  :pathim.connect.planner/unreachable-missing-inputs {{:a {}} #{'b}}}}
                   :pathim.error/phase           :pathim.connect.planner/plan
                   :pathim.error/cause           :pathim.error/attribute-unreachable}}
                 (compute-run-graph-ex
                   {:pathim.connect.planner-test/resolvers [{:pathim.connect.operation/op-name 'b
                                  :pathim.connect.operation/input   [:a]
                                  :pathim.connect.operation/output  [:b]}]
                    :pathim.eql/query [:b]})))

      (testing "partial failure"
        (check (=> {:ex/message
                    (str
                      "Pathom can't find a path for the following elements in the query:\n"
                      "- Attribute :b inputs can't be met, details:\n"
                      "  - Can't reach attribute :a")

                    :ex/data
                    '{:pathim.connect.planner/unreachable-paths {:b {}}
                      :pathim.connect.planner/unreachable-details
                      {:b
                       {:pathim.connect.planner/unreachable-cause
                        :pathim.connect.planner/unreachable-cause-missing-inputs
                        :pathim.connect.planner/unreachable-missing-inputs
                        {{:a {}} #{b}}}}}}
                   (compute-run-graph-ex
                     {:pathim.connect.planner-test/resolvers [{:pathim.connect.operation/op-name 'b
                                    :pathim.connect.operation/input   [:a :c]
                                    :pathim.connect.operation/output  [:b]}
                                   {:pathim.connect.operation/op-name 'c
                                    :pathim.connect.operation/output  [:c]}]
                      :pathim.eql/query [:b]})))

        (check (=> {:ex/message
                    (str
                      "Pathom can't find a path for the following elements in the query:\n"
                      "- Attribute :b inputs can't be met, details:\n"
                      "  - Can't reach attribute :a")

                    :ex/data
                    '{:pathim.connect.planner/unreachable-paths {:b {}}
                      :pathim.connect.planner/unreachable-details
                      {:b
                       {:pathim.connect.planner/unreachable-cause
                        :pathim.connect.planner/unreachable-cause-missing-inputs
                        :pathim.connect.planner/unreachable-missing-inputs
                        {{:a {}} #{b}}}}}}
                   (compute-run-graph-ex
                     {:pathim.connect.planner-test/resolvers [{:pathim.connect.operation/op-name 'b
                                    :pathim.connect.operation/input   [:a :c]
                                    :pathim.connect.operation/output  [:b]}]
                      :pathim.connect.planner/available-data {:c {}}
                      :pathim.eql/query [:b]}))))

      (testing "with multiple paths using same input"
        (check (=> {:ex/message
                    (str
                      "Pathom can't find a path for the following elements in the query:\n"
                      "- Attribute :b inputs can't be met, details:\n"
                      "  - Can't reach attribute :a")

                    :ex/data
                    '{:pathim.connect.planner/unreachable-paths {:b {}}
                      :pathim.connect.planner/unreachable-details
                      {:b
                       {:pathim.connect.planner/unreachable-cause
                        :pathim.connect.planner/unreachable-cause-missing-inputs
                        :pathim.connect.planner/unreachable-missing-inputs
                        {{:a {}} #{b b1}}}}}}
                   (compute-run-graph-ex
                     {:pathim.connect.planner-test/resolvers [{:pathim.connect.operation/op-name 'b
                                    :pathim.connect.operation/input   [:a]
                                    :pathim.connect.operation/output  [:b]}
                                   {:pathim.connect.operation/op-name 'b1
                                    :pathim.connect.operation/input   [:a]
                                    :pathim.connect.operation/output  [:b]}]
                      :pathim.eql/query [:b]}))))

      (testing "missing with indirect chain"
        (check (=> {:ex/message
                    (str
                      "Pathom can't find a path for the following elements in the query:\n"
                      "- Attribute :c inputs can't be met, details:\n"
                      "  - Can't reach attribute :b")

                    :ex/data
                    '{:pathim.connect.planner/unreachable-paths {:c {}},
                      :pathim.connect.planner/unreachable-details
                      {:c
                       {:pathim.connect.planner/unreachable-cause
                        :pathim.connect.planner/unreachable-cause-missing-inputs
                        :pathim.connect.planner/unreachable-missing-inputs
                        {{:b {}} #{c}}}}}}
                   (compute-run-graph-ex
                     {:pathim.connect.planner-test/resolvers [{:pathim.connect.operation/op-name 'b
                                    :pathim.connect.operation/input   [:a]
                                    :pathim.connect.operation/output  [:b]}
                                   {:pathim.connect.operation/op-name 'c
                                    :pathim.connect.operation/input   [:b]
                                    :pathim.connect.operation/output  [:c]}]
                      :pathim.eql/query [:c]})))

        (check (=> {:ex/message
                    (str
                      "Pathom can't find a path for the following elements in the query:\n"
                      "- Attribute :d inputs can't be met, details:\n"
                      "  - Can't reach attribute :c")}
                   (compute-run-graph-ex
                     {:pathim.connect.planner-test/resolvers [{:pathim.connect.operation/op-name 'b
                                    :pathim.connect.operation/input   [:a]
                                    :pathim.connect.operation/output  [:b]}
                                   {:pathim.connect.operation/op-name 'c
                                    :pathim.connect.operation/input   [:b]
                                    :pathim.connect.operation/output  [:c]}
                                   {:pathim.connect.operation/op-name 'd
                                    :pathim.connect.operation/input   [:c]
                                    :pathim.connect.operation/output  [:d]}]
                      :pathim.eql/query [:d]}))))

      (testing "multiple missing with inputs of different complexity"
        (check (=> {:ex/message
                    (str
                      "Pathom can't find a path for the following elements in the query:\n"
                      "- Attribute :c inputs can't be met, details:\n"
                      "  - Can't reach attribute :b\n"
                      "  - Can't reach attribute :d")}
                   (compute-run-graph-ex
                     {:pathim.connect.planner-test/resolvers [{:pathim.connect.operation/op-name 'b
                                    :pathim.connect.operation/input   [:a]
                                    :pathim.connect.operation/output  [:b]}
                                   {:pathim.connect.operation/op-name 'c
                                    :pathim.connect.operation/input   [:b :d]
                                    :pathim.connect.operation/output  [:c]}]
                      :pathim.eql/query [:c]}))))

      (testing "multiple attributes missing that can come from same parent missing input"
        (check (=> {:ex/message
                    (str
                      "Pathom can't find a path for the following elements in the query:\n"
                      "- Attribute :d inputs can't be met, details:\n"
                      "  - Can't reach attribute :b\n"
                      "  - Can't reach attribute :c")}
                   (compute-run-graph-ex
                     {:pathim.connect.planner-test/resolvers [{:pathim.connect.operation/op-name 'a->bc
                                    :pathim.connect.operation/input   [:a]
                                    :pathim.connect.operation/output  [:b :c]}
                                   {:pathim.connect.operation/op-name 'd
                                    :pathim.connect.operation/input   [:b :c]
                                    :pathim.connect.operation/output  [:d]}]
                      :pathim.eql/query [:d]}))))

      (testing "multiple input paths to reach missing attribute"
        (check (=> {:ex/message
                    (str
                      "Pathom can't find a path for the following elements in the query:\n"
                      "- Attribute :c inputs can't be met, details:\n"
                      "  - Can't reach attribute :a\n"
                      "  OR\n"
                      "  - Can't reach attribute :b")}
                   (compute-run-graph-ex
                     {:pathim.connect.planner-test/resolvers [{:pathim.connect.operation/op-name 'a->c
                                    :pathim.connect.operation/input   [:a]
                                    :pathim.connect.operation/output  [:c]}
                                   {:pathim.connect.operation/op-name 'b->c
                                    :pathim.connect.operation/input   [:b]
                                    :pathim.connect.operation/output  [:c]}]
                      :pathim.eql/query [:c]})))))

    (testing "currently available data"
      (is (= (compute-run-graph
               {:pathim.connect.indexes/index-oir      '{}
                :pathim.eql/query          [:a]
                :pathim.connect.planner/available-data {:a {}}})
             {:pathim.connect.planner/nodes              {}
              :pathim.connect.planner/user-request-shape {:a {}}
              :pathim.connect.planner/index-ast          {:a {:dispatch-key :a
                                            :key          :a
                                            :type         :prop}}}))

      (testing "optional"
        (is (= (compute-run-graph
                 {:pathim.connect.planner-test/resolvers [{:pathim.connect.operation/op-name 'a
                                :pathim.connect.operation/output  [:a]}]
                  :pathim.eql/query [:a (pco/? :b)]})
               '{:pathim.connect.planner/nodes                 {1 {:pathim.connect.operation/op-name a,
                                                 :pathim.connect.planner/expects {:a {}},
                                                 :pathim.connect.planner/input   {},
                                                 :pathim.connect.planner/node-id 1}},
                 :pathim.connect.planner/index-ast             {:a {:type         :prop,
                                                  :dispatch-key :a,
                                                  :key          :a},
                                              :b {:type         :prop,
                                                  :dispatch-key :b,
                                                  :key          :b,
                                                  :params       {:pathim.connect.operation/optional? true}}},
                 :pathim.connect.planner/index-resolver->nodes {a #{1}},
                 :pathim.connect.planner/index-attrs           {:a #{1}},
                 :pathim.connect.planner/user-request-shape    {:a {} :b {}}
                 :pathim.connect.planner/root                  1,
                 :pathim.connect.planner/unreachable-paths     {:b {}}})))

      (testing "exposed nested needs"
        (is (= (compute-run-graph
                 {:pathim.connect.indexes/index-oir      '{}
                  :pathim.eql/query          [{:a [:bar]}]
                  :pathim.connect.planner/available-data {:a {}}})
               {:pathim.connect.planner/nodes              {}
                :pathim.connect.planner/user-request-shape {:a {:bar {}}}
                :pathim.connect.planner/nested-process     #{:a}
                :pathim.connect.planner/index-ast          {:a {:children     [{:dispatch-key :bar
                                                              :key          :bar
                                                              :type         :prop}]
                                              :dispatch-key :a
                                              :key          :a
                                              :query        [:bar]
                                              :type         :join}}}))

        (is (= (compute-run-graph
                 {:pathim.connect.indexes/index-oir      '{}
                  :pathim.eql/query          [:a {:b '...}]
                  :pathim.connect.planner/available-data {:a {} :b {}}})
               {:pathim.connect.planner/nodes              {}
                :pathim.connect.planner/user-request-shape {:a {} :b {}}
                :pathim.connect.planner/nested-process     #{:b}
                :pathim.connect.planner/index-ast          {:a {:type         :prop,
                                              :dispatch-key :a,
                                              :key          :a},
                                          :b {:type         :join,
                                              :dispatch-key :b,
                                              :key          :b,
                                              :query        '...}}}))))))

(deftest compute-run-graph-no-path-tolerant-mode-test
  (testing "no path"
    (is (= (compute-run-graph
             {:pathim.connect.indexes/index-oir         '{}
              :pathim.eql/query             [:a]
              :pathim.error/lenient-mode? true})
           {:pathim.connect.planner/index-ast            {:a {:dispatch-key :a
                                            :key          :a
                                            :type         :prop}}
            :pathim.connect.planner/nodes                {}
            :pathim.connect.planner/user-request-shape   {:a {}}
            :pathim.connect.planner/unreachable-paths    {:a {}}
            :pathim.connect.planner/verification-failed? true}))

    (testing "broken chain"
      (is (= (compute-run-graph
               {:pathim.connect.indexes/index-oir         '{:b {{:a {}} #{b}}}
                :pathim.eql/query             [:b]
                :pathim.error/lenient-mode? true})
             '{:pathim.connect.planner/index-ast            {:b {:dispatch-key :b
                                               :key          :b
                                               :type         :prop}}
               :pathim.connect.planner/user-request-shape   {:b {}}
               :pathim.connect.planner/nodes                {}
               :pathim.connect.planner/unreachable-paths    {:a {}
                                           :b {}}
               :pathim.connect.planner/verification-failed? true}))

      (is (= (compute-run-graph
               {:pathim.connect.indexes/index-oir         '{:b {{:a {}} #{b1 b}}}
                :pathim.eql/query             [:b]
                :pathim.error/lenient-mode? true})
             '{:pathim.connect.planner/index-ast            {:b {:dispatch-key :b
                                               :key          :b
                                               :type         :prop}}
               :pathim.connect.planner/user-request-shape   {:b {}}
               :pathim.connect.planner/nodes                {}
               :pathim.connect.planner/unreachable-paths    {:a {}
                                           :b {}}
               :pathim.connect.planner/verification-failed? true}))

      (is (= (compute-run-graph
               {:pathim.connect.planner-test/resolvers             [{:pathim.connect.operation/op-name 'a
                                          :pathim.connect.operation/output  [:a]}
                                         {:pathim.connect.operation/op-name 'b
                                          :pathim.connect.operation/input   [:a]
                                          :pathim.connect.operation/output  [:b]}]
                :pathim.eql/query             [:b]
                :pathim.connect.planner-test/out                   {:pathim.connect.planner/unreachable-paths {:a {}}}
                :pathim.error/lenient-mode? true})
             '{:pathim.connect.planner/index-ast            {:b {:dispatch-key :b
                                               :key          :b
                                               :type         :prop}}
               :pathim.connect.planner/nodes                {}
               :pathim.connect.planner/user-request-shape   {:b {}}
               :pathim.connect.planner/unreachable-paths    {:a {}
                                           :b {}}
               :pathim.connect.planner/verification-failed? true}))

      (is (= (compute-run-graph
               {:pathim.connect.planner-test/resolvers             [{:pathim.connect.operation/op-name 'b
                                          :pathim.connect.operation/input   [:a]
                                          :pathim.connect.operation/output  [:b]}
                                         {:pathim.connect.operation/op-name 'c
                                          :pathim.connect.operation/input   [:b]
                                          :pathim.connect.operation/output  [:c]}]
                :pathim.eql/query             [:c]
                :pathim.error/lenient-mode? true})
             '{:pathim.connect.planner/index-ast            {:c {:dispatch-key :c
                                               :key          :c
                                               :type         :prop}}
               :pathim.connect.planner/user-request-shape   {:c {}}
               :pathim.connect.planner/nodes                {}
               :pathim.connect.planner/unreachable-paths    {:a {}
                                           :b {}
                                           :c {}}
               :pathim.connect.planner/verification-failed? true}))

      (is (= (compute-run-graph
               {:pathim.connect.planner-test/resolvers             [{:pathim.connect.operation/op-name 'b
                                          :pathim.connect.operation/input   [:a]
                                          :pathim.connect.operation/output  [:b]}
                                         {:pathim.connect.operation/op-name 'd
                                          :pathim.connect.operation/output  [:d]}
                                         {:pathim.connect.operation/op-name 'c
                                          :pathim.connect.operation/input   [:b :d]
                                          :pathim.connect.operation/output  [:c]}]
                :pathim.eql/query             [:c]
                :pathim.error/lenient-mode? true})
             '{:pathim.connect.planner/index-ast            {:c {:dispatch-key :c
                                               :key          :c
                                               :type         :prop}}
               :pathim.connect.planner/user-request-shape   {:c {}}
               :pathim.connect.planner/nodes                {}
               :pathim.connect.planner/unreachable-paths    {:a {}
                                           :b {}
                                           :c {}}
               :pathim.connect.planner/verification-failed? true})))))

