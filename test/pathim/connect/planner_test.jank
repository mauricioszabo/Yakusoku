         '{:pathim.connect.planner/nodes {1 {:pathim.connect.operation/op-name dynamic-resolver, :pathim.connect.planner/expects {:a {}, :b {}}, :pathim.connect.planner/input {}, :pathim.connect.planner/node-id 1, :pathim.connect.planner/foreign-ast {:type :root, :children [{:type :prop, :dispatch-key :a, :key :a} {:type :prop, :dispatch-key :b, :key :b}]}}}, :pathim.connect.planner/index-ast {:a {:type :prop, :dispatch-key :a, :key :a}, :b {:type :prop, :dispatch-key :b, :key :b}}, :pathim.connect.planner/index-resolver->nodes {dynamic-resolver #{1}}, :pathim.connect.planner/index-attrs {:a #{1}, :b #{1}}, :pathim.connect.planner/root 1}))

  (testing "merge AND branches connected with other AND branches"
    (check
      (compute-run-graph
        {:pathim.connect.planner-test/resolvers [{:pathim.connect.operation/op-name 'a
                       :pathim.connect.operation/output  [:a]}
                      {:pathim.connect.operation/op-name 'b
                       :pathim.connect.operation/output  [:b]}]
         :pathim.eql/query [:a :b {:>/s1 [:a :b]}]})
      => '{:pathim.connect.planner/index-attrs  {:b #{2}, :a #{1}},
           :pathim.connect.planner/user-request-shape
           {:b {}, :>/s1 {:b {}, :a {}}, :a {}},
           :pathim.connect.planner/root         6,
           :pathim.connect.planner/index-ast
           {:b {:key :b, :type :prop, :dispatch-key :b},
            :>/s1
            {:children
             [{:key :a, :type :prop, :dispatch-key :a}
              {:key :b, :type :prop, :dispatch-key :b}],
             :key          :>/s1,
             :type         :join,
             :dispatch-key :>/s1,
             :query        [:a :b]},
            :a {:key :a, :type :prop, :dispatch-key :a}},
           :pathim.connect.planner/placeholders #{:>/s1},
           :pathim.connect.planner/index-resolver->nodes
           {a #{1}, b #{2}},
           :pathim.connect.planner/nodes
           {1
