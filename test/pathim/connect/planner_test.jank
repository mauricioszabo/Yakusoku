                                            :order/line-items  #{2}},
               :pathim.connect.planner/root                  2})))))

(deftest compute-run-graph-dynamic-unions-test
  (testing "forward union"
    (is (= (compute-run-graph
             {:pathim.connect.indexes/index-resolvers {'dyn {:pathim.connect.operation/op-name           'dyn
                                           :pathim.connect.operation/cache?            false
                                           :pathim.connect.operation/dynamic-resolver? true
                                           :pathim.connect.operation/resolve           (fn [_ _])}
                                     'a   {:pathim.connect.operation/op-name      'a
                                           :pathim.connect.operation/dynamic-name 'dyn
                                           :pathim.connect.operation/output       [{:a [:b :c]}]
                                           :pathim.connect.operation/provides     {:a {:b {}
                                                                   :c {}}}
                                           :pathim.connect.operation/resolve      (fn [_ _])}}
              :pathim.connect.indexes/index-oir       {:a {{} #{'a}}}
              :pathim.eql/query           [{:a {:b [:b]
                                          :c [:c]}}]})
           '{:pathim.connect.planner/nodes                 {1 {:pathim.connect.operation/op-name        dyn,
                                             :pathim.connect.planner/source-op-name a
                                             :pathim.connect.planner/expects        {:a {:b {:b {}},
                                                                       :c {:c {}}}},
                                             :pathim.connect.planner/input          {},
                                             :pathim.connect.planner/node-id        1,
                                             :pathim.connect.planner/foreign-ast    {:type     :root,
                                                                   :children [{:type         :join,
                                                                               :dispatch-key :a,
                                                                               :key          :a,
                                                                               :query        {:b [:b],
                                                                                              :c [:c]},
                                                                               :children     [{:type     :union,
                                                                                               :children [{:type      :union-entry,
                                                                                                           :union-key :b,
                                                                                                           :children  [{:type         :prop,
                                                                                                                        :key          :b,
                                                                                                                        :dispatch-key :b}]}
                                                                                                          {:type      :union-entry,
                                                                                                           :union-key :c,
                                                                                                           :children  [{:type         :prop,
                                                                                                                        :key          :c,
                                                                                                                        :dispatch-key :c}]}]}]}]}}},
             :pathim.connect.planner/index-ast             {:a {:type         :join,
                                              :dispatch-key :a,
                                              :key          :a,
                                              :query        {:b [:b], :c [:c]},
                                              :children     [{:type     :union,
                                                              :query    {:b [:b],
                                                                         :c [:c]},
                                                              :children [{:type      :union-entry,
                                                                          :union-key :b,
                                                                          :query     [:b],
                                                                          :children  [{:type         :prop,
                                                                                       :dispatch-key :b,
                                                                                       :key          :b}]}
                                                                         {:type      :union-entry,
                                                                          :union-key :c,
                                                                          :query     [:c],
                                                                          :children  [{:type         :prop,
                                                                                       :dispatch-key :c,
                                                                                       :key          :c}]}]}]}},
             :pathim.connect.planner/index-resolver->nodes {dyn #{1}},
             :pathim.connect.planner/user-request-shape    {:a {:b {}
                                              :c {}}}
             :pathim.connect.planner/index-attrs           {:a #{1}},
             :pathim.connect.planner/root                  1}))))

(deftest compute-run-graph-cache-test
  (testing "idents"
    (let [cache* (atom {})
          _      (compute-run-graph
                   {:pathim.connect.planner/plan-cache* cache*
                    :pathim.connect.planner-test/resolvers       [{:pathim.connect.operation/op-name 'a
                                        :pathim.connect.operation/output  [:a]}]
                    :pathim.eql/query       [:a [:foo "bar"]]})
          cache-size (count @cache*)]
      (compute-run-graph
        {:pathim.connect.planner/plan-cache* cache*
         :pathim.connect.planner-test/resolvers       [{:pathim.connect.operation/op-name 'a
                             :pathim.connect.operation/output  [:a]}]
         :pathim.eql/query       [:a [:foo "baz"]]})
      (is (= cache-size (count @cache*))))))

(deftest find-run-next-descendants-test
  (testing "return the node if that's the latest"
    (is (= (pcp/find-run-next-descendants
             {:pathim.connect.planner/nodes {1 {:pathim.connect.planner/node-id 1}}}
             {:pathim.connect.planner/node-id 1})
           [{:pathim.connect.planner/node-id 1}]))
    (is (= (pcp/find-run-next-descendants
             {:pathim.connect.planner/nodes {1 {:pathim.connect.planner/node-id  1
                              :pathim.connect.planner/run-next 2}
                           2 {:pathim.connect.planner/node-id 2}}}
             {:pathim.connect.planner/node-id  1
              :pathim.connect.planner/run-next 2})
           [{:pathim.connect.planner/node-id  1
             :pathim.connect.planner/run-next 2}
            {:pathim.connect.planner/node-id 2}]))))

(deftest find-leaf-node-test
  (testing "return the node if that's the latest"
    (is (= (pcp/find-leaf-node
             {:pathim.connect.planner/nodes {1 {:pathim.connect.planner/node-id 1}}}
             {:pathim.connect.planner/node-id 1})
           {:pathim.connect.planner/node-id 1}))

    (is (= (pcp/find-leaf-node
             {:pathim.connect.planner/nodes {1 {:pathim.connect.planner/node-id  1
                              :pathim.connect.planner/run-next 2}
                           2 {:pathim.connect.planner/node-id 2}}}
             {:pathim.connect.planner/node-id  1
              :pathim.connect.planner/run-next 2})
           {:pathim.connect.planner/node-id 2}))))

(deftest node-ancestors-test
  (is (= (pcp/node-ancestors
           '{:pathim.connect.planner/nodes {1 {:pathim.connect.planner/node-id 1}
                          2 {:pathim.connect.planner/node-parents #{1}}}}
           2)
         [2 1]))

  (is (= (pcp/node-ancestors
           '{:pathim.connect.planner/nodes {1 {:pathim.connect.planner/node-id 1}
                          2 {:pathim.connect.planner/node-parents #{1}}
                          3 {:pathim.connect.planner/node-parents #{2}}}}
           3)
         [3 2 1]))

  (is (= (pcp/node-ancestors
           '{:pathim.connect.planner/nodes {1 {:pathim.connect.planner/node-id 1}
                          2 {:pathim.connect.planner/node-id 2}
                          3 {:pathim.connect.planner/node-id 3}
                          4 {:pathim.connect.planner/node-parents #{2 1}}
                          5 {:pathim.connect.planner/node-parents #{3}}
                          6 {:pathim.connect.planner/node-parents #{5 4}}}}
           6)
         [6 4 5 1 2 3])))

(deftest node-successors-test
  (testing "leaf"
    (is (= (pcp/node-successors
             '{:pathim.connect.planner/nodes {1 {}}}
             1)
           [1])))

  (testing "chains"
    (is (= (pcp/node-successors
             '{:pathim.connect.planner/nodes {1 {:pathim.connect.planner/run-next 2}
                            2 {}}}
             1)
           [1 2]))

    (is (= (pcp/node-successors
             '{:pathim.connect.planner/nodes {1 {:pathim.connect.planner/run-next 2}
                            2 {:pathim.connect.planner/run-next 3}
                            3 {}}}
             1)
           [1 2 3])))

  (testing "branches"
    (is (= (pcp/node-successors
             '{:pathim.connect.planner/nodes {1 {:pathim.connect.planner/run-and #{2 3}}
                            2 {}
                            3 {}}}
             1)
           [1 3 2]))

    (is (= (pcp/node-successors
             '{:pathim.connect.planner/nodes {1 {:pathim.connect.planner/run-or #{2 3}}
                            2 {}
                            3 {}}}
             1)
           [1 3 2]))

    (is (= (pcp/node-successors
             '{:pathim.connect.planner/nodes {1 {:pathim.connect.planner/run-and #{2 3 4 5}}
                            2 {}
                            3 {}
                            4 {}
                            5 {}}}
             1)
           [1 4 3 2 5])))

  (testing "branch and chains"
    (is (= (pcp/node-successors
             '{:pathim.connect.planner/nodes {1 {:pathim.connect.planner/run-and  #{2 3}
                               :pathim.connect.planner/run-next 4}
                            2 {}
                            3 {}
                            4 {}}}
             1)
           [1 3 2 4]))))

(deftest remove-node-test
  (testing "remove node and references"
    (is (= (pcp/remove-node
             '{:pathim.connect.planner/nodes                 {1 {:pathim.connect.planner/node-id 1
                                               :pathim.connect.operation/op-name a}}
               :pathim.connect.planner/index-resolver->nodes {a #{1}}}
             1)
           '{:pathim.connect.planner/nodes                 {}
             :pathim.connect.planner/index-resolver->nodes {}})))

  (testing "remove after node reference from run-next"
    (is (= (pcp/remove-node
             '{:pathim.connect.planner/nodes                 {1 {:pathim.connect.planner/node-id  1
                                               :pathim.connect.operation/op-name  a
                                               :pathim.connect.planner/run-next 2}
                                            2 {:pathim.connect.planner/node-id      2
                                               :pathim.connect.operation/op-name      b
                                               :pathim.connect.planner/node-parents #{1}}}
               :pathim.connect.planner/index-resolver->nodes {a #{1}
                                            b #{2}}}
             1)
           '{:pathim.connect.planner/nodes                 {2 {:pathim.connect.planner/node-id 2
                                             :pathim.connect.operation/op-name b}}
             :pathim.connect.planner/index-resolver->nodes {b #{2}}})))

  (testing "remove after node of branch nodes"
    (is (= (pcp/remove-node
             '{:pathim.connect.planner/nodes                 {1 {:pathim.connect.planner/node-id      1
                                               :pathim.connect.operation/op-name      a
                                               :pathim.connect.planner/node-parents #{3}}
                                            2 {:pathim.connect.planner/node-id      2
                                               :pathim.connect.operation/op-name      b
                                               :pathim.connect.planner/node-parents #{3}}
                                            3 {:pathim.connect.planner/run-and #{1 2}}}
               :pathim.connect.planner/index-resolver->nodes {a #{1}
                                            b #{2}}}
             3)
           '{:pathim.connect.planner/nodes                 {1 {:pathim.connect.planner/node-id 1
                                             :pathim.connect.operation/op-name a}
                                          2 {:pathim.connect.planner/node-id 2
                                             :pathim.connect.operation/op-name b}}
             :pathim.connect.planner/index-resolver->nodes {a #{1} b #{2}}})))

  (testing "trigger error when after node references are still pointing to it"
    (is (thrown? (pcp/remove-node
            '{:pathim.connect.planner/nodes                 {1 {:pathim.connect.planner/node-id      1
                                              :pathim.connect.operation/op-name      a
                                              :pathim.connect.planner/node-parents #{2}}
                                           2 {:pathim.connect.planner/node-id  2
                                              :pathim.connect.operation/op-name  b
                                              :pathim.connect.planner/run-next 1}}
              :pathim.connect.planner/index-resolver->nodes {a #{1}
                                           b #{2}}}
            1)))))

(deftest set-node-run-next-test
  (is (= (pcp/set-node-run-next
           {:pathim.connect.planner/nodes {1 {}
                         2 {}}}
           1
           2)
         {:pathim.connect.planner/nodes {1 {:pathim.connect.planner/run-next 2}
                       2 {:pathim.connect.planner/node-parents #{1}}}}))

  (is (= (pcp/set-node-run-next
           {:pathim.connect.planner/nodes {1 {:pathim.connect.planner/run-next 2}
                         2 {:pathim.connect.planner/node-parents #{1}}}}
           1
           nil)
         {:pathim.connect.planner/nodes {1 {}
                       2 {}}})))

(deftest graph-provides-test
  (is (= (pcp/graph-provides
           {:pathim.connect.planner/index-attrs {:b #{2}, :a #{1}}})
         #{:b :a})))

(deftest merge-unreachable-test
  (is (= (pcp/merge-unreachable
           {}
           {})
         {}))

  (is (= (pcp/merge-unreachable
           {}
           {:pathim.connect.planner/unreachable-paths {:a {}}})
         {:pathim.connect.planner/unreachable-paths {:a {}}})))

(deftest shape-reachable?-test
  (is (false? (pcp/shape-reachable?
                (compute-env
                  {:pathim.eql/query             [:scores-sum]
                   :pathim.error/lenient-mode? true
                   :pathim.connect.planner-test/resolvers             '[{:pathim.connect.operation/op-name scores-sum
                                              :pathim.connect.operation/input   [{:users [:user/score]}]
                                              :pathim.connect.operation/output  [:scores-sum]}
                                             {:pathim.connect.operation/op-name users
                                              :pathim.connect.operation/output  [{:users [:user/id]}]}]})
                {}
                {:users {:user/score {}}})))

  (is (true? (pcp/shape-reachable?
               (compute-env
                 {:pathim.eql/query [:scores-sum]
                  :pathim.connect.planner-test/resolvers '[{:pathim.connect.operation/op-name scores-sum
                                 :pathim.connect.operation/input   [{:users [:user/score]}]
                                 :pathim.connect.operation/output  [:scores-sum]}
                                {:pathim.connect.operation/op-name users
                                 :pathim.connect.operation/output  [{:users [:user/id]}]}]})
               {}
               {:users {:user/id {}}}))))

(deftest remove-root-node-cluster-test
  (is (= (pcp/remove-root-node-cluster
           {:pathim.connect.planner/nodes {1 {:pathim.connect.planner/node-id  1
                            :pathim.connect.planner/run-next 2}
                         2 {:pathim.connect.planner/run-and #{3 4}}
                         3 {:pathim.connect.planner/node-id 3}
                         4 {:pathim.connect.planner/node-id 4}
                         5 {:pathim.connect.planner/node-id 5}}}
           [1])
         {:pathim.connect.planner/nodes {5 {:pathim.connect.planner/node-id 5}}})))

