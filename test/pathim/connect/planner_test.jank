                                            :pathim.connect.operation/output  [:y]}]
                  :pathim.error/lenient-mode? true}))
           '{:pathim.connect.planner/index-ast             {:foo {:dispatch-key :foo
                                                :key          :foo
                                                :type         :prop}}
             :pathim.connect.planner/index-attrs           {:foo #{1}
                                          :x   #{2}
                                          :y   #{3}}
             :pathim.connect.planner/index-resolver->nodes {foo #{1}
                                          x   #{2}
                                          y   #{3}}
             :pathim.connect.planner/user-request-shape    {:foo {}}
             :pathim.connect.planner/nodes                 {1 {:pathim.connect.operation/op-name      foo
                                             :pathim.connect.planner/expects      {:foo {}}
                                             :pathim.connect.planner/input        {:x {}}
                                             :pathim.connect.planner/node-id      1
                                             :pathim.connect.planner/node-parents #{4}}
                                          2 {:pathim.connect.operation/op-name      x
                                             :pathim.connect.planner/expects      {:x {}}
                                             :pathim.connect.planner/input        {}
                                             :pathim.connect.planner/node-id      2
                                             :pathim.connect.planner/node-parents #{4}}
                                          3 {:pathim.connect.operation/op-name      y
                                             :pathim.connect.planner/expects      {:y {}}
                                             :pathim.connect.planner/input        {}
                                             :pathim.connect.planner/node-id      3
                                             :pathim.connect.planner/node-parents #{4}
                                             :pathim.connect.planner/params       {:pathim.connect.operation/optional? true}}
                                          4 {:pathim.connect.planner/node-id  4
                                             :pathim.connect.planner/expects  {:x {}
                                                             :y {}}
                                             :pathim.connect.planner/run-and  #{2
                                                              3}
                                             :pathim.connect.planner/run-next 1}}
             :pathim.connect.planner/root                  4})))

  (testing "only optional"
    (testing "unavailable"
      (is (= (compute-run-graph
               (-> {:pathim.eql/query             [:foo]
                    :pathim.connect.planner-test/resolvers             [{:pathim.connect.operation/op-name 'foo
                                              :pathim.connect.operation/input   [(pco/? :y)]
                                              :pathim.connect.operation/output  [:foo]}]
                    :pathim.error/lenient-mode? true}))
             '{:pathim.connect.planner/nodes                 {1 {:pathim.connect.operation/op-name foo,
                                               :pathim.connect.planner/node-id 1,
                                               :pathim.connect.planner/expects {:foo {}},
                                               :pathim.connect.planner/input   {},}},
               :pathim.connect.planner/user-request-shape    {:foo {}}
               :pathim.connect.planner/index-resolver->nodes {foo #{1}},
               :pathim.connect.planner/unreachable-paths     {:y {}},
               :pathim.connect.planner/index-ast             {:foo {:type         :prop,
                                                  :dispatch-key :foo,
                                                  :key          :foo}},
               :pathim.connect.planner/root                  1,
               :pathim.connect.planner/index-attrs           {:foo #{1}}})))

    (testing "available"
      (is (= (compute-run-graph
               (-> {:pathim.eql/query [:foo]
                    :pathim.connect.planner-test/resolvers [{:pathim.connect.operation/op-name 'foo
                                  :pathim.connect.operation/input   [(pco/? :y)]
                                  :pathim.connect.operation/output  [:foo]}
                                 {:pathim.connect.operation/op-name 'y
                                  :pathim.connect.operation/output  [:y]}]}))
             '{:pathim.connect.planner/index-ast             {:foo {:dispatch-key :foo
                                                  :key          :foo
                                                  :type         :prop}}
               :pathim.connect.planner/index-attrs           {:foo #{1}
                                            :y   #{2}}
               :pathim.connect.planner/index-resolver->nodes {foo #{1}
                                            y   #{2}}
               :pathim.connect.planner/user-request-shape    {:foo {}}
               :pathim.connect.planner/nodes                 {1 {:pathim.connect.operation/op-name      foo
                                               :pathim.connect.planner/expects      {:foo {}}
                                               :pathim.connect.planner/input        {}
                                               :pathim.connect.planner/node-id      1
                                               :pathim.connect.planner/node-parents #{2}}
                                            2 {:pathim.connect.operation/op-name  y
                                               :pathim.connect.planner/expects  {:y {}}
                                               :pathim.connect.planner/input    {}
                                               :pathim.connect.planner/node-id  2
                                               :pathim.connect.planner/params   {:pathim.connect.operation/optional? true}
                                               :pathim.connect.planner/run-next 1}}
               :pathim.connect.planner/root                  2})))))

(deftest compute-run-graph-placeholders-test
  (testing "just placeholder"
    (check (=> '{:pathim.connect.planner/nodes                 {1 {:pathim.connect.operation/op-name a,
                                                 :pathim.connect.planner/node-id 1,
                                                 :pathim.connect.planner/expects {:a {}},
                                                 :pathim.connect.planner/input   {},}},
                 :pathim.connect.planner/index-ast             {:>/p1 {:type :join, :dispatch-key :>/p1, :key :>/p1, :query [:a], :children [{:type :prop, :dispatch-key :a, :key :a}]}},
                 :pathim.connect.planner/placeholders          #{:>/p1},
                 :pathim.connect.planner/user-request-shape    {:>/p1 {:a {}}}
                 :pathim.connect.planner/index-resolver->nodes {a #{1}},
                 :pathim.connect.planner/root                  1,
                 :pathim.connect.planner/index-attrs           {:a #{1}}}
               (compute-run-graph
                 {:pathim.connect.indexes/index-oir '{:a {{} #{a}}}
                  :pathim.eql/query     [{:>/p1 [:a]}]}))))

  (testing "placeholder + external"
    (check (=> '{:pathim.connect.planner/nodes                 {1 {:pathim.connect.operation/op-name      a,
                                                 :pathim.connect.planner/node-id      1,
                                                 :pathim.connect.planner/expects      {:a {}},
                                                 :pathim.connect.planner/input        {},
                                                 :pathim.connect.planner/node-parents #{3}},
                                              2 {:pathim.connect.operation/op-name      b,
                                                 :pathim.connect.planner/node-id      2,
                                                 :pathim.connect.planner/expects      {:b {}},
                                                 :pathim.connect.planner/input        {},
                                                 :pathim.connect.planner/node-parents #{3}},
                                              3 {:pathim.connect.planner/node-id 3, :pathim.connect.planner/run-and #{1 2}}},
                 :pathim.connect.planner/index-ast             {:a    {:type         :prop,
                                                     :dispatch-key :a,
                                                     :key          :a},
                                              :>/p1 {:type         :join,
                                                     :dispatch-key :>/p1,
                                                     :key          :>/p1,
                                                     :query        [:b],
                                                     :children     [{:type         :prop,
                                                                     :dispatch-key :b,
                                                                     :key          :b}]}},
                 :pathim.connect.planner/user-request-shape    {:>/p1 {:b {}} :a {}}
                 :pathim.connect.planner/index-resolver->nodes {a #{1}, b #{2}},
                 :pathim.connect.planner/index-attrs           {:b #{2}, :a #{1}},
                 :pathim.connect.planner/placeholders          #{:>/p1},
                 :pathim.connect.planner/root                  3}
               (compute-run-graph
                 {:pathim.connect.indexes/index-oir '{:a {{} #{a}}
                                    :b {{} #{b}}}
                  :pathim.eql/query     [:a
                                   {:>/p1 [:b]}]}))))

  (testing "multiple placeholders repeating"
    (check (=> '{:pathim.connect.planner/index-ast             {:>/p1 {:children [{:dispatch-key :a, :key :a, :type :prop}], :dispatch-key :>/p1, :key :>/p1, :query [:a], :type :join}, :>/p2 {:children [{:dispatch-key :a, :key :a, :type :prop}], :dispatch-key :>/p2, :key :>/p2, :query [:a], :type :join}}
                 :pathim.connect.planner/user-request-shape    {:>/p1 {:a {}} :>/p2 {:a {}}}
                 :pathim.connect.planner/index-attrs           {:a #{1}}
                 :pathim.connect.planner/index-resolver->nodes {a #{1}}
                 :pathim.connect.planner/nodes                 {1 {:pathim.connect.operation/op-name a
                                                 :pathim.connect.planner/expects {:a {}}
                                                 :pathim.connect.planner/input   {}
                                                 :pathim.connect.planner/node-id 1}}
                 :pathim.connect.planner/placeholders          #{:>/p1
                                               :>/p2}
                 :pathim.connect.planner/root                  1}
               (compute-run-graph
                 {:pathim.connect.indexes/index-oir '{:a {{} #{a}}}
                  :pathim.eql/query     [{:>/p1 [:a]}
                                   {:>/p2 [:a]}]}))))

  (testing "nested placeholders"
    (check (=> '{:pathim.connect.planner/index-ast             {:>/p1 {:children     [{:dispatch-key :a
                                                                     :key          :a
                                                                     :type         :prop}
                                                                    {:children     [{:dispatch-key :b
                                                                                     :key          :b
                                                                                     :type         :prop}]
                                                                     :dispatch-key :>/p2
                                                                     :key          :>/p2
                                                                     :query        [:b]
                                                                     :type         :join}]
                                                     :dispatch-key :>/p1
                                                     :key          :>/p1
                                                     :query        [:a
                                                                    {:>/p2 [:b]}]
                                                     :type         :join}
                                              :>/p2 {:children     [{:dispatch-key :b
                                                                     :key          :b
                                                                     :type         :prop}]
                                                     :dispatch-key :>/p2
                                                     :key          :>/p2
                                                     :query        [:b]
                                                     :type         :join}}
                 :pathim.connect.planner/index-attrs           {:a #{1}
                                              :b #{2}}
                 :pathim.connect.planner/index-resolver->nodes {a #{1}
                                              b #{2}}
                 :pathim.connect.planner/user-request-shape    {:>/p1 {:a {} :>/p2 {:b {}}}}
                 :pathim.connect.planner/nodes                 {1 {:pathim.connect.operation/op-name a
                                                 :pathim.connect.planner/expects                                  {:a {}}
                                                 :pathim.connect.planner/input                                    {}
                                                 :pathim.connect.planner/node-id                                  1
                                                 :pathim.connect.planner/node-parents                             #{3}}
                                              2 {:pathim.connect.operation/op-name b
                                                 :pathim.connect.planner/expects                                  {:b {}}
                                                 :pathim.connect.planner/input                                    {}
                                                 :pathim.connect.planner/node-id                                  2
                                                 :pathim.connect.planner/node-parents                             #{3}}
                                              3 {:pathim.connect.planner/node-id 3
                                                 :pathim.connect.planner/run-and #{1
                                                                 2}}}
                 :pathim.connect.planner/placeholders          #{:>/p1
                                               :>/p2}
                 :pathim.connect.planner/root                  3}
               (compute-run-graph
                 {:pathim.connect.indexes/index-oir '{:a {{} #{a}}
                                    :b {{} #{b}}}
                  :pathim.eql/query     [{:>/p1
                                    [:a
                                     {:>/p2 [:b]}]}]}))))

  #_(testing "conflict between params"
      (is (= (compute-run-graph
               {:pathim.connect.indexes/index-oir '{:a {#{} #{a}}}
                :pathim.eql/query     '[(:a {:foo "bar"})
                                  {:>/p1 [(:a {:foo "baz"})]}]})
             {}))))

(deftest compute-run-graph-params-test
  (testing "add params to resolver call"
    (is (= (compute-run-graph
             {:pathim.connect.planner-test/resolvers [{:pathim.connect.operation/op-name 'a
                            :pathim.connect.operation/output  [:a]}]
              :pathim.eql/query [(list :a {:x "y"})]})
           '{:pathim.connect.planner/nodes                 {1 {:pathim.connect.operation/op-name a
                                             :pathim.connect.planner/params  {:x "y"}
                                             :pathim.connect.planner/node-id 1
                                             :pathim.connect.planner/expects {:a {}}
                                             :pathim.connect.planner/input   {}}}
             :pathim.connect.planner/index-resolver->nodes {a #{1}}
             :pathim.connect.planner/user-request-shape    {:a {}}
             :pathim.connect.planner/root                  1
             :pathim.connect.planner/index-attrs           {:a #{1}}
             :pathim.connect.planner/index-ast             {:a {:type         :prop,
                                              :dispatch-key :a,
                                              :key          :a,
                                              :params       {:x "y"}}}})))

  (testing "params while collapsing"
    (testing "params come from first node"
      (is (= (compute-run-graph
               {:pathim.connect.indexes/index-oir '{:a {{} #{a}}
                                  :b {{} #{a}}}
                :pathim.eql/query     [(list :a {:x 1}) :b]})
             '{:pathim.connect.planner/index-ast             {:a {:dispatch-key :a
                                                :key          :a
                                                :params       {:x 1}
                                                :type         :prop}
                                            :b {:dispatch-key :b
                                                :key          :b
                                                :type         :prop}}
               :pathim.connect.planner/index-attrs           {:a #{1}
                                            :b #{1}}
               :pathim.connect.planner/index-resolver->nodes {a #{1}}
               :pathim.connect.planner/user-request-shape    {:a {} :b {}}
               :pathim.connect.planner/nodes                 {1 {:pathim.connect.operation/op-name a
                                               :pathim.connect.planner/expects {:a {}
                                                              :b {}}
                                               :pathim.connect.planner/input   {}
                                               :pathim.connect.planner/node-id 1
                                               :pathim.connect.planner/params  {:x 1}}}
               :pathim.connect.planner/root                  1}))))

  (testing "params should merge when different attributes are related to same node call"
    (is (= (compute-run-graph
             {:pathim.connect.planner-test/resolvers [{:pathim.connect.operation/op-name 'a
                            :pathim.connect.operation/output  [:a :b]}]
              :pathim.eql/query [(list :a {:x "y"}) (list :b {:z "foo"})]})
           '{:pathim.connect.planner/nodes {1 {:pathim.connect.operation/op-name a,
                                                            :pathim.connect.planner/expects {:a {}, :b {}},
                                                            :pathim.connect.planner/input {},
                                                            :pathim.connect.planner/node-id 1,
                                                            :pathim.connect.planner/params {:x "y", :z "foo"}}},
             :pathim.connect.planner/index-ast {:a {:type :prop, :dispatch-key :a, :key :a, :params {:x "y"}},
                                                             :b {:type :prop, :dispatch-key :b, :key :b, :params {:z "foo"}}},
             :pathim.connect.planner/user-request-shape {:a {}, :b {}},
             :pathim.connect.planner/index-resolver->nodes {a #{1}},
             :pathim.connect.planner/index-attrs {:a #{1}, :b #{1}},
             :pathim.connect.planner/root 1})))

  (testing "all resolver calls from same resolver must have consistent parameters"
    (check (=> '{:pathim.connect.planner/nodes {1 {:pathim.connect.operation/op-name email-body,
                                                                :pathim.connect.planner/expects {:email/body {}},
                                                                :pathim.connect.planner/input {},
                                                                :pathim.connect.planner/node-id 1,
                                                                :pathim.connect.planner/params {:text? true},
                                                                :pathim.connect.planner/node-parents #{6}},
                                                             2 {:pathim.connect.operation/op-name email-valid?,
                                                                :pathim.connect.planner/expects {:email/valid? {}},
                                                                :pathim.connect.planner/input {:email/body {},
                                                                                                            :email/subject {}},
                                                                :pathim.connect.planner/node-id 2,
                                                                :pathim.connect.planner/node-parents #{5}},
                                                             3 {:pathim.connect.operation/op-name email-body,
                                                                :pathim.connect.planner/expects {:email/body {}},
                                                                :pathim.connect.planner/input {},
                                                                :pathim.connect.planner/node-id 3,
                                                                :pathim.connect.planner/params {:text? true},
                                                                :pathim.connect.planner/node-parents #{5}},
                                                             4 {:pathim.connect.operation/op-name email-subject,
                                                                :pathim.connect.planner/expects {:email/subject {}},
                                                                :pathim.connect.planner/input {},
                                                                :pathim.connect.planner/node-id 4,
                                                                :pathim.connect.planner/node-parents #{5}},
                                                             5 {:pathim.connect.planner/node-id 5,
                                                                :pathim.connect.planner/run-and #{4 3},
                                                                :pathim.connect.planner/run-next 2,
                                                                :pathim.connect.planner/node-parents #{6}},
                                                             6 {:pathim.connect.planner/node-id 6,
                                                                :pathim.connect.planner/run-and #{1 5}}},
                 :pathim.connect.planner/index-ast {:email/body {:type :prop,
                                                                              :dispatch-key :email/body,
                                                                              :key :email/body,
                                                                              :params {:text? true}},
                                                                 :email/valid? {:type :prop,
                                                                                :dispatch-key :email/valid?,
                                                                                :key :email/valid?}},
                 :pathim.connect.planner/user-request-shape {:email/body {}, :email/valid? {}},
                 :pathim.connect.planner/index-resolver->nodes {email-body #{1 3}, email-valid? #{2}, email-subject #{4}},
                 :pathim.connect.planner/index-attrs {:email/body #{1 3}, :email/valid? #{2}, :email/subject #{4}},
                 :pathim.connect.planner/root 6}
               (compute-run-graph
                 {:pathim.connect.indexes/index-oir '{:email/body
                                    {{} #{email-body}},
                                    :email/subject
                                    {{} #{email-subject}},
                                    :email/valid?
                                    {{:email/body {}, :email/subject {}}
                                     #{email-valid?}}}
                  :pathim.eql/query     ['(:email/body {:text? true})
                                   :email/valid?]})))))

(deftest compute-run-graph-optimize-test
  (testing "optimize AND nodes"
    (is (= (compute-run-graph
             {:pathim.connect.indexes/index-oir {:a {{} #{'x}}
                               :b {{} #{'x}}}
              :pathim.eql/query     [:a :b]})
           '{:pathim.connect.planner/nodes                 {1 {:pathim.connect.operation/op-name x,
                                             :pathim.connect.planner/expects {:a {},
                                                            :b {}},
                                             :pathim.connect.planner/input   {},
                                             :pathim.connect.planner/node-id 1}},
             :pathim.connect.planner/index-ast             {:a {:type         :prop,
                                              :dispatch-key :a,
                                              :key          :a},
                                          :b {:type         :prop,
                                              :dispatch-key :b,
                                              :key          :b}},
             :pathim.connect.planner/user-request-shape    {:a {} :b {}}
             :pathim.connect.planner/index-resolver->nodes {x #{1}},
             :pathim.connect.planner/index-attrs           {:a #{1}, :b #{1}},
             :pathim.connect.planner/root                  1}))

    (testing "multiple nodes"
      (is (= (compute-run-graph
               {:pathim.connect.indexes/index-oir {:a {{} #{'x}}
                                 :b {{} #{'x}}
                                 :c {{} #{'x}}}
                :pathim.eql/query     [:a :b :c]})
             '{:pathim.connect.planner/nodes                 {1 {:pathim.connect.operation/op-name x,
                                               :pathim.connect.planner/expects {:a {},
                                                              :b {},
                                                              :c {}},
                                               :pathim.connect.planner/input   {},
                                               :pathim.connect.planner/node-id 1}},
               :pathim.connect.planner/index-ast             {:a {:type         :prop,
                                                :dispatch-key :a,
                                                :key          :a},
                                            :b {:type         :prop,
                                                :dispatch-key :b,
                                                :key          :b},
                                            :c {:type         :prop,
                                                :dispatch-key :c,
                                                :key          :c}},
               :pathim.connect.planner/user-request-shape    {:a {} :b {} :c {}}
               :pathim.connect.planner/index-resolver->nodes {x #{1}},
               :pathim.connect.planner/index-attrs           {:a #{1}, :b #{1}, :c #{1}},
               :pathim.connect.planner/root                  1})))

    (testing "multiple resolvers"
      (is (= (compute-run-graph
               {:pathim.connect.indexes/index-oir {:a {{} #{'x}}
                                 :b {{} #{'y}}
                                 :c {{} #{'x}}
                                 :d {{} #{'z}}
                                 :e {{} #{'z}}
                                 :f {{} #{'x}}}
                :pathim.eql/query     [:a :b :c :d :e :f]})
             '{:pathim.connect.planner/nodes                 {1 {:pathim.connect.operation/op-name      x,
                                               :pathim.connect.planner/expects      {:a {},
                                                                   :c {},
                                                                   :f {}},
                                               :pathim.connect.planner/input        {},
                                               :pathim.connect.planner/node-id      1,
                                               :pathim.connect.planner/node-parents #{7}},
                                            2 {:pathim.connect.operation/op-name      y,
                                               :pathim.connect.planner/expects      {:b {}},
                                               :pathim.connect.planner/input        {},
                                               :pathim.connect.planner/node-id      2,
                                               :pathim.connect.planner/node-parents #{7}},
                                            4 {:pathim.connect.operation/op-name      z,
                                               :pathim.connect.planner/expects      {:d {},
                                                                   :e {}},
                                               :pathim.connect.planner/input        {},
                                               :pathim.connect.planner/node-id      4,
                                               :pathim.connect.planner/node-parents #{7}},
                                            7 {:pathim.connect.planner/node-id 7, :pathim.connect.planner/expects {:a {}, :b {}, :c {}, :d {}, :e {}, :f {}}, :pathim.connect.planner/run-and #{1 4 2}}},
               :pathim.connect.planner/user-request-shape    {:a {} :b {} :c {} :d {} :e {} :f {}}
               :pathim.connect.planner/index-ast             {:a {:type         :prop,
                                                :dispatch-key :a,
                                                :key          :a},
                                            :b {:type         :prop,
                                                :dispatch-key :b,
                                                :key          :b},
                                            :c {:type         :prop,
                                                :dispatch-key :c,
                                                :key          :c},
                                            :d {:type         :prop,
                                                :dispatch-key :d,
                                                :key          :d},
                                            :e {:type         :prop,
                                                :dispatch-key :e,
                                                :key          :e},
                                            :f {:type         :prop,
                                                :dispatch-key :f,
                                                :key          :f}},
               :pathim.connect.planner/index-resolver->nodes {x #{1}, y #{2}, z #{4}},
               :pathim.connect.planner/index-attrs           {:a #{1},
                                            :b #{2},
                                            :c #{1},
                                            :d #{4},
                                            :e #{4},
                                            :f #{1}},
               :pathim.connect.planner/root                  7}))))

  (is (= (compute-run-graph
           {:pathim.connect.indexes/index-oir {:a {{} #{'x}}
                             :b {{} #{'x}}
                             :c {{:a {} :b {}} #{'c}}}
            :pathim.eql/query     [:c]})
         '{:pathim.connect.planner/nodes                 {1 {:pathim.connect.operation/op-name      c,
                                           :pathim.connect.planner/expects      {:c {}},
                                           :pathim.connect.planner/input        {:a {},
                                                               :b {}},
                                           :pathim.connect.planner/node-id      1,
                                           :pathim.connect.planner/node-parents #{2}},
                                        2 {:pathim.connect.operation/op-name  x,
                                           :pathim.connect.planner/expects  {:a {},
                                                           :b {}},
                                           :pathim.connect.planner/input    {},
                                           :pathim.connect.planner/node-id  2,
                                           :pathim.connect.planner/run-next 1}},
           :pathim.connect.planner/user-request-shape    {:c {}}
           :pathim.connect.planner/index-ast             {:c {:type         :prop,
                                            :dispatch-key :c,
                                            :key          :c}},
           :pathim.connect.planner/index-resolver->nodes {c #{1}, x #{2}},
           :pathim.connect.planner/index-attrs           {:c #{1}, :a #{2}, :b #{2}},
           :pathim.connect.planner/root                  2}))

  (is (= (compute-run-graph
           {:pathim.connect.indexes/index-oir {:a {{:z {}} #{'x}}
                             :b {{:z {}} #{'x}}
                             :z {{} #{'z}}
                             :c {{:a {} :b {}} #{'c}}}
            :pathim.eql/query     [:c]})
         '{:pathim.connect.planner/nodes                 {1 {:pathim.connect.operation/op-name      c,
                                           :pathim.connect.planner/expects      {:c {}},
                                           :pathim.connect.planner/input        {:a {},
                                                               :b {}},
                                           :pathim.connect.planner/node-id      1,
                                           :pathim.connect.planner/node-parents #{2}},
                                        2 {:pathim.connect.operation/op-name      x,
                                           :pathim.connect.planner/expects      {:a {},
                                                               :b {}},
                                           :pathim.connect.planner/input        {:z {}},
                                           :pathim.connect.planner/node-id      2,
                                           :pathim.connect.planner/node-parents #{3},
                                           :pathim.connect.planner/run-next     1},
                                        3 {:pathim.connect.operation/op-name  z,
                                           :pathim.connect.planner/expects  {:z {}},
                                           :pathim.connect.planner/input    {},
                                           :pathim.connect.planner/node-id  3,
                                           :pathim.connect.planner/run-next 2}},
           :pathim.connect.planner/user-request-shape    {:c {}}
           :pathim.connect.planner/index-ast             {:c {:type         :prop,
                                            :dispatch-key :c,
                                            :key          :c}},
           :pathim.connect.planner/index-resolver->nodes {c #{1}, x #{2}, z #{3}},
           :pathim.connect.planner/index-attrs           {:c #{1}, :a #{2}, :z #{3}, :b #{2}},
           :pathim.connect.planner/root                  3}))

  (testing "optimize AND not at root"
    (is (= (compute-run-graph
             {:pathim.connect.indexes/index-oir {:a {{:z {}} #{'x}}
                               :b {{:z {}} #{'x}}
                               :z {{} #{'z}}}
              :pathim.eql/query     [:a :b]})
           '{:pathim.connect.planner/nodes                 {1 {:pathim.connect.operation/op-name      x,
                                             :pathim.connect.planner/expects      {:a {},
                                                                 :b {}},
                                             :pathim.connect.planner/input        {:z {}},
                                             :pathim.connect.planner/node-id      1,
                                             :pathim.connect.planner/node-parents #{2}},
                                          2 {:pathim.connect.operation/op-name  z,
                                             :pathim.connect.planner/expects  {:z {}},
                                             :pathim.connect.planner/input    {},
                                             :pathim.connect.planner/node-id  2,
                                             :pathim.connect.planner/run-next 1}},
             :pathim.connect.planner/index-ast             {:a {:type         :prop,
                                              :dispatch-key :a,
                                              :key          :a},
                                          :b {:type         :prop,
                                              :dispatch-key :b,
                                              :key          :b}},
             :pathim.connect.planner/user-request-shape    {:a {} :b {}}
             :pathim.connect.planner/index-resolver->nodes {x #{1}, z #{2}},
             :pathim.connect.planner/index-attrs           {:a #{1}, :z #{2}, :b #{1}},
             :pathim.connect.planner/root                  2})))

  (testing "optimize AND next node")

  (testing "OR nodes"
    (testing "navigate OR nodes"
      (is (= (compute-run-graph
               {:pathim.connect.indexes/index-oir '{:a {{:x {}}       #{ax}
                                      {:y {} :z {}} #{ayz}}
                                  :x {{} #{x}}
                                  :y {{} #{yz}}
                                  :z {{} #{yz}}}
                ;:pathim.connect.planner/snapshots* (atom [])
                :pathim.eql/query     [:a]})
             '{:pathim.connect.planner/nodes                 {1 {:pathim.connect.operation/op-name      ax,
                                               :pathim.connect.planner/expects      {:a {}},
                                               :pathim.connect.planner/input        {:x {}},
                                               :pathim.connect.planner/node-id      1,
                                               :pathim.connect.planner/node-parents #{2}},
                                            2 {:pathim.connect.operation/op-name      x,
                                               :pathim.connect.planner/expects      {:x {}},
                                               :pathim.connect.planner/input        {},
                                               :pathim.connect.planner/node-id      2,
                                               :pathim.connect.planner/run-next     1,
                                               :pathim.connect.planner/node-parents #{7}},
                                            3 {:pathim.connect.operation/op-name      ayz,
                                               :pathim.connect.planner/expects      {:a {}},
                                               :pathim.connect.planner/input        {:y {},
                                                                   :z {}},
                                               :pathim.connect.planner/node-id      3,
                                               :pathim.connect.planner/node-parents #{4}},
                                            4 {:pathim.connect.operation/op-name      yz,
                                               :pathim.connect.planner/expects      {:y {},
                                                                   :z {}},
                                               :pathim.connect.planner/input        {},
                                               :pathim.connect.planner/node-id      4,
                                               :pathim.connect.planner/node-parents #{7},
                                               :pathim.connect.planner/run-next     3},
                                            7 {:pathim.connect.planner/expects {:a {}},
                                               :pathim.connect.planner/node-id 7,
                                               :pathim.connect.planner/run-or  #{4
                                                               2}}},
               :pathim.connect.planner/user-request-shape    {:a {}}
               :pathim.connect.planner/index-ast             {:a {:type         :prop,
                                                :dispatch-key :a,
                                                :key          :a}},
               :pathim.connect.planner/index-resolver->nodes {ax  #{1},
                                            x   #{2},
                                            ayz #{3},
                                            yz  #{4}},
               :pathim.connect.planner/index-attrs           {:a #{1 3}, :x #{2}, :y #{4}, :z #{4}},
               :pathim.connect.planner/root                  7})))

    #_(testing "merge equal OR's on AND's"
        (is (= (compute-run-graph
                 {:pathim.connect.indexes/index-oir  {:a {{} #{'x 'x2}}
                                    :b {{} #{'x 'x2}}}
                  :pathim.connect.planner/snapshots* (atom [])
                  :pathim.eql/query      [:a :b]})
               '{})))))

(deftest compute-run-graph-dynamic-resolvers-test
  (testing "unreachable"
    (is (= (compute-run-graph
             {:pathim.connect.indexes/index-resolvers   {'dynamic-resolver {:pathim.connect.operation/op-name           'dynamic-resolver
                                                          :pathim.connect.operation/cache?            false
                                                          :pathim.connect.operation/dynamic-resolver? true
                                                          :pathim.connect.operation/resolve           (fn [_ _])}}
              :pathim.connect.indexes/index-oir         {:release/script {{:db/id {}} #{'dynamic-resolver}}}
              :pathim.eql/query             [:release/script]
              :pathim.error/lenient-mode? true})
           {:pathim.connect.planner/index-ast            {:release/script {:dispatch-key :release/script
                                                         :key          :release/script
                                                         :type         :prop}}
            :pathim.connect.planner/nodes                {}
            :pathim.connect.planner/user-request-shape   {:release/script {}}
            :pathim.connect.planner/unreachable-paths    {:db/id          {}
                                        :release/script {}}
            :pathim.connect.planner/verification-failed? true})))

  (testing "simple dynamic call"
    (is (= (compute-run-graph
             {:pathim.connect.indexes/index-resolvers {'dynamic-resolver
                                     {:pathim.connect.operation/op-name           'dynamic-resolver
                                      :pathim.connect.operation/cache?            false
                                      :pathim.connect.operation/dynamic-resolver? true
                                      :pathim.connect.operation/resolve           (fn [_ _])}}
              :pathim.connect.indexes/index-oir       {:release/script {{:db/id {}} #{'dynamic-resolver}}}
              :pathim.connect.planner/available-data  {:db/id {}}
              :pathim.eql/query           [:release/script]})

           {:pathim.connect.planner/nodes                 {1 {:pathim.connect.operation/op-name        'dynamic-resolver
                                            :pathim.connect.planner/source-op-name 'dynamic-resolver
                                            :pathim.connect.planner/node-id        1
                                            :pathim.connect.planner/expects        {:release/script {}}
                                            :pathim.connect.planner/input          {:db/id {}}
                                            :pathim.connect.planner/foreign-ast    (eql/query->ast [:release/script])}}
            :pathim.connect.planner/index-resolver->nodes {'dynamic-resolver #{1}}
            :pathim.connect.planner/root                  1
            :pathim.connect.planner/user-request-shape    {:release/script {}}
            :pathim.connect.planner/index-attrs           {:release/script #{1}}
            :pathim.connect.planner/index-ast             {:release/script {:type         :prop,
                                                          :dispatch-key :release/script,
                                                          :key          :release/script}}}))

    (testing "dynamic extensions"
      (is (= (compute-run-graph
               {:pathim.connect.indexes/index-resolvers {'dynamic-resolver
                                       {:pathim.connect.operation/op-name           'dynamic-resolver
                                        :pathim.connect.operation/cache?            false
                                        :pathim.connect.operation/dynamic-resolver? true
                                        :pathim.connect.operation/resolve           (fn [_ _])}

                                       'a
                                       {:pathim.connect.operation/op-name      'a
                                        :pathim.connect.operation/input        []
                                        :pathim.connect.operation/output       [:a]
                                        :pathim.connect.operation/requires     {}
                                        :pathim.connect.operation/provides     {:a {}}
                                        :pathim.connect.operation/dynamic-name 'dynamic-resolver}}
                :pathim.connect.indexes/index-oir       {:a {{} #{'a}}}
                :pathim.connect.planner/available-data  {}
                :pathim.eql/query           [:a]})

             '{:pathim.connect.planner/nodes                 {1 {:pathim.connect.operation/op-name        dynamic-resolver
                                               :pathim.connect.planner/source-op-name a
                                               :pathim.connect.planner/expects        {:a {}}
                                               :pathim.connect.planner/input          {}
                                               :pathim.connect.planner/node-id        1
                                               :pathim.connect.planner/foreign-ast    {:type     :root
                                                                     :children [{:type         :prop
                                                                                 :dispatch-key :a
                                                                                 :key          :a}]}}}
               :pathim.connect.planner/index-ast             {:a {:type         :prop
                                                :dispatch-key :a
                                                :key          :a}}
               :pathim.connect.planner/user-request-shape    {:a {}}
               :pathim.connect.planner/index-resolver->nodes {dynamic-resolver #{1}}
               :pathim.connect.planner/index-attrs           {:a #{1}}
               :pathim.connect.planner/root                  1})))

    (testing "retain params"
      (is (= (compute-run-graph
               {:pathim.connect.planner-test/dynamics  {'dyn [{:pathim.connect.operation/op-name 'a
                                    :pathim.connect.operation/output  [:a]}]}
                :pathim.eql/query [(list :a {:b "c"})]})

             '{:pathim.connect.planner/nodes                 {1 {:pathim.connect.operation/op-name        dyn,
                                               :pathim.connect.planner/expects        {:a {}},
                                               :pathim.connect.planner/input          {},
                                               :pathim.connect.planner/node-id        1,
                                               :pathim.connect.planner/params         {:b "c"},
                                               :pathim.connect.planner/source-op-name a,
                                               :pathim.connect.planner/foreign-ast    {:type     :root,
                                                                     :children [{:type         :prop,
                                                                                 :dispatch-key :a,
                                                                                 :key          :a,
                                                                                 :params       {:b "c"}}]}}},
               :pathim.connect.planner/index-ast             {:a {:type         :prop,
                                                :dispatch-key :a,
                                                :key          :a,
                                                :params       {:b "c"}}},
               :pathim.connect.planner/user-request-shape    {:a {}}
               :pathim.connect.planner/index-resolver->nodes {dyn #{1}},
               :pathim.connect.planner/index-attrs           {:a #{1}},
               :pathim.connect.planner/root                  1}))

      (testing "nested params"
        (is (= (compute-run-graph
                 {:pathim.connect.planner-test/dynamics  {'dyn [{:pathim.connect.operation/op-name 'a
                                      :pathim.connect.operation/output  [{:a [:b]}]}]}
                  :pathim.eql/query [{:a [(list :b {:p "v"})]}]})
               '{:pathim.connect.planner/nodes                 {1 {:pathim.connect.operation/op-name        dyn,
                                                 :pathim.connect.planner/expects        {:a {:b {}}},
                                                 :pathim.connect.planner/input          {},
                                                 :pathim.connect.planner/node-id        1,
                                                 :pathim.connect.planner/source-op-name a,
                                                 :pathim.connect.planner/foreign-ast    {:type     :root,
                                                                       :children [{:type         :join,
                                                                                   :dispatch-key :a,
                                                                                   :key          :a,
                                                                                   :query        [(:b {:p "v"})],
                                                                                   :children     [{:type         :prop,
                                                                                                   :key          :b,
                                                                                                   :dispatch-key :b
                                                                                                   :params       {:p "v"}}]}]}}},
                 :pathim.connect.planner/index-ast             {:a {:type         :join,
                                                  :dispatch-key :a,
                                                  :key          :a,
                                                  :query        [(:b {:p "v"})],
                                                  :children     [{:type         :prop,
                                                                  :dispatch-key :b,
                                                                  :key          :b,
                                                                  :params       {:p "v"}}]}},
                 :pathim.connect.planner/index-resolver->nodes {dyn #{1}},
                 :pathim.connect.planner/index-attrs           {:a #{1}},
                 :pathim.connect.planner/user-request-shape    {:a {:b {}}}
                 :pathim.connect.planner/root                  1}))

        (is (= (compute-run-graph
                 {:pathim.connect.planner-test/dynamics  {'dyn [{:pathim.connect.operation/op-name 'a
                                      :pathim.connect.operation/output  [{:a [:b]}]}
                                     {:pathim.connect.operation/op-name 'c
                                      :pathim.connect.operation/input   [:b]
                                      :pathim.connect.operation/output  [:c]}]}
                  :pathim.eql/query [{:a [(list :c {:p "v"})]}]})
               '{:pathim.connect.planner/nodes                 {2 {:pathim.connect.operation/op-name        dyn,
                                                 :pathim.connect.planner/expects        {:a {:c {}}},
                                                 :pathim.connect.planner/input          {},
                                                 :pathim.connect.planner/node-id        2,
                                                 :pathim.connect.planner/source-op-name a,
                                                 :pathim.connect.planner/foreign-ast    {:type     :root,
                                                                       :children [{:type         :join,
                                                                                   :dispatch-key :a,
                                                                                   :key          :a,
                                                                                   :query        [(:c {:p "v"})],
                                                                                   :children     [{:type         :prop,
                                                                                                   :key          :c,
                                                                                                   :dispatch-key :c
                                                                                                   :params       {:p "v"}}]}]}}},
                 :pathim.connect.planner/index-ast             {:a {:type         :join,
                                                  :dispatch-key :a,
                                                  :key          :a,
                                                  :query        [(:c {:p "v"})],
                                                  :children     [{:type         :prop,
                                                                  :dispatch-key :c,
                                                                  :key          :c,
                                                                  :params       {:p "v"}}]}},
                 :pathim.connect.planner/index-resolver->nodes {dyn #{2}},
                 :pathim.connect.planner/user-request-shape    {:a {:c {}}}
                 :pathim.connect.planner/index-attrs           {:a #{2}},
                 :pathim.connect.planner/root                  2})))))

  (testing "optimize multiple calls"
    (is (= (compute-run-graph
             (-> {:pathim.connect.indexes/index-resolvers {'dynamic-resolver
