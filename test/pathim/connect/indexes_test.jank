(ns pathim.connect.indexes-test
  (:require
    [pathim.test.check :refer [check thrown-msg?]]
    [clojure.test :refer [deftest is testing]]
    [pathim.connect.built-in.resolvers :as pbir]
    [pathim.connect.indexes :as pci]
    [pathim.connect.operation :as pco]))

(deftest merge-oir-test
  (is (= (pci/merge-oir
           '{:a {{} #{r}}}
           '{:a {{} #{r2}}})
         '{:a {{} #{r r2}}})))

(deftest resolver-config-test
  (let [resolver (pco/resolver 'r {:pathim.connect.operation/output [:foo]}
                   (fn [_ _] {:foo 42}))
        env      (pci/register resolver)]
    (is (= (pci/resolver-config env 'r)
           '{:pathim.connect.operation/input    []
             :pathim.connect.operation/op-name  r
             :pathim.connect.operation/output   [:foo]
             :pathim.connect.operation/provides {:foo {}}
             :pathim.connect.operation/requires {}})))

  (is (= (pci/resolver-config {} 'r) nil)))

(deftest index-attributes-test
  (testing "combinations"
    (check
      (=> '{#{:b :a} {:pathim.connect.indexes/attr-id #{:b :a}, :pathim.connect.indexes/attr-provides {:c #{x}}, :pathim.connect.indexes/attr-input-in #{x}},
            :b       {:pathim.connect.indexes/attr-id :b, :pathim.connect.indexes/attr-combinations #{#{:b :a}}, :pathim.connect.indexes/attr-input-in #{x}},
            :a       {:pathim.connect.indexes/attr-id :a, :pathim.connect.indexes/attr-combinations #{#{:b :a}}, :pathim.connect.indexes/attr-input-in #{x}},
            :c       {:pathim.connect.indexes/attr-id :c, :pathim.connect.indexes/attr-reach-via {#{:b :a} #{x}}, :pathim.connect.indexes/attr-output-in #{x}}}
          (pci/index-attributes
            (-> (pco/resolver
                  {:pathim.connect.operation/op-name 'x
                   :pathim.connect.operation/input   [:a :b]
                   :pathim.connect.operation/output  [:c]})
                pco/operation-config))))

    (testing "nested"
      (testing "output"
        (is (= (pci/index-attributes
                 (-> (pco/resolver
                       {:pathim.connect.operation/op-name 'x
                        :pathim.connect.operation/input   []
                        :pathim.connect.operation/output  [{:c [:d]}]})
                     pco/operation-config))
               '{#{} {:pathim.connect.indexes/attr-id       #{},
                      :pathim.connect.indexes/attr-provides {:c #{x}},
                      :pathim.connect.indexes/attr-input-in #{x}},
                 :c  {:pathim.connect.indexes/attr-id        :c,
                      :pathim.connect.indexes/attr-reach-via {#{} #{x}},
                      :pathim.connect.indexes/attr-output-in #{x},
                      :pathim.connect.indexes/attr-branch-in #{x}},
                 :d  {:pathim.connect.indexes/attr-id      :d,
                      :pathim.connect.indexes/attr-leaf-in #{x}}})))

      (testing "input"
        (is (= (pci/index-attributes
                 (-> (pco/resolver
                       {:pathim.connect.operation/op-name 'x
                        :pathim.connect.operation/input   [{:c [:d]}]
                        :pathim.connect.operation/output  [:e]})
                     pco/operation-config))
               '{:c {:pathim.connect.indexes/attr-id :c,
                     :pathim.connect.indexes/attr-provides {:e #{x}},
                     :pathim.connect.indexes/attr-input-in #{x},
                     :pathim.connect.indexes/attr-branch-in #{x}},
                 :e {:pathim.connect.indexes/attr-id :e,
                     :pathim.connect.indexes/attr-reach-via {#{:c} #{x}},
                     :pathim.connect.indexes/attr-output-in #{x},
                     :pathim.connect.indexes/attr-leaf-in #{x}},
                 :d {:pathim.connect.indexes/attr-id :d,
                     :pathim.connect.indexes/attr-leaf-in #{x}}}))))))

(deftest register-test
  (testing "resolver"
    (let [resolver (pco/resolver 'r {:pathim.connect.operation/output [:foo]}
                     (fn [_ _] {:foo 42}))]
      (is (= (pci/register resolver)
             {:pathim.connect.indexes/index-resolvers  {'r resolver}
              :pathim.connect.indexes/index-attributes '{#{}  {:pathim.connect.indexes/attr-id #{}, :pathim.connect.indexes/attr-input-in #{r}, :pathim.connect.indexes/attr-provides {:foo #{r}}}
                                       :foo {:pathim.connect.indexes/attr-id :foo, :pathim.connect.indexes/attr-leaf-in #{r}, :pathim.connect.indexes/attr-output-in #{r}, :pathim.connect.indexes/attr-reach-via {#{} #{r}}}}
              :pathim.connect.indexes/index-io         {#{} {:foo {}}}
              :pathim.connect.indexes/index-oir        {:foo {{} #{'r}}}}))

      (testing "throw error on duplicated name"
        (is (thrown-msg? #"Tried to register duplicated resolver: r"
              (pci/register [resolver resolver])))))

    (testing "remove outputs mentioned at input, and warns"
      (is (= (-> (pco/resolver 'r {:pathim.connect.operation/input  [:id]
                                   :pathim.connect.operation/output [:id :bar]}
                   (fn [_ _]))
                 (pci/register)
                 :pathim.connect.indexes/index-oir)
             {:bar {{:id {}} #{'r}}})))

    (testing "nested inputs"
      (is (= (-> (pco/resolver 'r {:pathim.connect.operation/input  [{:users [:score]}]
                                   :pathim.connect.operation/output [:total-score]}
                   (fn [_ _]))
                 (pci/register)
                 :pathim.connect.indexes/index-oir)
             {:total-score {{:users {:score {}}} #{'r}}})))

    (testing "nested outputs"
      (is (= (-> (pco/resolver 'r {:pathim.connect.operation/output [{:item [:detail]}]} (fn [_ _]))
                 (pci/register)
                 :pathim.connect.indexes/index-io)
             {#{} {:item {:detail {}}}})))

    (testing "dynamic resolver"
      (let [resolver (pco/resolver 'r {:pathim.connect.operation/dynamic-resolver? true} (fn [_ _]))]
        (is (= (pci/register resolver)
               {:pathim.connect.indexes/index-resolvers {'r resolver}})))))

  (testing "mutation"
    (let [mutation (pco/mutation 'm {:pathim.connect.operation/output [:foo]
                                     :pathim.connect.operation/params [:bla]}
                     (fn [_ _] {:foo 42}))]
      (is (= (pci/register mutation)
             {:pathim.connect.indexes/index-mutations  {'m mutation}
              :pathim.connect.indexes/index-attributes {:bla {:pathim.connect.indexes/attr-id                :bla
                                            :pathim.connect.indexes/attr-mutation-param-in #{'m}}
                                      :foo {:pathim.connect.indexes/attr-id                 :foo
                                            :pathim.connect.indexes/attr-mutation-output-in #{'m}}}}))

      (testing "throw error on duplicated name"
        (is (thrown-msg? #"Tried to register duplicated mutation: m"
              (pci/register [mutation mutation]))))))

  (testing "multiple globals"
    (let [r1 (pco/resolver 'r {:pathim.connect.operation/output [:foo]}
               (fn [_ _] {:foo 42}))
          r2 (pco/resolver 'r2 {:pathim.connect.operation/output [:foo2]}
               (fn [_ _] {:foo2 "val"}))]
      (is (= (pci/register [r1 r2])
             {:pathim.connect.indexes/index-resolvers  {'r  r1
                                      'r2 r2}
              :pathim.connect.indexes/index-attributes '{#{}   {:pathim.connect.indexes/attr-id       #{}
                                              :pathim.connect.indexes/attr-input-in #{r
                                                                    r2}
                                              :pathim.connect.indexes/attr-provides {:foo  #{r}
                                                                   :foo2 #{r2}}}
                                       :foo  {:pathim.connect.indexes/attr-id        :foo
                                              :pathim.connect.indexes/attr-leaf-in   #{r}
                                              :pathim.connect.indexes/attr-output-in #{r}
                                              :pathim.connect.indexes/attr-reach-via {#{} #{r}}}
                                       :foo2 {:pathim.connect.indexes/attr-id        :foo2
                                              :pathim.connect.indexes/attr-leaf-in   #{r2}
                                              :pathim.connect.indexes/attr-output-in #{r2}
                                              :pathim.connect.indexes/attr-reach-via {#{} #{r2}}}}
              :pathim.connect.indexes/index-oir        {:foo  {{} #{'r}}
                                      :foo2 {{} #{'r2}}}
              :pathim.connect.indexes/index-io         {#{} {:foo  {}
                                           :foo2 {}}}}))))

  (testing "indexes meta"
    (let [r1 (pco/resolver 'r {:pathim.connect.operation/output [:foo]}
               (fn [_ _] {:foo 42}))
          r2 (pco/resolver 'r2 {:pathim.connect.operation/output [:foo2]}
               (fn [_ _] {:foo2 "val"}))
          mutation (pco/mutation 'm {:pathim.connect.operation/output [:foo]
                                     :pathim.connect.operation/params [:bla]}
                     (fn [_ _] {:foo 42}))]
      (let [idx (pci/register r1)]
        (is (= (-> idx :pathim.connect.indexes/index-resolvers meta)
               {:pathim.connect.runner/map-container?
                true}))

        (is (= (-> idx :pathim.connect.indexes/index-attributes meta)
               {:pathim.connect.runner/map-container?
                true})))

      (let [idx (pci/register [r1 r2 mutation])]
        (is (= (-> idx :pathim.connect.indexes/index-resolvers meta)
               {:pathim.connect.runner/map-container?
                true}))

        (is (= (-> idx :pathim.connect.indexes/index-attributes meta)
               {:pathim.connect.runner/map-container?
                true}))

        (is (= (-> idx :pathim.connect.indexes/index-mutations meta)
               {:pathim.connect.runner/map-container?
                true})))))

  (testing "adding indexes together"
    (let [r1       (pco/resolver 'r {:pathim.connect.operation/output [:foo]}
                     (fn [_ _] {:foo 42}))
          r2       (pco/resolver 'r2 {:pathim.connect.operation/output [:foo2]}
                     (fn [_ _] {:foo2 "val"}))
          mutation (pco/mutation 'm {:pathim.connect.operation/output [:foo]
                                     :pathim.connect.operation/params [:bla]}
                     (fn [_ _] {:foo 42}))]
      (is (= (pci/register [(pci/register r1) r2])
             {:pathim.connect.indexes/index-resolvers  {'r  r1
                                      'r2 r2}
              :pathim.connect.indexes/index-attributes '{#{}   {:pathim.connect.indexes/attr-id       #{}
                                              :pathim.connect.indexes/attr-input-in #{r
                                                                    r2}
                                              :pathim.connect.indexes/attr-provides {:foo  #{r}
                                                                   :foo2 #{r2}}}
                                       :foo  {:pathim.connect.indexes/attr-id        :foo
                                              :pathim.connect.indexes/attr-leaf-in   #{r}
                                              :pathim.connect.indexes/attr-output-in #{r}
                                              :pathim.connect.indexes/attr-reach-via {#{} #{r}}}
                                       :foo2 {:pathim.connect.indexes/attr-id        :foo2
                                              :pathim.connect.indexes/attr-leaf-in   #{r2}
                                              :pathim.connect.indexes/attr-output-in #{r2}
                                              :pathim.connect.indexes/attr-reach-via {#{} #{r2}}}}
              :pathim.connect.indexes/index-oir        {:foo  {{} #{'r}}
                                      :foo2 {{} #{'r2}}}
              :pathim.connect.indexes/index-io         {#{} {:foo  {}
                                           :foo2 {}}}}))

      (is (thrown-msg? #"Tried to register duplicated resolver: r"
            (pci/register [(pci/register r1) (pci/register r1)])))

      (is (thrown-msg? #"Tried to register duplicated mutation: m"
            (pci/register [(pci/register mutation) (pci/register mutation)]))))))

(deftest attribute-available?-test
  (let [register (pci/register (pco/resolver 'r {:pathim.connect.operation/output [:foo]} (fn [_ _] {})))]
    (is (= (pci/attribute-available? register :foo) true))
    (is (= (pci/attribute-available? register :bar) false))))

(deftest reachable-attributes-test
  (testing "all blanks"
    (is (= (pci/reachable-attributes {} {})
           #{})))

  (testing "context data is always in"
    (is (= (pci/reachable-attributes {} {:pathim.connect.indexes-test/x {}})
           #{:pathim.connect.indexes-test/x})))

  (testing "globals"
    (let [register (pci/register (pbir/constantly-resolver :pathim.connect.indexes-test/x {}))]
      (is (= (pci/reachable-attributes register {})
             #{:pathim.connect.indexes-test/x}))))

  (testing "single dependency"
    (let [register (pci/register (pbir/single-attr-resolver :pathim.connect.indexes-test/x :pathim.connect.indexes-test/y inc))]
      (is (= (pci/reachable-attributes register {:pathim.connect.indexes-test/x {}})
             #{:pathim.connect.indexes-test/x :pathim.connect.indexes-test/y}))))

  (testing "multi dependency"
    (is (= (pci/reachable-attributes
             (pci/register (pco/resolver 'xyz
                             {:pathim.connect.operation/input  [:pathim.connect.indexes-test/x :pathim.connect.indexes-test/y]
                              :pathim.connect.operation/output [:pathim.connect.indexes-test/z]}
                             (fn [_ _])))
             {:pathim.connect.indexes-test/x {}
              :pathim.connect.indexes-test/y {}})
           #{:pathim.connect.indexes-test/x :pathim.connect.indexes-test/y :pathim.connect.indexes-test/z}))

    (testing "no go"
      (let [register (pci/register (pco/resolver 'xyz
                                     {:pathim.connect.operation/input  [:pathim.connect.indexes-test/x :pathim.connect.indexes-test/y]
                                      :pathim.connect.operation/output [:pathim.connect.indexes-test/z]}
                                     (fn [_ _])))]
        (is (= (pci/reachable-attributes register {:pathim.connect.indexes-test/x {}})
               #{:pathim.connect.indexes-test/x}))))

    (testing "extended dependency"
      (let [register (pci/register
                       [(pco/resolver 'xyz
                          {:pathim.connect.operation/input  [:pathim.connect.indexes-test/x :pathim.connect.indexes-test/y]
                           :pathim.connect.operation/output [:pathim.connect.indexes-test/z]}
                          (fn [_ _]))
                        (pbir/alias-resolver :pathim.connect.indexes-test/z :pathim.connect.indexes-test/a)])]
        (is (= (pci/reachable-attributes register {:pathim.connect.indexes-test/x {}
                                                   :pathim.connect.indexes-test/y {}})
               #{:pathim.connect.indexes-test/x :pathim.connect.indexes-test/y :pathim.connect.indexes-test/z :pathim.connect.indexes-test/a})))

      (let [register (pci/register
                       [(pco/resolver 'xyz
                          {:pathim.connect.operation/input  [:pathim.connect.indexes-test/x :pathim.connect.indexes-test/y]
                           :pathim.connect.operation/output [:pathim.connect.indexes-test/z]}
                          (fn [_ _]))
                        (pbir/alias-resolver :pathim.connect.indexes-test/z :pathim.connect.indexes-test/a)
                        (pco/resolver 'axc
                          {:pathim.connect.operation/input  [:pathim.connect.indexes-test/a :pathim.connect.indexes-test/x]
                           :pathim.connect.operation/output [:pathim.connect.indexes-test/c]}
                          (fn [_ _]))])]
        (is (= (pci/reachable-attributes register {:pathim.connect.indexes-test/x {}
                                                   :pathim.connect.indexes-test/y {}})
               #{:pathim.connect.indexes-test/x :pathim.connect.indexes-test/y :pathim.connect.indexes-test/z :pathim.connect.indexes-test/a :pathim.connect.indexes-test/c}))))))

(comment
  (-> (pci/register
     (pco/resolver 'foo
       {:pathim.connect.operation/input [:a] :pathim.connect.operation/output [:a :b]}
       (fn [_ _])))
      :pathim.connect.indexes/index-io
      (get #{:a})))

(deftest reachable-paths-test
  (testing "all blanks"
    (is (= (pci/reachable-paths {} {})
           {})))

  (testing "context data is always in"
    (is (= (pci/reachable-paths {} {:pathim.connect.indexes-test/x {}})
           {:pathim.connect.indexes-test/x {}})))

  (testing "globals"
    (let [register (pci/register (pbir/constantly-resolver :pathim.connect.indexes-test/x {}))]
      (is (= (pci/reachable-paths register {})
             {:pathim.connect.indexes-test/x {}}))))

  (testing "single dependency"
    (let [register (pci/register (pbir/single-attr-resolver :pathim.connect.indexes-test/x :pathim.connect.indexes-test/y inc))]
      (is (= (pci/reachable-paths register {:pathim.connect.indexes-test/x {}})
             {:pathim.connect.indexes-test/x {} :pathim.connect.indexes-test/y {}}))))

  (testing "nested dependencies"
    (let [register (pci/register (pco/resolver 'xy
                                   {:pathim.connect.operation/output [{:pathim.connect.indexes-test/x [:pathim.connect.indexes-test/y]}]}
                                   (fn [_ _])))]
      (is (= (pci/reachable-paths register {})
             {:pathim.connect.indexes-test/x {:pathim.connect.indexes-test/y {}}})))

    (let [register (pci/register
                     [(pco/resolver 'xy
                        {:pathim.connect.operation/output [{:pathim.connect.indexes-test/x [:pathim.connect.indexes-test/y]}]}
                        (fn [_ _]))
                      (pco/resolver 'xz
                        {:pathim.connect.operation/output [{:pathim.connect.indexes-test/x [:pathim.connect.indexes-test/z]}]}
                        (fn [_ _]))])]
      (is (= (pci/reachable-paths register {})
             {:pathim.connect.indexes-test/x {:pathim.connect.indexes-test/y {} :pathim.connect.indexes-test/z {}}})))

    (is (= (pci/reachable-paths
             (pci/register
               [(pco/resolver 'x
                  {:pathim.connect.operation/output [:pathim.connect.indexes-test/x]}
                  (fn [_ _]))
                (pco/resolver 'yz
                  {:pathim.connect.operation/input  [:pathim.connect.indexes-test/x]
                   :pathim.connect.operation/output [{:pathim.connect.indexes-test/y [:pathim.connect.indexes-test/z]}]}
                  (fn [_ _]))])
             {})
           {:pathim.connect.indexes-test/x {} :pathim.connect.indexes-test/y {:pathim.connect.indexes-test/z {}}})))

  (testing "self dependency"
    (is (= (pci/reachable-paths
             (pci/register
               (pco/resolver 'foo
                 {:pathim.connect.operation/input [:a] :pathim.connect.operation/output [:a :b]}
                 (fn [_ _])))
             {:a {}})
           {:a {} :b {}})))

  (testing "multi dependency"
    (is (= (pci/reachable-paths
             (pci/register (pco/resolver 'xyz
                             {:pathim.connect.operation/input  [:pathim.connect.indexes-test/x :pathim.connect.indexes-test/y]
                              :pathim.connect.operation/output [:pathim.connect.indexes-test/z]}
                             (fn [_ _])))
             {:pathim.connect.indexes-test/x {}
              :pathim.connect.indexes-test/y {}})
           {:pathim.connect.indexes-test/x {} :pathim.connect.indexes-test/y {} :pathim.connect.indexes-test/z {}}))

    (testing "no go"
      (let [register (pci/register (pco/resolver 'xyz
                                     {:pathim.connect.operation/input  [:pathim.connect.indexes-test/x :pathim.connect.indexes-test/y]
                                      :pathim.connect.operation/output [:pathim.connect.indexes-test/z]}
                                     (fn [_ _])))]
        (is (= (pci/reachable-paths register {:pathim.connect.indexes-test/x {}})
               {:pathim.connect.indexes-test/x {}}))))

    (testing "extended dependency"
      (let [register (pci/register
                       [(pco/resolver 'xyz
                          {:pathim.connect.operation/input  [:pathim.connect.indexes-test/x :pathim.connect.indexes-test/y]
                           :pathim.connect.operation/output [:pathim.connect.indexes-test/z]}
                          (fn [_ _]))
                        (pbir/alias-resolver :pathim.connect.indexes-test/z :pathim.connect.indexes-test/a)])]
        (is (= (pci/reachable-paths register {:pathim.connect.indexes-test/x {}
                                              :pathim.connect.indexes-test/y {}})
               {:pathim.connect.indexes-test/x {} :pathim.connect.indexes-test/y {} :pathim.connect.indexes-test/z {} :pathim.connect.indexes-test/a {}})))

      (let [register (pci/register
                       [(pco/resolver 'xyz
                          {:pathim.connect.operation/input  [:pathim.connect.indexes-test/x :pathim.connect.indexes-test/y]
                           :pathim.connect.operation/output [:pathim.connect.indexes-test/z]}
                          (fn [_ _]))
                        (pbir/alias-resolver :pathim.connect.indexes-test/z :pathim.connect.indexes-test/a)
                        (pco/resolver 'axc
                          {:pathim.connect.operation/input  [:pathim.connect.indexes-test/a :pathim.connect.indexes-test/x]
                           :pathim.connect.operation/output [:pathim.connect.indexes-test/c]}
                          (fn [_ _]))])]
        (is (= (pci/reachable-paths register {:pathim.connect.indexes-test/x {}
                                              :pathim.connect.indexes-test/y {}})
               {:pathim.connect.indexes-test/x {} :pathim.connect.indexes-test/y {} :pathim.connect.indexes-test/z {} :pathim.connect.indexes-test/a {} :pathim.connect.indexes-test/c {}}))))))

(deftest attribute-reachable?-test
  (let [register (pci/register
                   [(pco/resolver 'xyz
                      {:pathim.connect.operation/input  [:pathim.connect.indexes-test/x :pathim.connect.indexes-test/y]
                       :pathim.connect.operation/output [:pathim.connect.indexes-test/z]}
                      (fn [_ _]))
                    (pbir/alias-resolver :pathim.connect.indexes-test/z :pathim.connect.indexes-test/a)
                    (pco/resolver 'axc
                      {:pathim.connect.operation/input  [:pathim.connect.indexes-test/a :pathim.connect.indexes-test/x]
                       :pathim.connect.operation/output [:pathim.connect.indexes-test/c]}
                      (fn [_ _]))])]
    (is (= (pci/attribute-reachable? register {:pathim.connect.indexes-test/x {}
                                               :pathim.connect.indexes-test/y {}}
                                     :pathim.connect.indexes-test/c)
           true))

    (is (= (pci/attribute-reachable? register {:pathim.connect.indexes-test/x {}
                                               :pathim.connect.indexes-test/y {}}
                                     :pathim.connect.indexes-test/d)
           false))))

(deftest input-set-test
  (is (= (pci/input-set [])
         #{}))

  (is (= (pci/input-set [:foo])
         #{:foo}))

  (is (= (pci/input-set [:foo :bar])
         #{:foo :bar}))

  (is (= (pci/input-set [{:foo [:baz]} :bar])
         #{{:foo #{:baz}} :bar})))
