(ns pathim.connect.operation-test
  (:require
    [clojure.test :refer [deftest is are run-tests testing]]
    [pathim.connect.built-in.resolvers :as pbir]
    [pathim.connect.operation :as pco]
    [pathim.connect.operation.protocols :as pop]
    [pathim.connect.operation.protocols :as pop]
    [pathim.format.shape-descriptor :as pfsd]
    [pathim.test.helpers :as h]))

(deftest resolver-test
  (testing "creating resolvers"
    (let [resolver (pco/resolver 'foo {:pathim.connect.operation/output [:foo]} (fn [_ _] {:foo "bar"}))]
      (is (= (pop/-op-resolve resolver {} {})
             {:foo "bar"}))

      (is (= (pco/operation-config resolver)
             {:pathim.connect.operation/op-name  'foo
              :pathim.connect.operation/input    []
              :pathim.connect.operation/provides {:foo {}}
              :pathim.connect.operation/requires {}
              :pathim.connect.operation/output   [:foo]})))

    (let [resolver (pco/resolver 'foo {:pathim.connect.operation/input [:required] :pathim.connect.operation/output [:foo]} (fn [_ _] {:foo "bar"}))]
      (is (= (pop/-op-resolve resolver {} {})
             {:foo "bar"}))

      (is (= (pco/operation-config resolver)
             {:pathim.connect.operation/op-name  'foo
              :pathim.connect.operation/input    [:required]
              :pathim.connect.operation/provides {:foo {}}
              :pathim.connect.operation/requires {:required {}}
              :pathim.connect.operation/output   [:foo]}))))

  (testing "creating resolver from pure maps"
    (let [resolver (pco/resolver {:pathim.connect.operation/op-name 'foo
                                  :pathim.connect.operation/output  [:foo]
                                  :pathim.connect.operation/resolve (fn [_ _] "bar")})]
      (is (= (pop/-op-resolve resolver nil nil)
             "bar"))

      (is (= (pco/operation-config resolver)
             {:pathim.connect.operation/op-name  'foo
              :pathim.connect.operation/output   [:foo]
              :pathim.connect.operation/input    []
              :pathim.connect.operation/provides {:foo {}}
              :pathim.connect.operation/requires {}}))))

  (testing "validates configuration map"
    (try
      (pco/resolver 'foo {:pathim.connect.operation/input #{:invalid}} (fn [_ _] {:sample "bar"}))
      (catch cpp/jank.runtime.object_ref e
        (is (= (ex-message e) "Invalid config on resolver foo"))
        (is (= (-> e
                   (ex-data)
                   (update :explain-data dissoc :clojure.spec.alpha/spec :clojure.spec.alpha/value))
               {:explain-data {:clojure.spec.alpha/problems [{:in   [:pathim.connect.operation/input]
                                                                     :path [:pathim.connect.operation/input]
                                                                     :pred 'clojure.core/vector?
                                                                     :val  #{:invalid}
                                                                     :via  [:pathim.connect.operation/input]}]}})))))

  (testing "name config overrides syntax name"
    (let [resolver (pco/resolver 'foo {:pathim.connect.operation/op-name 'bar
                                       :pathim.connect.operation/resolve (fn [_ _] {})}
                     (fn [_ _] {:foo "bar"}))]
      (is (= (pco/operation-config resolver)
             {:pathim.connect.operation/op-name 'bar}))))

  (testing "dynamic resolver"
    (let [resolver (pco/resolver {:pathim.connect.operation/op-name           'foo
                                  :pathim.connect.operation/dynamic-resolver? true
                                  :pathim.connect.operation/resolve           (fn [_ _] "bar")})]

      (is (= (pco/operation-config resolver)
             {:pathim.connect.operation/op-name           'foo
              :pathim.connect.operation/dynamic-resolver? true}))))

  (testing "transform"
    (let [resolver (pco/resolver 'foo {:pathim.connect.operation/output    [:foo]
                                       :pathim.connect.operation/transform (fn [config]
                                                         (assoc config :pathim.connect.operation-test/other "bar"))}
                     (fn [_ _] {:foo "bar"}))]
      (is (= (pco/operation-config resolver)
             {:pathim.connect.operation/op-name  'foo
              :pathim.connect.operation-test/other        "bar"
              :pathim.connect.operation/output   [:foo]
              :pathim.connect.operation/input    []
              :pathim.connect.operation/provides {:foo {}}
              :pathim.connect.operation/requires {}}))))

  (testing "defining optional inputs"
    (let [resolver (pco/resolver 'foo
                     {:pathim.connect.operation/input  [:x (pco/? :y)]
                      :pathim.connect.operation/output [:foo]}
                     (fn [_ _] {:foo "bar"}))]
      (is (= (pco/operation-config resolver)
             {:pathim.connect.operation/op-name   'foo
              :pathim.connect.operation/output    [:foo]
              :pathim.connect.operation/input     [:x (pco/? :y)]
              :pathim.connect.operation/provides  {:foo {}}
              :pathim.connect.operation/requires  {:x {}}
              :pathim.connect.operation/optionals {:y {}}}))))

  (testing "noop when called with a resolver"
    (let [resolver (-> {:pathim.connect.operation/op-name 'foo
                        :pathim.connect.operation/output  [:foo]
                        :pathim.connect.operation/resolve (fn [_ _] "bar")}
                       (pco/resolver)
                       (pco/resolver)
                       (pco/resolver))]
      (is (= (pop/-op-resolve resolver nil nil)
             "bar"))

      (is (= (pco/operation-config resolver)
             {:pathim.connect.operation/op-name  'foo
              :pathim.connect.operation/output   [:foo]
              :pathim.connect.operation/input    []
              :pathim.connect.operation/provides {:foo {}}
              :pathim.connect.operation/requires {}})))))

(deftest mutation-test
  (testing "creating mutations"
    (let [mutation (pco/mutation 'foo {:pathim.connect.operation/output [:foo]} (fn [_ _] {:foo "bar"}))]
      (is (= (pop/-op-mutate mutation {} {})
             {:foo "bar"}))

      (is (= (pco/operation-config mutation)
             {:pathim.connect.operation/op-name  'foo
              :pathim.connect.operation/provides {:foo {}}
              :pathim.connect.operation/output   [:foo]}))))

  (testing "creating mutation from pure maps"
    (let [mutation (pco/mutation {:pathim.connect.operation/op-name 'foo
                                  :pathim.connect.operation/output  [:foo]
                                  :pathim.connect.operation/mutate  (fn [_ _] {:foo "bar"})})]
      (is (= (pop/-op-mutate mutation nil nil)
             {:foo "bar"}))

      (is (= (pco/operation-config mutation)
             {:pathim.connect.operation/op-name  'foo
              :pathim.connect.operation/output   [:foo]
              :pathim.connect.operation/provides {:foo {}}}))))

  (testing "validates configuration map"
    (try
      (pco/mutation 'foo {:pathim.connect.operation/input #{:invalid}} (fn [_ _] {:sample "bar"}))
      (catch cpp/jank.runtime.object_ref e
        (is (= (ex-message e) "Invalid config on mutation foo"))
        (is (= (-> e
                   (ex-data)
                   (update :explain-data dissoc :clojure.spec.alpha/spec :clojure.spec.alpha/value))
               {:explain-data {:clojure.spec.alpha/problems [{:in   [:pathim.connect.operation/input]
                                                                     :path [:pathim.connect.operation/input]
                                                                     :pred 'clojure.core/vector?
                                                                     :val  #{:invalid}
                                                                     :via  [:pathim.connect.operation/input]}]}})))))

  (testing "name config overrides syntax name"
    (let [mutation (pco/mutation 'foo {:pathim.connect.operation/op-name 'bar
                                       :pathim.connect.operation/mutate  (fn [_ _] {})}
                     (fn [_ _] {:foo "bar"}))]
      (is (= (pco/operation-config mutation)
             {:pathim.connect.operation/op-name 'bar}))))

  (testing "transform"
    (let [mutation (pco/mutation 'foo {:pathim.connect.operation/output    [:foo]
                                       :pathim.connect.operation/transform (fn [config]
                                                         (assoc config :pathim.connect.operation-test/other "bar"))}
                     (fn [_ _] {:foo "bar"}))]
      (is (= (pco/operation-config mutation)
             {:pathim.connect.operation/op-name  'foo
              :pathim.connect.operation-test/other        "bar"
              :pathim.connect.operation/output   [:foo]
              :pathim.connect.operation/provides {:foo {}}}))))

  (testing "noop when called with a mutation"
    (let [mutation (-> {:pathim.connect.operation/op-name 'foo
                        :pathim.connect.operation/output  [:foo]
                        :pathim.connect.operation/mutate  (fn [_ _] {:data "bar"})}
                       (pco/mutation)
                       (pco/mutation)
                       (pco/mutation))]
      (is (= (pop/-op-mutate mutation nil nil)
             {:data "bar"}))

      (is (= (pco/operation-config mutation)
             {:pathim.connect.operation/op-name  'foo
              :pathim.connect.operation/output   [:foo]
              :pathim.connect.operation/provides {:foo {}}})))))

(defn- conform-defresolver-args
  "pco/conform-defresolver-args, with the keys spec would have omitted removed."
  [args]
  (into {} (remove (fn [entry] (nil? (second entry)))) (pco/conform-defresolver-args args)))

(deftest defresolver-args-must-declare-output-test
  ;; Upstream asserts on spec's explain-data here. This port raises instead; what the test
  ;; is really checking -- that a resolver with neither options nor a trailing map is
  ;; rejected -- holds either way.
  (is (= :rejected
         (try (pco/conform-defresolver-args '[foo [env input] "bar"])
              :not-rejected
              (catch cpp/jank.runtime.object_ref _ :rejected)))))

(defn- normalize-op-name
  "Rewrites (quote some.ns/foo) to (quote user/foo) anywhere in a form."
  [form]
  (cond
    (and (seq? form) (= 'quote (first form)) (symbol? (second form)) (namespace (second form)))
    (list 'quote (symbol "user" (name (second form))))

    ;; the lambda is not redundant: jank's compiler crashes on a function handing itself
    ;; to another function from inside its own body
    (seq? form) (apply list (map (fn [x] (normalize-op-name x)) form))
    (vector? form) (mapv (fn [x] (normalize-op-name x)) form)
    (map? form) (into {} (map (fn [e] [(normalize-op-name (key e)) (normalize-op-name (val e))])) form)
    :else form))

(defn- conform-defresolver-args
  "pco/conform-defresolver-args, with the keys spec would have omitted removed."
  [args]
  (into {} (remove (fn [entry] (nil? (second entry)))) (pco/conform-defresolver-args args)))

(deftest defresolver-args-must-declare-output-test
  ;; Upstream asserts on spec's explain-data here. This port raises instead; what the test
  ;; is really checking -- that a resolver with neither options nor a trailing map is
  ;; rejected -- holds either way.
  (is (= :rejected
         (try (pco/conform-defresolver-args '[foo [env input] "bar"])
              :not-rejected
              (catch cpp/jank.runtime.object_ref _ :rejected)))))

(defn- normalize-op-name
  "Rewrites (quote some.ns/foo) to (quote user/foo) anywhere in a form."
  [form]
  (cond
    (and (seq? form) (= 'quote (first form)) (symbol? (second form)) (namespace (second form)))
    (list 'quote (symbol "user" (name (second form))))

    ;; the lambda is not redundant: jank's compiler crashes on a function handing itself
    ;; to another function from inside its own body
    (seq? form) (apply list (map (fn [x] (normalize-op-name x)) form))
    (vector? form) (mapv (fn [x] (normalize-op-name x)) form)
    (map? form) (into {} (map (fn [e] [(normalize-op-name (key e)) (normalize-op-name (val e))])) form)
    :else form))

(deftest defresolver-syntax-test
     (testing "classic form"
       (is (= (conform-defresolver-args '[foo [env input]
                                                  {:pathim.connect.operation/output [:foo]}
                                                  {:foo "bar"}])
              '{:name    foo
                :arglist [[:sym env] [:sym input]]
                :options {:pathim.connect.operation/output [:foo]}
                :body    [{:foo "bar"}]})))

     (testing "docstring"
       (is (= (conform-defresolver-args '[foo "doc here" [env input]
                                                  {:pathim.connect.operation/output [:foo]}
                                                  {:foo "bar"}])
              '{:name      foo
                :docstring "doc here"
                :arglist   [[:sym env] [:sym input]]
                :options   {:pathim.connect.operation/output [:foo]}
                :body      [{:foo "bar"}]})))

     (testing "visible output shape"
       (is (= (conform-defresolver-args '[foo [env input] {:foo "bar"}])
              '{:name    foo
                :arglist [[:sym env] [:sym input]]
                :body    [{:foo "bar"}]}))))

(deftest extract-destructure-map-keys-as-keywords-test
  (is (= (pco/extract-destructure-map-keys-as-keywords
           '{:keys [foo]})
         [:foo]))

  (is (= (pco/extract-destructure-map-keys-as-keywords
           '{:keys [:foo]})
         [:foo]))

  (is (= (pco/extract-destructure-map-keys-as-keywords
           '{:keys [:foo/bar]})
         [:foo/bar]))

  (is (= (pco/extract-destructure-map-keys-as-keywords
           '{:keys      [foo]
             :user/keys [id name]
             :as        user})
         [:foo :user/id :user/name]))

  (testing "optionals"
    (is (= (pco/extract-destructure-map-keys-as-keywords
             '{:keys [foo]
               :or   {foo "bar"}})
           [`(list :foo {:pathim.connect.operation/optional? true})]))

    (testing "namespaced key"
      (is (= (pco/extract-destructure-map-keys-as-keywords
               '{:some/keys [foo]
                 :or        {foo "bar"}})
             [`(list :some/foo {:pathim.connect.operation/optional? true})])))

    (testing "namespaced symbol"
      (is (= (pco/extract-destructure-map-keys-as-keywords
               '{:keys [some/foo]
                 :or   {foo "bar"}})
             [`(list :some/foo {:pathim.connect.operation/optional? true})])))

    (testing "symbol application"
      (is (= (pco/extract-destructure-map-keys-as-keywords
               '{sym :some/foo
                 :or {sym "bar"}})
             [`(list :some/foo {:pathim.connect.operation/optional? true})]))))

  (is (= (pco/extract-destructure-map-keys-as-keywords
           '{renamed :foo})
         [:foo]))

  (is (= (pco/extract-destructure-map-keys-as-keywords
           '{{deep :value} :foo})
         [:foo]))

  (is (= (pco/extract-destructure-map-keys-as-keywords
           '{{:keys [value]} :foo})
         [:foo])))

(deftest params->resolver-options-test
  (testing "classic case"
    (is (= (pco/params->resolver-options
             '{:name    foo
               :arglist [[:name env] [:name input]]
               :options {:pathim.connect.operation/output [:foo]}
               :body    [{:foo "bar"}]})
           {:pathim.connect.operation/output [:foo]})))

  (testing "inferred input"
    (is (= (pco/params->resolver-options
             '{:name    foo
               :arglist [[:sym env] [:map {:keys [dep]}]]
               :body    [{:foo "bar"}]})
           {:pathim.connect.operation/inferred-input [:dep]
            :pathim.connect.operation/output         [:foo]}))

    (testing "preserve user input when defined"
      (is (= (pco/params->resolver-options
               '{:name    foo
                 :arglist [[:sym env] [:map {:keys [dep]}]]
                 :options {:pathim.connect.operation/input [:dep :other]}
                 :body    [{:foo "bar"}]})
             {:pathim.connect.operation/inferred-input [:dep]
              :pathim.connect.operation/input          [:dep :other]
              :pathim.connect.operation/output         [:foo]}))))

  (testing "implicit output"
    (is (= (pco/params->resolver-options
             '{:name    foo
               :arglist [[:sym env] [:sym input]]
               :body    [nil {:foo "bar"}]})
           {:pathim.connect.operation/output [:foo]}))

    (testing "nested body"
      (is (= (pco/params->resolver-options
               '{:name    foo
                 :arglist [[:sym env] [:sym input]]
                 :body    [{:foo  "bar"
                            :buz  "baz"
                            :deep {:nested (call-something)}
                            :seq  [{:with "things"} {:around "here "}]}]})
             {:pathim.connect.operation/output [:buz
                            {:deep [:nested]}
                            :foo
                            {:seq [:with :around]}]})))

    (testing "preserve user output when defined"
      (is (= (pco/params->resolver-options
               '{:name    foo
                 :arglist [[:sym env] [:sym input]]
                 :options {:pathim.connect.operation/output [:foo :bar]}
                 :body    [{:foo "bar"}]})
             {:pathim.connect.operation/output [:foo :bar]})))))

(deftest params->mutation-options-test
  (testing "classic case"
    (is (= (pco/params->mutation-options
             '{:name    foo
               :arglist [[:name env] [:name input]]
               :options {:pathim.connect.operation/output [:foo]}
               :body    [{:foo "bar"}]})
           {:pathim.connect.operation/output [:foo]})))

  (testing "inferred params"
    (is (= (pco/params->mutation-options
             '{:name    foo
               :arglist [[:sym env] [:map {:keys [dep]}]]
               :body    [{:foo "bar"}]})
           {:pathim.connect.operation/inferred-params [:dep]
            :pathim.connect.operation/output          [:foo]}))

    (testing "preserve user params when defined, and merges with inferred"
      (is (= (pco/params->mutation-options
               '{:name    foo
                 :arglist [[:sym env] [:map {:keys [dep more]}]]
                 :options {:pathim.connect.operation/params [:dep :other]}
                 :body    [{:foo "bar"}]})
             {:pathim.connect.operation/params          [:dep :other]
              :pathim.connect.operation/inferred-params [:dep :more]
              :pathim.connect.operation/output          [:foo]}))))

  (testing "implicit output"
    (is (= (pco/params->mutation-options
             '{:name    foo
               :arglist [[:sym env] [:sym params]]
               :body    [nil {:foo "bar"}]})
           {:pathim.connect.operation/output [:foo]}))

    (testing "nested body"
      (is (= (pco/params->mutation-options
               '{:name    foo
                 :arglist [[:sym env] [:sym params]]
                 :body    [{:foo  "bar"
                            :buz  "baz"
                            :deep {:nested (call-something)}
                            :seq  [{:with "things"} {:around "here "}]}]})
             {:pathim.connect.operation/output [:buz
                            {:deep [:nested]}
                            :foo
                            {:seq [:with :around]}]})))

    (testing "preserve user output when defined"
      (is (= (pco/params->mutation-options
               '{:name    foo
                 :arglist [[:sym env] [:sym params]]
                 :options {:pathim.connect.operation/output [:foo :bar]}
                 :body    [{:foo "bar"}]})
             {:pathim.connect.operation/output [:foo :bar]})))))

(deftest normalize-arglist-test
  (is (= (pco/normalize-arglist [])
         '[[:sym _] [:sym _]]))

  (is (= (pco/normalize-arglist '[[:sym input]])
         '[[:sym _] [:sym input]]))

  (is (= (pco/normalize-arglist '[[:sym env] [:sym input]])
         '[[:sym env] [:sym input]])))

(deftest defresolver-test
     (testing "docstring"
       (is (= (normalize-op-name (macroexpand-1
                `(pco/defresolver ~'foo "documentation" ~'[] {:sample "bar"})))
              '(def foo
                 "documentation"
                 (pathim.connect.operation/resolver
                   'user/foo
                   {:pathim.connect.operation/docstring "documentation", :pathim.connect.operation/output [:sample]}
                   (clojure.core/fn foo [_ _] {:sample "bar"}))))))

     (testing "validates configuration map"
       (try
         (normalize-op-name (macroexpand-1
           `(pco/defresolver ~'foo ~'[] {:pathim.connect.operation/input #{:invalid}} {:sample "bar"})))
         (catch cpp/jank.runtime.object_ref e
           (is (= (-> (ex-cause e)
                      (ex-data)
                      (update :explain-data dissoc :clojure.spec.alpha/spec))
                  {:explain-data {:clojure.spec.alpha/problems [{:in [:pathim.connect.operation/input], :path [:pathim.connect.operation/input], :pred (quote clojure.core/vector?), :val #{:invalid}, :via [:pathim.connect.operation/input]}], :clojure.spec.alpha/value {:pathim.connect.operation/input #{:invalid}}}})))))

     (testing "implicit output resolver, no args capture"
       (is (= (normalize-op-name (macroexpand-1
                `(pco/defresolver ~'foo ~'[] {:sample "bar"})))
              '(def foo
                 (pathim.connect.operation/resolver
                   'user/foo
                   {:pathim.connect.operation/output [:sample]}
                   (clojure.core/fn foo [_ _] {:sample "bar"}))))))

     (testing "explicit output, no args"
       (is (= (normalize-op-name (macroexpand-1
                `(pco/defresolver ~'foo ~'[] {:pathim.connect.operation/output [:foo]} {:foo "bar"})))
              '(def foo
                 (pathim.connect.operation/resolver
                   'user/foo
                   {:pathim.connect.operation/output [:foo]}
                   (clojure.core/fn foo [_ _] {:foo "bar"}))))))

     (testing "implicit output, including implicit inputs via destructuring"
       (is (= (normalize-op-name (macroexpand-1
                `(pco/defresolver ~'foo ~'[{:keys [dep]}] {:sample "bar"})))
              '(def foo
                 (pathim.connect.operation/resolver
                   'user/foo
                   {:pathim.connect.operation/output [:sample], :pathim.connect.operation/inferred-input [:dep]}
                   (clojure.core/fn foo [_ {:keys [dep]}] {:sample "bar"}))))))

     (testing "implicit output, including implicit inputs via destructuring with optional"
       (is (= (normalize-op-name (macroexpand-1
                `(pco/defresolver ~'foo ~'[{:keys [dep] :or {dep 1}}] {:sample "bar"})))
              '(def foo
                 (pathim.connect.operation/resolver
                   'user/foo
                   {:pathim.connect.operation/output [:sample],
                    :pathim.connect.operation/inferred-input [(clojure.core/list
                                                                             :dep
                                                                             {:pathim.connect.operation/optional? true})],}
                   (clojure.core/fn foo [_ {:keys [dep], :or {dep 1}}] {:sample "bar"}))))))

     (testing "implicit output, including implicit inputs via destructuring"
       (is (= (normalize-op-name (macroexpand-1
                `(pco/defresolver ~'foo ~'[{:keys [dep]}] {:pathim.connect.operation/output [{:sample [:thing]}]} {:sample "bar"})))
              '(def foo
                 (pathim.connect.operation/resolver
                   'user/foo
                   {:pathim.connect.operation/output [{:sample [:thing]}], :pathim.connect.operation/inferred-input [:dep]}
                   (clojure.core/fn foo [_ {:keys [dep]}] {:sample "bar"}))))))

     (testing "explicit input"
       (is (= (normalize-op-name (macroexpand-1
                `(pco/defresolver ~'foo ~'[input] {:pathim.connect.operation/input [:foo]} {:bar "baz"})))
              '(def foo
                 (pathim.connect.operation/resolver
                   'user/foo
                   {:pathim.connect.operation/output [:bar], :pathim.connect.operation/input [:foo]}
                   (clojure.core/fn foo [_ input] {:bar "baz"}))))))

     (testing "explicit input merges with implicit input"
       (is (= (normalize-op-name (macroexpand-1
                `(pco/defresolver ~'foo ~'[{:keys [foo bar]}] {:pathim.connect.operation/input [{:foo [:sub]}]} {:bar "baz"})))
              '(def foo
                 (pathim.connect.operation/resolver
                   'user/foo
                   {:pathim.connect.operation/input          [{:foo [:sub]}],
                    :pathim.connect.operation/inferred-input [:foo :bar],
                    :pathim.connect.operation/output         [:bar]}
                   (clojure.core/fn foo [_ {:keys [foo bar]}] {:bar "baz"}))))))

     (testing "recursive nested inputs"
       (is (= (normalize-op-name (macroexpand-1
                `(pco/defresolver ~'foo ~'[input] {:pathim.connect.operation/input [:foo {:bar ~'...}]} {:bar "baz"})))
              '(def foo
                 (pathim.connect.operation/resolver
                   'user/foo
                   {:pathim.connect.operation/output [:bar], :pathim.connect.operation/input [:foo {:bar ...}]}
                   (clojure.core/fn foo [_ input] {:bar "baz"}))))))

     (testing "unform options to retain data"
       (is (= (normalize-op-name (macroexpand-1
                `(pco/defresolver ~'foo ~'[] {:pathim.connect.operation-test/or-thing 3} {:sample "bar"})))
              '(def foo
                 (pathim.connect.operation/resolver
                   'user/foo
                   {:pathim.connect.operation/output [:sample]
                    :pathim.connect.operation-test/or-thing   3}
                   (clojure.core/fn foo [_ _] {:sample "bar"})))))))

(deftest defmutation-test
     (testing "docstring"
       (is (= (normalize-op-name (macroexpand-1
                `(pco/defmutation ~'foo "documentation" ~'[] {:sample "bar"})))
              '(def foo
                 "documentation"
                 (pathim.connect.operation/mutation
                   'user/foo
                   {:pathim.connect.operation/docstring "documentation", :pathim.connect.operation/output [:sample]}
                   (clojure.core/fn foo [_ _] {:sample "bar"}))))))

     (testing "implicit output resolver, no args capture"
       (is (= (normalize-op-name (macroexpand-1
                `(pco/defmutation ~'foo ~'[] {:sample "bar"})))
              '(def foo
                 (pathim.connect.operation/mutation
                   'user/foo
                   {:pathim.connect.operation/output [:sample]}
                   (clojure.core/fn foo [_ _] {:sample "bar"}))))))

     (testing "explicit output, no args"
       (is (= (normalize-op-name (macroexpand-1
                `(pco/defmutation ~'foo ~'[] {:pathim.connect.operation/output [:foo]} {:foo "bar"})))
              '(def foo
                 (pathim.connect.operation/mutation
                   'user/foo
                   {:pathim.connect.operation/output [:foo]}
                   (clojure.core/fn foo [_ _] {:foo "bar"}))))))

     (testing "implicit output, including implicit params via destructuring"
       (is (= (normalize-op-name (macroexpand-1
                `(pco/defmutation ~'foo ~'[{:keys [dep]}] {:sample "bar"})))
              '(def foo
                 (pathim.connect.operation/mutation
                   'user/foo
                   {:pathim.connect.operation/output [:sample], :pathim.connect.operation/inferred-params [:dep]}
                   (clojure.core/fn foo [_ {:keys [dep]}] {:sample "bar"}))))))

     (testing "implicit output, including implicit params via destructuring with optional"
       (is (= (normalize-op-name (macroexpand-1
                `(pco/defmutation ~'foo ~'[{:keys [dep] :or {dep true}}] {:sample "bar"})))
              '(def foo
                 (pathim.connect.operation/mutation
                   'user/foo
                   {:pathim.connect.operation/output [:sample], :pathim.connect.operation/inferred-params [(clojure.core/list :dep {:pathim.connect.operation/optional? true})]}
                   (clojure.core/fn foo [_ {:keys [dep] :or {dep true}}] {:sample "bar"}))))))

     (testing "implicit output, including implicit params via destructuring"
       (is (= (normalize-op-name (macroexpand-1
                `(pco/defmutation ~'foo ~'[{:keys [dep]}] {:pathim.connect.operation/output [{:sample [:thing]}]} {:sample "bar"})))
              '(def foo
                 (pathim.connect.operation/mutation
                   'user/foo
                   {:pathim.connect.operation/output [{:sample [:thing]}], :pathim.connect.operation/inferred-params [:dep]}
                   (clojure.core/fn foo [_ {:keys [dep]}] {:sample "bar"}))))))

     (testing "unform options to retain data"
       (is (= (normalize-op-name (macroexpand-1
                `(pco/defmutation ~'foo ~'[] {:pathim.connect.operation-test/or-thing 3} {:sample "bar"})))
              '(def foo
                 (pathim.connect.operation/mutation
                   'user/foo
                   {:pathim.connect.operation/output [:sample]
                    :pathim.connect.operation-test/or-thing   3}
                   (clojure.core/fn foo [_ _] {:sample "bar"})))))))

(deftest with-node-params-test
  (is (= (pco/with-node-params {:foo "bar"})
         {:pathim.connect.planner/node
          {:pathim.connect.planner/params
           {:foo "bar"}}}))

  (is (= (pco/with-node-params {:env "data"} {:foo "bar"})
         {:env
          "data"
          :pathim.connect.planner/node
          {:pathim.connect.planner/params
           {:foo "bar"}}})))

(deftest params-test
  (is (= (pco/params {})
         {}))
  (is (= (pco/params (pco/with-node-params {:foo "bar"}))
         {:foo "bar"})))

(deftest update-config-test
  (is (= (-> (pbir/constantly-resolver :foo "bar")
             (pco/update-config assoc :extra "data")
             (pco/operation-config))
         '{:pathim.connect.operation/input    [],
           :pathim.connect.operation/provides {:foo {}},
           :pathim.connect.operation/requires {}
           :pathim.connect.operation/output   [:foo],
           :pathim.connect.operation/cache?   false,
           :pathim.connect.operation/op-name  -unqualified/foo--const,
           :extra         "data"})))

(defn describe-input [input]
  (h/expose-meta (pco/describe-input input)))

(deftest describe-input-test
  (is (= (describe-input [])
         {:pathim.connect.operation/requires {}}))

  (is (= (describe-input [:foo])
         {:pathim.connect.operation/requires {:foo {}}}))

  (is (= (describe-input [:foo (pco/? :bar)])
         {:pathim.connect.operation/requires  {:foo {}}
          :pathim.connect.operation/optionals {:bar {:pathim.test.helpers/meta {:pathim.format.shape-descriptor/params {:pathim.connect.operation/optional? true}}}}}))

  (is (= (describe-input [:foo {:baz [:x (pco/? :y)]}])
         {:pathim.connect.operation/requires  {:foo {}
                           :baz {:x {}}}
          :pathim.connect.operation/optionals {:baz {:y {:pathim.test.helpers/meta {:pathim.format.shape-descriptor/params {:pathim.connect.operation/optional? true}}}}}}))

  (is (= (describe-input [:foo {(pco/? :baz) [:x :y]}])
         {:pathim.connect.operation/requires  {:foo {}}
          :pathim.connect.operation/optionals {:baz {:x {} :y {}
                                 :pathim.test.helpers/meta {:pathim.format.shape-descriptor/params {:pathim.connect.operation/optional? true}}}}})))

(deftest final-value-test
  (is (pco/final-value?
        (pco/final-value {})))

  (is (not (pco/final-value? {}))))
