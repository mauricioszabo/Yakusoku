(ns pathim.connect.built-in.resolvers-test
  (:require
    [clojure.test :refer [deftest is are run-tests testing]]
    [pathim.connect.built-in.resolvers :as pbir]
    [pathim.connect.indexes :as pci]
    [pathim.connect.operation :as pco]
    [pathim.connect.operation.protocols :as pop]
    ))

(deftest alias-resolver-test
  (is (= ((pbir/alias-resolver :foo :bar) {} {:foo 3})
         {:bar 3})))

(deftest constantly-resolver-test
  (is (= ((pbir/constantly-resolver :foo "bar"))
         {:foo "bar"}))

  (testing "output inference"
    (is (= (-> (pco/operation-config (pbir/constantly-resolver :foo {:bar "baz"}))
               :pathim.connect.operation/output)
           [{:foo [:bar]}]))

    (is (= (-> (pco/operation-config (pbir/constantly-resolver :foo [{:bar "baz"}
                                                                     {:other "ble"}]))
               :pathim.connect.operation/output)
           [{:foo [:bar :other]}]))))

(deftest constantly-fn-resolver-test
  (is (= ((pbir/constantly-fn-resolver :foo (fn [_] "bar")))
         {:foo "bar"})))

(deftest single-attr-resolver-test
  (is (= ((pbir/single-attr-resolver :n :x inc) {:n 10})
         {:x 11})))

(deftest single-attr-with-env-resolver-test
  (is (= ((pbir/single-attr-with-env-resolver :n :x #(+ (:add %1) %2))
          {:add 5}
          {:n 10})
         {:x 15})))

(deftest map-table-resolver-test
  (let [resolver (pbir/static-table-resolver :pathim.connect.built-in.resolvers-test/id {1 {:pathim.connect.built-in.resolvers-test/color "Gray"}
                                                   2 {:pathim.connect.built-in.resolvers-test/color "Purple"}})
        config   (pco/operation-config resolver)]
    (is (= (resolver {:pathim.connect.built-in.resolvers-test/id 2})
           {:pathim.connect.built-in.resolvers-test/color "Purple"}))
    (is (= (resolver {:pathim.connect.built-in.resolvers-test/id 3}) nil))
    (is (= (:pathim.connect.operation/input config)
           [:pathim.connect.built-in.resolvers-test/id]))
    (is (= (:pathim.connect.operation/output config)
           [:pathim.connect.built-in.resolvers-test/color]))))

(deftest attribute-map-resolver-test
  (let [resolver (pbir/static-attribute-map-resolver :pathim.connect.built-in.resolvers-test/id :pathim.connect.built-in.resolvers-test/color
                   {1 "Gray"
                    2 "Purple"})
        config   (pco/operation-config resolver)]
    (is (= (resolver {:pathim.connect.built-in.resolvers-test/id 2})
           {:pathim.connect.built-in.resolvers-test/color "Purple"}))
    (is (= (resolver {:pathim.connect.built-in.resolvers-test/id 3}) nil))
    (is (= (:pathim.connect.operation/input config)
           [:pathim.connect.built-in.resolvers-test/id]))
    (is (= (:pathim.connect.operation/output config)
           [:pathim.connect.built-in.resolvers-test/color]))))

(deftest attribute-table-resolver-test
  (let [resolver (pbir/attribute-table-resolver :pathim.connect.built-in.resolvers-test/colors :pathim.connect.built-in.resolvers-test/id [:pathim.connect.built-in.resolvers-test/color])
        config   (pco/operation-config resolver)]
    (is (= (resolver {:pathim.connect.built-in.resolvers-test/colors {1 {:pathim.connect.built-in.resolvers-test/color "Gray"}
                                2 {:pathim.connect.built-in.resolvers-test/color "Purple"}}
                      :pathim.connect.built-in.resolvers-test/id     2})
           {:pathim.connect.built-in.resolvers-test/color "Purple"}))
    (is (= (:pathim.connect.operation/input config)
           [:pathim.connect.built-in.resolvers-test/id :pathim.connect.built-in.resolvers-test/colors]))
    (is (= (:pathim.connect.operation/output config)
           [:pathim.connect.built-in.resolvers-test/color]))))

(deftest env-table-resolver-test
  (let [resolver (pbir/env-table-resolver :pathim.connect.built-in.resolvers-test/colors :pathim.connect.built-in.resolvers-test/id [:pathim.connect.built-in.resolvers-test/color])
        config   (pco/operation-config resolver)]
    (is (= (resolver
             {:pathim.connect.built-in.resolvers-test/colors {1 {:pathim.connect.built-in.resolvers-test/color "Gray"}
                        2 {:pathim.connect.built-in.resolvers-test/color "Purple"}}}
             {:pathim.connect.built-in.resolvers-test/id 2})
           {:pathim.connect.built-in.resolvers-test/color "Purple"}))
    (is (= (:pathim.connect.operation/input config)
           [:pathim.connect.built-in.resolvers-test/id]))
    (is (= (:pathim.connect.operation/output config)
           [:pathim.connect.built-in.resolvers-test/color]))))

(deftest edn-file-resolver-test
  (let [[resolver :as resolvers] (pbir/edn-file-resolver "test/resources/sample-config.edn")]
    (is (= (:pathim.connect.operation/output (pco/operation-config resolver))
           [:my.system/generic-db :my.system/initial-path :my.system/port]))

    (is (= (pop/-op-resolve resolver {} {})
           {:my.system/initial-path "/tmp/system", :my.system/port 1234, :my.system/generic-db {4 {:my.system.user/name "Anne"}, 2 {:my.system.user/name "Fred"}}}))
))

;; Upstream also reads these through a SmartMap; SmartMaps are not part of this port.

(deftest global-data-resolver-test
  (let [[resolver :as resolvers] (pbir/global-data-resolver
                                   {:my.system/port
                                    1234

                                    :my.system/initial-path
                                    "/tmp/system"

                                    :my.system/generic-db
                                    ^{:pathim/entity-table :my.system/user-id}
                                    {4 {:my.system.user/name "Anne"}
                                     2 {:my.system.user/name "Fred"}}})]
    (is (= (:pathim.connect.operation/output (pco/operation-config resolver))
           [:my.system/generic-db :my.system/initial-path :my.system/port]))

    (is (= (pop/-op-resolve resolver {} {})
           {:my.system/initial-path "/tmp/system", :my.system/port 1234, :my.system/generic-db {4 {:my.system.user/name "Anne"}, 2 {:my.system.user/name "Fred"}}}))
))

;; Upstream also reads these through a SmartMap; SmartMaps are not part of this port.
