(ns pathim.test.geometry-resolvers
  (:require
    [pathim.connect.built-in.resolvers :as pbir]
    [pathim.connect.operation :as pco]))

(cpp/raw "double pathim_sqrt(double n) { return std::sqrt(n); }")



















(defn sqrt [n]
  (cpp/pathim_sqrt (cpp/cast cpp/double n)))

(pco/defresolver left [{:pathim.test.geometry-resolvers/keys [right width]}]
  {:pathim.test.geometry-resolvers/left (- right width)})

(pco/defresolver right [{:pathim.test.geometry-resolvers/keys [left width]}]
  {:pathim.test.geometry-resolvers/right (+ left width)})

(pco/defresolver top [{:pathim.test.geometry-resolvers/keys [bottom height]}]
  {:pathim.test.geometry-resolvers/top (- bottom height)})

(pco/defresolver bottom [{:pathim.test.geometry-resolvers/keys [top height]}]
  {:pathim.test.geometry-resolvers/bottom (+ top height)})

(pco/defresolver width [{:pathim.test.geometry-resolvers/keys [left right]}]
  {:pathim.test.geometry-resolvers/width (- right left)})

(pco/defresolver height [{:pathim.test.geometry-resolvers/keys [top bottom]}]
  {:pathim.test.geometry-resolvers/height (- bottom top)})

(pco/defresolver half-width [{:pathim.test.geometry-resolvers/keys [width]}]
  {:pathim.test.geometry-resolvers/half-width (/ width 2)})

(pco/defresolver half-width-rev [{:pathim.test.geometry-resolvers/keys [half-width]}]
  {:pathim.test.geometry-resolvers/width (* half-width 2)})

(pco/defresolver half-height [{:pathim.test.geometry-resolvers/keys [height]}]
  {:pathim.test.geometry-resolvers/half-height (/ height 2)})

(pco/defresolver center-x [{:pathim.test.geometry-resolvers/keys [left half-width]}]
  {:pathim.test.geometry-resolvers/center-x (+ left half-width)})

(pco/defresolver center-y [{:pathim.test.geometry-resolvers/keys [top half-height]}]
  {:pathim.test.geometry-resolvers/center-y (+ top half-height)})

(pco/defresolver midpoint [{:pathim.test.geometry-resolvers/keys [center-x center-y]}]
  {:pathim.test.geometry-resolvers/midpoint {:pathim.test.geometry-resolvers/left center-x
               :pathim.test.geometry-resolvers/top  center-y}})

(pco/defresolver turn-point [{:pathim.test.geometry-resolvers/keys [left top]}]
  {:pathim.test.geometry-resolvers/turn-point {:pathim.test.geometry-resolvers/right  left
                 :pathim.test.geometry-resolvers/bottom top}})

(pco/defresolver turn-point2 [{:pathim.test.geometry-resolvers/keys [right bottom]}]
  {:pathim.test.geometry-resolvers/turn-point {:pathim.test.geometry-resolvers/left right
                 :pathim.test.geometry-resolvers/top  bottom}})

(pco/defresolver diagonal [{:pathim.test.geometry-resolvers/keys [width height]}]
  {:pathim.test.geometry-resolvers/diagonal (sqrt (+ (* width width) (* height height)))})

(def registry
  [left
   right
   top
   bottom
   width
   height
   half-width
   half-width-rev
   half-height
   center-x
   center-y
   midpoint
   turn-point
   turn-point2
   diagonal
   (pbir/equivalence-resolver :pathim.test.geometry-resolvers/x :pathim.test.geometry-resolvers/left)
   (pbir/equivalence-resolver :pathim.test.geometry-resolvers/y :pathim.test.geometry-resolvers/top)])

(def geo->svg-registry
  [(pbir/equivalence-resolver :left :pathim.test.geometry-resolvers/left)
   (pbir/equivalence-resolver :right :pathim.test.geometry-resolvers/right)
   (pbir/equivalence-resolver :top :pathim.test.geometry-resolvers/top)
   (pbir/equivalence-resolver :bottom :pathim.test.geometry-resolvers/bottom)
   (pbir/equivalence-resolver :x :pathim.test.geometry-resolvers/x)
   (pbir/equivalence-resolver :y :pathim.test.geometry-resolvers/y)
   (pbir/equivalence-resolver :width :pathim.test.geometry-resolvers/width)
   (pbir/equivalence-resolver :height :pathim.test.geometry-resolvers/height)
   (pbir/equivalence-resolver :cx :pathim.test.geometry-resolvers/center-x)
   (pbir/equivalence-resolver :cy :pathim.test.geometry-resolvers/center-y)
   (pbir/equivalence-resolver :rx :pathim.test.geometry-resolvers/half-width)
   (pbir/equivalence-resolver :ry :pathim.test.geometry-resolvers/half-height)
   (pbir/alias-resolver :rx :r)
   (pbir/alias-resolver :ry :r)])

(def full-registry [registry geo->svg-registry])

(comment
  (map (comp :pathim.connect.operation/op-name pco/operation-config) (flatten geo->svg-registry))

  (pbir/alias-resolver :foo/id :foo-other/id))
