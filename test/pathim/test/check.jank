;; Stands in for the `check` library used by Pathom's own tests.

(ns pathim.test.check
  "A small compatible subset of mauricioszabo/check, enough for the assertions Pathom's
   tests make with it.

   The one semantic that matters is partial map matching: the planner tests assert against
   a fragment of the run graph, naming only the keys they care about. Everything else --
   vectors, sets, scalars -- is compared exactly, so the ported tests stay as strict as
   upstream's wherever they can be."
  (:require
    [clojure.test :as t]
    [pathim.test.matchers :as m]))

(defn matches?
  "True if actual matches the expected pattern: maps match on the keys expected names
   (recursively), everything else must be equal."
  [expected actual]
  (cond
    ;; A matcher from pathim.test.matchers -- `m/absent` and friends. Upstream's tests mix
    ;; matcher-combinators into check patterns, so this delegates rather than duplicating.
    (m/matcher? expected)
    (m/match? expected actual)

    ;; A function in the pattern is a predicate applied to the value -- check's own
    ;; semantics, and what lets a test say `number?` where the value is a generated id.
    ;; Keywords and maps are callable too but are patterns, not predicates, so this asks
    ;; for a function specifically.
    (fn? expected)
    (boolean (expected actual))

    (and (map? expected) (map? actual))
    (every? (fn [k]
              (let [e (get expected k)]
                ;; `m/absent` as a value asserts that the key is not there at all
                (if (and (m/matcher? e) (= :absent (:pathim.test.matchers/kind e)))
                  (not (contains? actual k))
                  (and (contains? actual k) (matches? e (get actual k))))))
            (keys expected))

    ;; Sets match elementwise, partially, like maps: the planner tests describe a run-and
    ;; branch by naming the fields of each child they care about, and the real children
    ;; carry node ids and parent links besides. Sizes must still agree, so an expected set
    ;; cannot quietly ignore an extra branch.
    (and (set? expected) (set? actual))
    (and (= (count expected) (count actual))
         (every? (fn [e] (some (fn [a] (matches? e a)) actual)) expected))

    (and (vector? expected) (vector? actual))
    (and (= (count expected) (count actual))
         (every? (fn [i] (matches? (nth expected i) (nth actual i)))
                 (range (count expected))))

    :else
    (= expected actual)))

(defn explain
  "A short description of why a match failed, for the test report."
  [expected actual]
  (if (and (map? expected) (map? actual) (not (fn? expected)) (not (m/matcher? expected)))
    (let [missing (remove #(contains? actual %) (keys expected))
          differing (remove (fn [k] (or (not (contains? actual k))
                                        (matches? (get expected k) (get actual k))))
                            (keys expected))]
      {:missing-keys (vec missing)
       :differing    (into {} (map (fn [k] [k {:expected (get expected k)
                                               :actual   (get actual k)}])) differing)})
    {:expected expected :actual actual}))

(defmacro thrown-msg?
  "True if body throws something whose message matches re. Use inside `is`.

   Looks in ex-data's :message as well as the message itself: jank's `assert` reports
   \"assertion failed\" as the message and puts the text it was given into ex-data, where
   Clojure's AssertionError carries that text as the message. What the test is really
   asserting -- that the right complaint reaches the caller -- holds either way."
  [re & body]
  `(let [result# (try
                   (do ~@body)
                   ::no-throw
                   (catch cpp/jank.runtime.object_ref e#
                     [(ex-message e#) (:message (ex-data e#))]))]
     (and (not= ::no-throw result#)
          (boolean (some (fn [m#] (and m# (re-find ~re m#))) result#)))))

(defmacro check
  "Asserts that a value matches a pattern. Both of the library's shapes are accepted:

       (check actual => expected)
       (check (=> expected actual))"
  ([form]
   (let [[_arrow expected actual] form]
     `(let [e# ~expected a# ~actual]
        (t/is (matches? e# a#)
              (str "no match: " (pr-str (explain e# a#)))))))
  ([actual _arrow expected]
   `(let [e# ~expected a# ~actual]
      (t/is (matches? e# a#)
            (str "no match: " (pr-str (explain e# a#)))))))
