(ns run-tests
  "Entry point for the test suite: jank run --module-path src:test test/run_tests.jank"
  (:require [clojure.test :as t]
            [yakusoku.core-test]
            [yakusoku.exec-test]))

(let [summary (t/run-tests 'yakusoku.core-test 'yakusoku.exec-test)]
  (println)
  (if (t/successful? summary)
    (println "All tests passed.")
    (do
      (println "FAILURES:" (:fail summary 0) "ERRORS:" (:error summary 0))
      (cpp/exit (cpp/cast cpp/int 1)))))
