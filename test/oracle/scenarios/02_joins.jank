;; Joins, nested queries and sequences.
(ns oracle.02-joins
  (:require [pathim.connect.operation :as pco]
            [pathim.connect.indexes :as pci]
            [pathim.interface.eql :as p.eql]))

(pco/defresolver latest-product []
  {::pco/output [{:latest-product [:product/id]}]}
  {:latest-product {:product/id 1}})

(pco/defresolver product-by-id [{:product/keys [id]}]
  {::pco/output [:product/name :product/price]}
  {:product/name  (str "Product " id)
   :product/price (* id 10)})

(pco/defresolver product-list []
  {::pco/output [{:products [:product/id]}]}
  {:products [{:product/id 1} {:product/id 2} {:product/id 3}]})

(pco/defresolver discounted [{:product/keys [price]}]
  {:product/discounted (* price 0.9)})

(def env (pci/register [latest-product product-by-id product-list discounted]))

;; nested join
(prn (p.eql/process env [{:latest-product [:product/name :product/price]}]))
;; a sequence join, resolved per item
(prn (p.eql/process env [{:products [:product/id :product/name]}]))
;; two levels deep
(prn (p.eql/process env [{:products [:product/name :product/discounted]}]))
;; joining from a supplied entity
(prn (p.eql/process env {:product/id 42} [:product/name :product/price]))
;; the join key itself
(prn (p.eql/process env [{:latest-product [:product/id]}]))
