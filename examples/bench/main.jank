(ns bench.main
  "jank driver: run the blocking benchmarks, then block on the non-blocking ones.

   jank run $(bin/jank-flags) --module-path src:examples examples/bench/main.jank"
  (:require [bench.clock :as clock]
            [bench.graph :as graph]))

(graph/report! (graph/run-sync))
(graph/report! (clock/await! (graph/run-async)))
