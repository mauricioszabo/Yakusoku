(ns bench.graph
  "A resolver graph built so that the three runners visibly differ, plus the benchmarks
   over it.

   Written once, against pathim and Yakusoku. examples/run rewrites the namespace prefixes
   to real Pathom 3 and promesa, so the identical code runs on Clojure and ClojureScript
   and the numbers can be compared across runtimes. Nothing here may use a reader
   conditional: jank's reader feature is :jank, so every #?(...) would silently resolve to
   nothing. Everything that differs per runtime lives in bench.clock instead.

   What each runner actually buys is worth stating plainly, because the benchmarks are
   shaped around it:

     * The async runner does not overlap the steps of one query -- it walks the same plan,
       awaiting each node. What it buys is not blocking a thread, so many queries can be in
       flight at once. Benchmark 1 measures that, as throughput.
     * The parallel runner overlaps independent branches *within* one query. Benchmark 2
       measures that, on a query whose two expensive resolvers do not depend on each other.
     * Batching turns N resolver calls into one. Benchmark 3 measures that against a
       deliberately non-batched twin resolver."
  (:require
    [bench.clock :as clock]
    [pathim.connect.operation :as pco]
    [pathim.connect.indexes :as pci]
    [pathim.interface.eql :as p.eql]
    [pathim.interface.async.eql :as p.a.eql]
    [yakusoku.core :as p]))

;; ------------------------------------------------------------------ workload ----
;;
;; Simulated latency, in milliseconds. These stand in for network calls: the sync
;; resolvers block for them, the async ones resolve a promise after them.

(def slow-ms
  "Each of the two independent user resolvers."
  50)

(def join-ms
  "The resolver that depends on both of them."
  10)

(def batch-ms
  "One batched call, however many items it covers."
  60)

(def item-ms
  "One call of the non-batched twin, per item."
  20)

(def user-ids (vec (range 1 21)))

(def item-ids (vec (range 1 31)))

(def items (mapv (fn [id] {:item/id id}) item-ids))

;; ----------------------------------------------------------- sync resolvers ----

(pco/defresolver profile-sync [env input]
  {::pco/input  [:user/id]
   ::pco/output [:user/profile]}
  (clock/sleep-ms slow-ms)
  {:user/profile (str "profile-" (:user/id input))})

(pco/defresolver orders-sync [env input]
  {::pco/input  [:user/id]
   ::pco/output [:user/orders]}
  (clock/sleep-ms slow-ms)
  {:user/orders (* 3 (:user/id input))})

(pco/defresolver summary-sync [env input]
  {::pco/input  [:user/profile :user/orders]
   ::pco/output [:user/summary]}
  (clock/sleep-ms join-ms)
  {:user/summary (str (:user/profile input) "/" (:user/orders input))})

(pco/defresolver price-batch-sync [env inputs]
  {::pco/input  [:item/id]
   ::pco/output [:item/price]
   ::pco/batch? true}
  (clock/sleep-ms batch-ms)
  (mapv (fn [item] {:item/price (* 10 (:item/id item))}) inputs))

(pco/defresolver price-one-sync [env input]
  {::pco/input  [:item/id]
   ::pco/output [:item/slow-price]}
  (clock/sleep-ms item-ms)
  {:item/slow-price (* 10 (:item/id input))})

;; ---------------------------------------------------------- async resolvers ----
;;
;; The same graph, with every resolver returning a promise rather than blocking.

(pco/defresolver profile-async [env input]
  {::pco/input  [:user/id]
   ::pco/output [:user/profile]}
  (p/delay slow-ms {:user/profile (str "profile-" (:user/id input))}))

(pco/defresolver orders-async [env input]
  {::pco/input  [:user/id]
   ::pco/output [:user/orders]}
  (p/delay slow-ms {:user/orders (* 3 (:user/id input))}))

(pco/defresolver summary-async [env input]
  {::pco/input  [:user/profile :user/orders]
   ::pco/output [:user/summary]}
  (p/delay join-ms {:user/summary (str (:user/profile input) "/" (:user/orders input))}))

(pco/defresolver price-batch-async [env inputs]
  {::pco/input  [:item/id]
   ::pco/output [:item/price]
   ::pco/batch? true}
  (p/delay batch-ms (mapv (fn [item] {:item/price (* 10 (:item/id item))}) inputs)))

(pco/defresolver price-one-async [env input]
  {::pco/input  [:item/id]
   ::pco/output [:item/slow-price]}
  (p/delay item-ms {:item/slow-price (* 10 (:item/id input))}))

;; --------------------------------------------------------------------- envs ----

(def sync-env
  (pci/register [profile-sync orders-sync summary-sync price-batch-sync price-one-sync]))

(def async-env
  (pci/register [profile-async orders-async summary-async price-batch-async price-one-async]))

(def parallel-env
  (assoc async-env ::p.a.eql/parallel? true))

;; --------------------------------------------------------------- benchmarks ----
;;
;; Every benchmark answers with a plain vector of scalars as well as a duration, so
;; examples/run can check that all three runners in all three runtimes computed the same
;; thing before it compares any timings.

(def batch-query [{:items [:item/price]}])
(def one-by-one-query [{:items [:item/slow-price]}])
(def items-entity {:items items})

(defn sync-throughput
  "Independent user queries, one after another. Blocking, so the cost is the sum."
  [ids]
  (let [start  (clock/now-ms)
        answer (mapv (fn [id]
                       (:user/summary (p.eql/process sync-env {:user/id id} [:user/summary])))
                     ids)]
    {:ms (- (clock/now-ms) start) :answer answer}))

(defn sync-single-query
  "One query whose two expensive resolvers are independent. Sync pays for both."
  []
  (let [start  (clock/now-ms)
        answer (:user/summary (p.eql/process sync-env {:user/id 1} [:user/summary]))]
    {:ms (- (clock/now-ms) start) :answer answer}))

(defn sync-batched [entity]
  (let [start  (clock/now-ms)
        answer (mapv :item/price (:items (p.eql/process sync-env entity batch-query)))]
    {:ms (- (clock/now-ms) start) :answer answer}))

(defn sync-one-by-one [entity]
  (let [start  (clock/now-ms)
        answer (mapv :item/slow-price (:items (p.eql/process sync-env entity one-by-one-query)))]
    {:ms (- (clock/now-ms) start) :answer answer}))

(defn async-throughput
  "The same queries, all started before any of them finishes."
  [env ids]
  (let [start (clock/now-ms)]
    (p/then (p/all (mapv (fn [id] (p.a.eql/process env {:user/id id} [:user/summary])) ids))
            (fn [results]
              {:ms (- (clock/now-ms) start) :answer (mapv :user/summary results)}))))

(defn async-single-query [env]
  (let [start (clock/now-ms)]
    (p/then (p.a.eql/process env {:user/id 1} [:user/summary])
            (fn [result]
              {:ms (- (clock/now-ms) start) :answer (:user/summary result)}))))

(defn async-batched [env entity]
  (let [start (clock/now-ms)]
    (p/then (p.a.eql/process env entity batch-query)
            (fn [result]
              {:ms (- (clock/now-ms) start) :answer (mapv :item/price (:items result))}))))

(defn async-one-by-one [env entity]
  (let [start (clock/now-ms)]
    (p/then (p.a.eql/process env entity one-by-one-query)
            (fn [result]
              {:ms (- (clock/now-ms) start) :answer (mapv :item/slow-price (:items result))}))))

;; ------------------------------------------------------------- running them ----

(def iterations
  "How many timed passes each benchmark gets. A warm-up pass runs first and is discarded:
   jank compiles a function on its first call and the JVM's JIT warms up, so the first
   pass of anything is not a measurement."
  3)

(def ^:private one-user (vec (take 1 user-ids)))
(def ^:private one-item {:items (vec (take 1 items))})

(defn median [xs]
  (let [sorted (vec (sort xs))]
    (nth sorted (quot (count sorted) 2))))

(defn- summarise [label runs]
  {:bench  label
   :ms     (median (mapv :ms runs))
   :all-ms (mapv :ms runs)
   :answer (:answer (first runs))})

;; Each benchmark carries two functions: :warm, over a one-element input, and :run, over
;; the real one. The warm-up is deliberately not just a first run of the real thing.
;;
;; jank compiles a function on its first call, and the compiler does not survive two
;; threads entering it at once -- one benchmark had the main thread inside LLVM building
;; the next query while a pool worker was inside clang compiling a continuation for the
;; last one, and that is a segfault. A one-user, one-item pass reaches every function the
;; real pass does, but finishes each query before starting the next, so nothing is
;; compiled concurrently. By the time the timed passes fan out, there is nothing left to
;; compile.

(defn- repeat-async
  "Runs f n times in sequence, one promise chained onto the last, and collects the
   results. Sequential on purpose: overlapping the repetitions would measure the pool,
   not the query."
  [n f]
  (reduce (fn [acc _]
            (p/then acc (fn [runs] (p/then (f) (fn [run] (conj runs run))))))
          (p/resolved [])
          (range n)))

(defn- sync-benches []
  [{:label :sync/throughput   :warm #(sync-throughput one-user)  :run #(sync-throughput user-ids)}
   {:label :sync/single-query :warm sync-single-query            :run sync-single-query}
   {:label :sync/batched      :warm #(sync-batched one-item)     :run #(sync-batched items-entity)}
   {:label :sync/one-by-one   :warm #(sync-one-by-one one-item)  :run #(sync-one-by-one items-entity)}])

(defn- async-benches [prefix]
  ;; single-query first, deliberately: it is the only one that runs one query at a time.
  [{:label (keyword prefix "single-query")
    :warm  (fn [env] (async-single-query env))
    :run   (fn [env] (async-single-query env))}
   {:label (keyword prefix "throughput")
    :warm  (fn [env] (async-throughput env one-user))
    :run   (fn [env] (async-throughput env user-ids))}
   {:label (keyword prefix "batched")
    :warm  (fn [env] (async-batched env one-item))
    :run   (fn [env] (async-batched env items-entity))}
   {:label (keyword prefix "one-by-one")
    :warm  (fn [env] (async-one-by-one env one-item))
    :run   (fn [env] (async-one-by-one env items-entity))}])

(def ^:private suites [["async" async-env] ["parallel" parallel-env]])

(defn run-sync
  "The blocking benchmarks. Not callable on ClojureScript, which has no way to block."
  []
  (mapv (fn [{:keys [label warm run]}]
          (warm)
          (summarise label (mapv (fn [_] (run)) (range iterations))))
        (sync-benches)))

(defn run-async-blocking
  "The non-blocking benchmarks, driven one at a time from the calling thread.

   This is the shape jank and Clojure use. On jank it is not merely tidier: chaining the
   whole suite into one promise means the harness's own closures first-compile on pool
   workers, alongside the query continuations, and jank's compiler does not survive two
   threads entering it at once."
  []
  (vec (mapcat (fn [[prefix env]]
                 (mapv (fn [{:keys [label warm run]}]
                         (clock/await! (warm env))
                         (summarise label
                                    (mapv (fn [_] (clock/await! (run env))) (range iterations))))
                       (async-benches prefix)))
               suites)))

(defn- run-async-suite [prefix env]
  (reduce (fn [acc {:keys [label warm run]}]
            (p/then acc
                    (fn [results]
                      (p/then (warm env)
                              (fn [_]
                                (p/then (repeat-async iterations (fn [] (run env)))
                                        (fn [runs] (conj results (summarise label runs)))))))))
          (p/resolved [])
          (async-benches prefix)))

(defn run-async
  "The same benchmarks as run-async-blocking, chained into one promise. This is the shape
   ClojureScript needs, since it cannot block on anything."
  []
  (reduce (fn [acc [prefix env]]
            (p/then acc (fn [results]
                          (p/then (run-async-suite prefix env)
                                  (fn [suite] (into results suite))))))
          (p/resolved [])
          suites))

(defn report!
  "Prints one EDN map per line: the format examples/run reads."
  [results]
  (doseq [r results]
    (prn (assoc r :runtime (clock/runtime-name)))))
