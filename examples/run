#!/usr/bin/env bash
# Runs the benchmark on all three runtimes and prints the results side by side.
#
# The graph and the benchmarks are written once, in examples/bench/graph.jank, against
# pathim and Yakusoku. The Pathom variant is generated from that file by rewriting
# namespace prefixes -- the same trick test/oracle/run uses -- so Clojure and ClojureScript
# execute the same code against real Pathom 3 and promesa. Only the clock, the sleep and
# the way a promise is awaited differ per runtime, and those live in bench.clock.
#
# Usage: examples/run [jank|clojure|cljs]...   (default: all three)
set -uo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
work="${root}/examples/target/bench"
out="${root}/examples/target/results"
legs=("$@")
[ ${#legs[@]} -eq 0 ] && legs=(jank clojure cljs)

mkdir -p "$out"

# The Pathom variant of the shared source. Namespaces only: nothing else in that file
# differs between the dialects, which is the point of keeping bench.clock separate.
generate() {
  local dest="$1" ext="$2"
  mkdir -p "${dest}/bench"
  sed -e 's/pathim\./com.wsscode.pathom3./g' \
      -e 's/yakusoku\.core/promesa.core/g' \
      -e 's/yakusoku\.exec/promesa.exec/g' \
      "${root}/examples/bench/graph.jank" > "${dest}/bench/graph.cljc"
  cp "${root}/examples/pathom/clock.${ext}" "${dest}/bench/clock.${ext}"
  cp "${root}/examples/pathom/main.${ext}"  "${dest}/bench/main.${ext}"
}

run_jank() {
  [ -f "${root}/target/native/libyakusoku-asio.so" ] || "${root}/bin/build-native" >/dev/null
  # --eagerness eager is not optional here. jank compiles a function on its first call by
  # default, and its compiler does not survive two threads entering it at once -- which is
  # exactly what happens when the main thread builds the next query while a pool worker
  # runs the last one's continuation. Compiling everything up front removes the race.
  jank --eagerness eager run $("${root}/bin/jank-flags") \
    --module-path "${root}/src:${root}/examples" \
    "${root}/examples/bench/main.jank"
}

run_clojure() {
  generate "${work}/clj" clj
  (cd "${root}/examples" && lein run 2>/dev/null)
}

run_cljs() {
  generate "${work}/cljs" cljs
  (cd "${root}/examples" && \
     lein update-in :source-paths concat '["target/bench/cljs"]' -- \
       run -m cljs.main --target node --optimizations simple \
         --output-to target/bench.js --output-dir target/cljs-out -c bench.main >/dev/null 2>&1) \
    && node "${root}/examples/target/bench.js"
}

for leg in "${legs[@]}"; do
  echo "running ${leg}..." >&2
  "run_${leg}" > "${out}/${leg}.edn" 2>"${out}/${leg}.err"
  status=$?
  if [ $status -ne 0 ] || [ ! -s "${out}/${leg}.edn" ]; then
    echo "  ${leg} failed (exit ${status}); last lines of its output:" >&2
    tail -8 "${out}/${leg}.err" | sed 's/^/    /' >&2
  fi
done

bb "${root}/examples/report.clj" "${out}"
