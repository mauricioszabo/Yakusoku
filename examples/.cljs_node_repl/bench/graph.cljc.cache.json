,141,"^K",6,"^L",141,"^M",22],"^O","^1G"],"~$join-ms",["^ ","^N",["^ ","^I","/home/user/Yakusoku/examples/target/bench/clj/bench/graph.cljc","^J",42,"^K",6,"^L",42,"^M",13],"^5","~$bench.graph/join-ms","^I","/home/user/Yakusoku/examples/target/bench/clj/bench/graph.cljc","^M",13,"^K",1,"^J",42,"^L",42,"^O","^1N","^10","The resolver that depends on both of them."],"~$price-one-sync",["^ ","^5","~$bench.graph/price-one-sync","^I","/home/user/Yakusoku/examples/target/bench/clj/bench/graph.cljc","^J",87,"^K",1,"^L",87,"^M",32,"^N",["^ ","^I","/home/user/Yakusoku/examples/target/bench/clj/bench/graph.cljc","^J",87,"^K",18,"^L",87,"^M",32],"^O","^V"],"~$iterations",["^ ","^N",["^ ","^I","/home/user/Yakusoku/examples/target/bench/clj/bench/graph.cljc","^J",198,"^K",6,"^L",198,"^M",16],"^5","~$bench.graph/iterations","^I","/home/user/Yakusoku/examples/target/bench/clj/bench/graph.cljc","^M",16,"^K",1,"^J",198,"^L",198,"^O","^1N","^10","How many timed passes each benchmark gets. A warm-up pass runs first and is discarded:\n   jank compiles a function on its first call and the JVM's JIT warms up, so the first\n   pass of anything is not a measurement."],"~$sync-single-query",["^ ","^X",null,"^N",["^ ","^I","/home/user/Yakusoku/examples/target/bench/clj/bench/graph.cljc","^J",153,"^K",7,"^L",153,"^M",24,"^Y",["^Z",["^[",["^Z",[[]]]]],"^10","One query whose two expensive resolvers are independent. Sync pays for both."],"^5","~$bench.graph/sync-single-query","^I","/home/user/Yakusoku/examples/target/bench/clj/bench/graph.cljc","^M",24,"^12",["^Z",[[]]],"^13",null,"^14",["^Z",[null,null]],"^K",1,"^15",false,"^J",153,"^16","^P","^L",153,"^17",0,"^18",true,"^Y",["^Z",["^[",["^Z",[[]]]]],"^10","One query whose two expensive resolvers are independent. Sync pays for both."]],"~:cljs.spec/registry-ref",[],"~:require-macros",["^ ","^@","^<","^<","^<","~$p","^;","^;","^;"],"~:cljs.analyzer/constants",["^ ","~:seen",["^4",["~:sync/single-query","^24","^28","^2:","~:item/id","^2B","^2F","~:user/profile","~:run","~:sync/throughput","~:all-ms","~:com.wsscode.pathom3.connect.operation/input","^2X","~:sync/one-by-one","~:item/price","~:user/id","~:item/slow-price","~:bench","~:user/orders","^3;","^U","~:warm","~:label","~:runtime","^1?","~:com.wsscode.pathom3.connect.operation/batch?","~:answer","^1K","~:com.wsscode.pathom3.interface.async.eql/parallel?","~:sync/batched","~:items","~:ms","~:user/summary","~:com.wsscode.pathom3.connect.operation/output"]],"~:order",["^3E","^28","^3J","^3[","^3M","^3F","^2F","^3P","^1K","^3Z","^2:","^3T","^3L","^3;","^3N","^2B","^2X","^1?","^24","^U","^3V","^3X","^3Y","^3U","^3O","^3I","^3R","^3Q","^3G","^3H","^3D","^3W","^3K","^3S"]],"^10","A resolver graph built so that the three runners visibly differ, plus the benchmarks\n   over it.\n\n   Written once, against pathim and Yakusoku. examples/run rewrites the namespace prefixes\n   to real Pathom 3 and promesa, so the identical code runs on Clojure and ClojureScript\n   and the numbers can be compared across runtimes. Nothing here may use a reader\n   conditional: jank's reader feature is :jank, so every #?(...) would silently resolve to\n   nothing. Everything that differs per runtime lives in bench.clock instead.\n\n   What each runner actually buys is worth stating plainly, because the benchmarks are\n   shaped around it:\n\n     * The async runner does not overlap the steps of one query -- it walks the same plan,\n       awaiting each node. What it buys is not blocking a thread, so many queries can be in\n       flight at once. Benchmark 1 measures that, as throughput.\n     * The parallel runner overlaps independent branches *within* one query. Benchmark 2\n       measures that, on a query whose two expensive resolvers do not depend on each other.\n     * Batching turns N resolver calls into one. Benchmark 3 measures that against a\n       deliberately non-batched twin resolver.","~:as-aliases",["^ "]]