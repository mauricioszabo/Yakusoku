(def all [work-0 work-1 work-2 work-3 work-4 work-5 work-6 work-7 work-8 work-9 work-10
          work-11 work-12 work-13 work-14 work-15 work-16 work-17 work-18 work-19 work-20
          work-21 work-22 work-23 work-24 work-25 work-26 work-27 work-28 work-29 work-30
          work-31])

(defn -main [& _]
  (let [fs (doall (map (fn [f] (future (f 10000))) all))]
    (println "sum:" (reduce + (map deref fs)))))
