(ns app.main)

;; Thirty-two functions that have never been called. jank compiles a function on its first
;; call, so handing them all to threads at once means several threads enter the compiler
;; together. That is jank issue 3, and `--eagerness eager` is what avoids it: with the
;; flag the whole namespace is compiled up front and no thread ever reaches the compiler.
;;
;; Nothing here depends on Yakusoku, pathim or any other library -- the crash is purely
;; jank's lazy compilation meeting threads, and the point of the repro is that lein-jank
;; gives you no way to ask for the flag that fixes it.
(defn work-0 [n] (loop [i n acc 0] (if (zero? i) acc (recur (dec i) (+ acc i)))))
(defn work-1 [n] (loop [i n acc 0] (if (zero? i) acc (recur (dec i) (+ acc i)))))
(defn work-2 [n] (loop [i n acc 0] (if (zero? i) acc (recur (dec i) (+ acc i)))))
