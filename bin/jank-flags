#!/usr/bin/env bash
# Prints the flags jank needs to compile and link Yakusoku. Sourced by bin/test and
# usable directly: jank run $(bin/jank-flags) --module-path src my_program.jank
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [ -f "${root}/third-party/taskflow/taskflow/taskflow.hpp" ]; then
  tf_include="${root}/third-party/taskflow"
elif [ -f /usr/local/include/taskflow/taskflow.hpp ]; then
  tf_include="/usr/local/include"
else
  tf_include="/usr/include"
fi

echo -n "-I ${tf_include} -I ${root}/native "
echo -n "-L ${root}/target/native -l yakusoku-asio"
