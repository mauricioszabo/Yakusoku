#!/usr/bin/env bash
# Runs the Yakusoku test suite under jank.
set -euo pipefail
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

[ -f "${root}/target/native/libyakusoku-pool.so" ] || "${root}/bin/build-native"

exec jank run $("${root}/bin/jank-flags") \
  --module-path "${root}/src:${root}/test" \
  "${root}/test/run_tests.jank" "$@"
