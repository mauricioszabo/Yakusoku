#!/usr/bin/env bash
# Builds the native support library Yakusoku links against.
#
# The FastQueue-facing half is compiled ahead of time into this library so that jank never
# has to parse FastQueue; jank only ever sees the three declarations in
# native/yakusoku_pool.hpp.
#
# FastQueue has no distro package. Build and install it from source:
#   git clone https://github.com/muhammad-fiaz/FastQueue
#   cd FastQueue && cmake -B build -DCMAKE_BUILD_TYPE=Release \
#     -DCMAKE_POSITION_INDEPENDENT_CODE=ON && cmake --build build && cmake --install build
# POSITION_INDEPENDENT_CODE matters: it ships a static library, and linking a .a into a
# shared object needs it.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
out="${root}/target/native"
cxx="$(dirname "$(readlink -f "$(command -v jank)")")/../lib/jank/0.1/bin/clang++"
[ -x "$cxx" ] || cxx="/usr/local/lib/jank/0.1/bin/clang++"

if [ -f /usr/local/include/fastqueue/thread_pool.h ]; then
  fq_prefix="/usr/local"
elif [ -f /usr/include/fastqueue/thread_pool.h ]; then
  fq_prefix="/usr"
else
  echo "error: FastQueue not found. Build and install it from source -- see the note at the" >&2
  echo "       top of this script." >&2
  exit 1
fi

mkdir -p "$out"

"$cxx" -std=c++20 -fPIC -O2 -w -I "${fq_prefix}/include" -I "${root}/native" \
  -c "${root}/native/yakusoku_pool.cpp" -o "${out}/yakusoku_pool.o"

"$cxx" -shared -fPIC -o "${out}/libyakusoku-pool.so" "${out}/yakusoku_pool.o" \
  -Wl,--whole-archive "${fq_prefix}/lib/libfastqueue.a" -Wl,--no-whole-archive -lpthread

echo "built ${out}/libyakusoku-pool.so (FastQueue: ${fq_prefix})"
