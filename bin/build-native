#!/usr/bin/env bash
# Builds the native support library Yakusoku links against.
#
# The oneTBB-facing half is compiled ahead of time into this library so that jank never has
# to parse oneTBB; jank only ever sees the three declarations in native/yakusoku_pool.hpp.
# oneTBB comes from the system (Debian/Ubuntu: apt install libtbb-dev).
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
out="${root}/target/native"
cxx="$(dirname "$(readlink -f "$(command -v jank)")")/../lib/jank/0.1/bin/clang++"
[ -x "$cxx" ] || cxx="/usr/local/lib/jank/0.1/bin/clang++"

if [ ! -f /usr/include/oneapi/tbb/task_arena.h ] && [ ! -f /usr/local/include/oneapi/tbb/task_arena.h ]; then
  echo "error: oneTBB not found. Install it (Debian/Ubuntu: apt install libtbb-dev)." >&2
  exit 1
fi

mkdir -p "$out"

"$cxx" -std=c++20 -fPIC -O2 -w -I "${root}/native" \
  -c "${root}/native/yakusoku_pool.cpp" -o "${out}/yakusoku_pool.o"

"$cxx" -shared -fPIC -o "${out}/libyakusoku-asio.so" "${out}/yakusoku_pool.o" -ltbb -lpthread

echo "built ${out}/libyakusoku-asio.so (oneTBB)"
