#!/usr/bin/env bash
# Builds the Asio support library Yakusoku links against.
#
# Yakusoku uses Asio in ASIO_SEPARATE_COMPILATION mode rather than header-only. That is
# not an optimisation: jank's incremental C++ parser rejects asio/impl/cancellation_signal.ipp
# ("'auto_delete_helper' is a private member"), which regular Clang accepts. Compiling
# Asio's sources ahead of time keeps those .ipp files away from the JIT entirely -- and
# cuts load time, since the JIT then only parses declarations.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
out="${root}/target/native"
cxx="$(dirname "$(readlink -f "$(command -v jank)")")/../lib/jank/0.1/bin/clang++"
[ -x "$cxx" ] || cxx="/usr/local/lib/jank/0.1/bin/clang++"

# Prefer a vendored Asio, fall back to the system one (libasio-dev, homebrew asio, nix).
if [ -f "${root}/third-party/asio/asio/include/asio.hpp" ]; then
  asio_include="${root}/third-party/asio/asio/include"
elif [ -f /usr/include/asio.hpp ]; then
  asio_include="/usr/include"
elif [ -f /usr/local/include/asio.hpp ]; then
  asio_include="/usr/local/include"
else
  echo "error: standalone Asio not found. Install it (Debian/Ubuntu: apt install libasio-dev," >&2
  echo "       macOS: brew install asio) or vendor it at third-party/asio." >&2
  exit 1
fi

mkdir -p "$out"
echo "#include <asio/impl/src.hpp>" > "${out}/asio_src.cpp"

"$cxx" -std=c++20 -fPIC -O2 -w \
  -DASIO_STANDALONE -DASIO_NO_DEPRECATED -DASIO_SEPARATE_COMPILATION \
  -I "$asio_include" \
  -c "${out}/asio_src.cpp" -o "${out}/asio_src.o"

"$cxx" -shared -fPIC -o "${out}/libyakusoku-asio.so" "${out}/asio_src.o" -lpthread

echo "built ${out}/libyakusoku-asio.so (asio headers: ${asio_include})"
