#!/usr/bin/env bash
# Regenerates the ported Pathom test suite from an upstream checkout.
#
# The pipeline is deliberately reproducible: everything mechanical happens here, and the
# handful of edits that need judgement are applied afterwards by hand (and are listed at
# the end of this script so they are not forgotten on a re-run).
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
pathom="${1:?usage: tools/port-tests <pathom3-checkout> <eql-checkout> <cljc-misc-checkout>}"
eql="${2:?}"
misc="${3:?}"
work="${TMPDIR:-/tmp}/pathim-port-tests"

rm -rf "$work" && mkdir -p "$work"
cd "${root}/tools"

echo "1/4 transforming (guardrails, spec, namespaces, throws)"
bb port.clj "$pathom" "$eql" "$misc" "$work" | grep -i test || true

echo "2/4 resolving reader conditionals to their :clj branch"
bb resolve-reader-conditionals.clj $(find "${work}/TESTS" -name '*.jank')

echo "3/4 expanding namespaced map literals"
bb expand-namespaced-maps.clj $(find "${work}/TESTS" -name '*.jank')

echo "4/4 installing into test/pathim"
mkdir -p "${root}/test/pathim"
cp -r "${work}/TESTS/." "${root}/test/pathim/"

cat <<'NOTE'

Done. The following still need applying by hand (see git history for the originals):
  - test/helpers      : catch-exception takes jank's catch class
  - format/eql_test   : the defrecord case is dropped (jank has no records)
  - indexes_test      : check.core's (check (=> expected actual)) becomes (is (= ...))
  - planner_test      : the unused matcher-combinators require is dropped
  - resolvers_test    : SmartMap cases are dropped (not part of this port)
NOTE
